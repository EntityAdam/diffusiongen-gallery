<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;data\**;node_modules\**;Gallery.Core\bin\**;Gallery.Core\obj\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LucideBlazor" Version="1.0.6" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.25.1" />
    <PackageReference Include="ShadCn.Blazor.Components" Version="1.0.37" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
    <InternalsVisibleTo Include="Gallery.Tests" />
    <InternalsVisibleTo Include="Gallery.TestSupport" />
  </ItemGroup>
</Project>
