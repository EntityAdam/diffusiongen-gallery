<label for="@id">@Label</label>
<input id="@id" value="@Value" @onchange="ChangedAsync" placeholder="@Placeholder" disabled="@Disabled" aria-describedby="@(id + "-hint")" />
<p id="@(id + "-hint")" class="muted">Enter a fully qualified local directory or UNC path.</p>

@code {
    [Parameter] public string Label { get; set; } = "Gallery directory";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Placeholder { get; set; } = @"C:\Pictures\Gallery or \\server\share\gallery";
    private readonly string id = "folder-" + Guid.NewGuid().ToString("N");
    private Task ChangedAsync(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value?.ToString() ?? "");
}
