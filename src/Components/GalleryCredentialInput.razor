<div class="segmented" role="tablist" aria-label="Gallery credentials">
    <button type="button" role="tab" aria-selected="@(!UseRecovery)" class="@(!UseRecovery ? "active" : "")"
            @onclick="() => ChangeModeAsync(false)" disabled="@Disabled">Passphrase</button>
    <button type="button" role="tab" aria-selected="@UseRecovery" class="@(UseRecovery ? "active" : "")"
            @onclick="() => ChangeModeAsync(true)" disabled="@Disabled">Recovery words</button>
</div>
<label for="@id">@(UseRecovery ? "32 recovery words" : "Passphrase")</label>
@if (UseRecovery)
{
    <textarea id="@id" value="@Value" @onchange="ChangedAsync" rows="4" autocomplete="off" spellcheck="false" required disabled="@Disabled"></textarea>
}
else
{
    <input id="@id" type="password" value="@Value" @onchange="ChangedAsync" autocomplete="off" minlength="14" required disabled="@Disabled" />
}

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool UseRecovery { get; set; }
    [Parameter] public EventCallback<bool> UseRecoveryChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private readonly string id = "credential-" + Guid.NewGuid().ToString("N");

    private Task ChangedAsync(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value?.ToString() ?? "");

    private async Task ChangeModeAsync(bool recovery)
    {
        await ValueChanged.InvokeAsync("");
        await UseRecoveryChanged.InvokeAsync(recovery);
    }
}
