<Tabs Value="@(UseRecovery ? "recovery" : "passphrase")" ValueChanged='value => ChangeModeAsync(value == "recovery")'>
    <TabsList Class="w-full" aria-label="Gallery credentials">
        <TabsTrigger Value="passphrase" Class="flex-1" disabled="@Disabled"><KeyRoundIcon Size="16" ClassName="mr-2" aria-hidden="true" />Passphrase</TabsTrigger>
        <TabsTrigger Value="recovery" Class="flex-1" disabled="@Disabled"><ShieldCheckIcon Size="16" ClassName="mr-2" aria-hidden="true" />Recovery words</TabsTrigger>
    </TabsList>
</Tabs>
<Label For="@id" Class="mt-4 mb-2 block">@(UseRecovery ? "32 recovery words" : "Passphrase")</Label>
@if (UseRecovery)
{
    <Textarea id="@id" Value="@Value" ValueChanged='value => ValueChanged.InvokeAsync(value ?? "")' Rows="4" autocomplete="off" spellcheck="false" required Disabled="@Disabled" />
}
else
{
    <Input id="@id" Type="password" Value="@Value" ValueChanged="ValueChanged" autocomplete="off" minlength="14" required Disabled="@Disabled" />
}

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool UseRecovery { get; set; }
    [Parameter] public EventCallback<bool> UseRecoveryChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private readonly string id = "credential-" + Guid.NewGuid().ToString("N");

    private async Task ChangeModeAsync(bool recovery)
    {
        await ValueChanged.InvokeAsync("");
        await UseRecoveryChanged.InvokeAsync(recovery);
    }
}
