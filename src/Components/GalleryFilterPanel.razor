<aside class="panel filters">
    <details class="filter-disclosure">
        <summary>Filter images</summary>
        <div class="panel-header"><h3>Find your image</h3><button class="text-button" @onclick="Reset" disabled="@Disabled">Reset</button></div>
        <label for="collection-filter">Collection</label>
        <select id="collection-filter" @bind="draft.Collection" @bind:after="NotifyChangedAsync">
            <option value="">All collections</option>
            @foreach (var name in Collections)
            { <option value="@name">@name</option> }
        </select>
        <label for="rating-filter">Minimum rating</label><select id="rating-filter" @bind="draft.MinRating" @bind:after="NotifyChangedAsync">
            <option value="0">Any rating</option>@for (var score = 1; score <= 5; score++) { <option value="@score">@score / 5</option> }
        </select>
        <label for="review-filter">Review queue</label><select id="review-filter" @bind="draft.Review" @bind:after="NotifyChangedAsync">
            <option value="all">All images</option><option value="pending">Awaiting review</option><option value="reviewed">Reviewed</option>
        </select>
        <label class="check"><input type="checkbox" @bind="draft.UnorganizedOnly" @bind:after="NotifyChangedAsync" /> Without a collection only</label>
        <label for="media-filter">Media type</label>
        <select id="media-filter" @bind="draft.Media" @bind:after="NotifyChangedAsync">
            <option value="all">Images and videos</option><option value="image">Images only</option><option value="video">Videos only</option>
        </select>
        <label for="search">Search everything</label>
        <input id="search" @bind="draft.Search" @bind:event="oninput" @bind:after="NotifyChangedAsync" placeholder="Prompt, name, description..." />
        <label for="tag">Tag</label>
        <input id="tag" @bind="draft.Tag" @bind:after="NotifyChangedAsync" placeholder="Exact tag" list="tags" />
        <datalist id="tags">@foreach (var tag in Tags) { <option value="@tag"></option> }</datalist>
        <label for="folder">Folder</label>
        <input id="folder" @bind="draft.Folder" @bind:after="NotifyChangedAsync" placeholder="Source or current folder" />
        <label for="analysis-model">Vision model</label>
        <input id="analysis-model" @bind="draft.Model" @bind:after="NotifyChangedAsync" placeholder="Model name" />
        <label for="orientation">Orientation</label>
        <select id="orientation" @bind="draft.Orientation" @bind:after="NotifyChangedAsync">
            <option value="all">All orientations</option><option value="landscape">Landscape</option><option value="portrait">Portrait</option><option value="square">Square</option>
        </select>
        <div class="two-fields">
            <div><label for="width">Min width</label><input id="width" type="number" min="0" @bind="draft.MinWidth" @bind:after="NotifyChangedAsync" /></div>
            <div><label for="height">Min height</label><input id="height" type="number" min="0" @bind="draft.MinHeight" @bind:after="NotifyChangedAsync" /></div>
        </div>
        <label for="analysis">Vision analysis</label>
        <select id="analysis" @bind="draft.Analysis" @bind:after="NotifyChangedAsync">
            <option value="all">All images</option><option value="analyzed">Analyzed</option><option value="pending">Not analyzed yet</option>
        </select>
        <label for="deletion">Deletion status</label>
        <select id="deletion" @bind="draft.Deletion" @bind:after="NotifyChangedAsync">
            <option value="active">Active images</option><option value="marked">Marked for deletion</option><option value="all">All images</option>
        </select>
        <label for="from">Imported from</label><input id="from" type="date" @bind="draft.From" @bind:after="NotifyChangedAsync" />
        <label for="to">Imported through</label><input id="to" type="date" @bind="draft.To" @bind:after="NotifyChangedAsync" />
        <label class="check"><input type="checkbox" @bind="draft.FavoritesOnly" @bind:after="NotifyChangedAsync" /> Favorites only</label>
        <div class="security-note">Thumbnails and metadata are encrypted in SQLite. Filters run locally while the vault is unlocked.</div>
    </details>
</aside>

@code {
    [Parameter, EditorRequired] public GalleryFilter Filter { get; set; } = new();
    [Parameter] public IReadOnlyList<ImageRecord> Images { get; set; } = [];
    [Parameter] public EventCallback<GalleryFilter> Changed { get; set; }
    [Parameter] public EventCallback Reset { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private FilterDraft draft = new();
    protected override void OnParametersSet() => draft = FilterDraft.CreateFrom(Filter);

    private IEnumerable<string> Collections => Images.SelectMany(image => image.Collections)
        .Distinct(StringComparer.OrdinalIgnoreCase).Order();

    private IEnumerable<string> Tags => Images.SelectMany(image =>
            image.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        .Distinct().Order();

    private Task NotifyChangedAsync() => Changed.InvokeAsync(draft.ToFilter());

    private sealed class FilterDraft
    {
        public string Search { get; set; } = "";
        public string Folder { get; set; } = "";
        public string Tag { get; set; } = "";
        public string Model { get; set; } = "";
        public bool FavoritesOnly { get; set; }
        public string Deletion { get; set; } = "active";
        public string Analysis { get; set; } = GalleryFilter.AnyValue;
        public string Orientation { get; set; } = GalleryFilter.AnyValue;
        public int MinWidth { get; set; }
        public int MinHeight { get; set; }
        public DateTime? From { get; set; }
        public DateTime? To { get; set; }
        public string Sort { get; set; } = "newest";
        public string Collection { get; set; } = "";
        public int MinRating { get; set; }
        public string Review { get; set; } = GalleryFilter.AnyValue;
        public bool UnorganizedOnly { get; set; }
        public string Media { get; set; } = GalleryFilter.AnyValue;
        public string Prompt { get; set; } = "";

        public static FilterDraft CreateFrom(GalleryFilter filter) => new()
        {
            Search = filter.Search, Folder = filter.Folder, Tag = filter.Tag, Model = filter.Model,
            FavoritesOnly = filter.FavoritesOnly, Deletion = filter.Deletion, Analysis = filter.Analysis,
            Orientation = filter.Orientation, MinWidth = filter.MinWidth, MinHeight = filter.MinHeight,
            From = filter.From, To = filter.To, Sort = filter.Sort, Collection = filter.Collection,
            MinRating = filter.MinRating, Review = filter.Review, UnorganizedOnly = filter.UnorganizedOnly,
            Media = filter.Media, Prompt = filter.Prompt
        };

        public GalleryFilter ToFilter() => new()
        {
            Search = Search, Folder = Folder, Tag = Tag, Model = Model, FavoritesOnly = FavoritesOnly,
            Deletion = Deletion, Analysis = Analysis, Orientation = Orientation, MinWidth = MinWidth,
            MinHeight = MinHeight, From = From, To = To, Sort = Sort, Collection = Collection,
            MinRating = MinRating, Review = Review, UnorganizedOnly = UnorganizedOnly,
            Media = Media, Prompt = Prompt
        };
    }
}
