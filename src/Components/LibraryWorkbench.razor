@inject GalleryService Gallery
@inject ILogger<LibraryWorkbench> Logger
@implements IDisposable

<Card Class="mb-6 p-5 md:p-6 space-y-4" hidden="@(!Visible)">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3"><h3>Workflow tools</h3>@if (Workflow is "organize" or "ai") { <Badge Variant="BadgeVariant.Secondary" Class="border-primary/20 bg-primary/10 text-primary">@SelectedIds.Count selected</Badge> }</div>
    @if (Workflow == "organize")
    {
        <p class="text-muted-foreground">Select images using their checkboxes. Collections are virtual: organizing never moves or deletes image files.</p>
        <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-2 [&>div]:min-w-0 [&>div]:space-y-3">
            <div>
                <Label For="bulk-collection" Class="mt-4 mb-2 block">Add to collection</Label><Input id="bulk-collection" @bind-Value="collection" Disabled="@working" list="collections" maxlength="80" Placeholder="Worlds, portraits, final picks..." />
                <datalist id="collections">@foreach (var name in Collections) { <option value="@name"></option> }</datalist>
                <Label For="bulk-tags" Class="mt-4 mb-2 block">Add tags (existing tags are preserved)</Label><Input id="bulk-tags" @bind-Value="tags" Disabled="@working" Placeholder="cinematic, warm light" />
                <div class="flex flex-wrap items-center gap-2"><Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@(working || SelectedIds.Count == 0)" OnClick="OrganizeAsync">Apply collection &amp; tags</Button><Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@(working || SelectedIds.Count == 0 || collection.Trim().Length == 0)" OnClick="RemoveCollectionAsync">Remove from collection</Button></div>
            </div>
            <div>
                <Label For="bulk-rating" Class="mt-4 mb-2 block">Rating</Label><select id="bulk-rating" @bind="rating" disabled="@working" class="h-10 w-full min-w-0 rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-50"><option value="-1">Leave unchanged</option><option value="0">Unrated</option>@for (var value = 1; value <= 5; value++) { <option value="@value">@value / 5</option> }</select>
                <Label For="bulk-review" Class="mt-4 mb-2 block">Review status</Label><Select id="bulk-review" @bind-Value="reviewStatus" Disabled="@working"><option value="unchanged">Leave unchanged</option><option value="reviewed">Reviewed</option><option value="pending">Pending</option></Select>
                <div class="flex flex-wrap items-center gap-2"><Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@(working || SelectedIds.Count == 0 || rating == -1 && reviewStatus == "unchanged")" OnClick="RateAsync">Apply rating &amp; review status</Button><Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@(working || SelectedIds.Count != 2)" OnClick="CompareAsync">Compare two selected</Button></div>
                <small class="text-muted-foreground">Ratings are your judgement. AI never rates or deletes your images.</small>
            </div>
        </div>
    }
    @if (Workflow == "explore")
    {
        <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-2 [&>div]:min-w-0 [&>div]:space-y-3">
            <div>
                <Label For="saved-name" Class="mt-4 mb-2 block">Save the current sidebar filters</Label><Input id="saved-name" @bind-Value="viewName" maxlength="80" Placeholder="My cinematic favorites" />
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@working" OnClick="SaveViewAsync">Save view</Button>
                @foreach (var view in views)
                {
                    <div class="mt-3 flex items-center gap-2 [&>button:first-child]:min-w-0 [&>button:first-child]:flex-1 [&>button:first-child]:justify-start"><Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@working" OnClick="() => FilterChanged.InvokeAsync(view.Filter with { })">@view.Name</Button><Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Disabled="@working" aria-label="@($"Delete saved view {view.Name}")" OnClick="() => DeleteViewAsync(view.Name)"><XIcon aria-hidden="true" /></Button></div>
                }
            </div>
            <div>
                <Label For="smart-query" Class="mt-4 mb-2 block">Describe what you want to find</Label><Input id="smart-query" @bind-Value="query" maxlength="2000" Placeholder="Highly rated landscape favorites" />
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@working" OnClick="InterpretAsync">Suggest filters with local LLM</Button>
                <p class="text-muted-foreground">Converts language to explicit filters, not embedding search. Review the interpretation before applying it.</p>
                @if (suggestedFilter is not null)
                {
                    <div class="mt-4 space-y-3 rounded-lg border border-primary/20 bg-primary/5 p-4 break-words">Search: @suggestedFilter.Search / Tag: @suggestedFilter.Tag / Collection: @suggestedFilter.Collection / Minimum rating: @suggestedFilter.MinRating / Favorites: @suggestedFilter.FavoritesOnly / Orientation: @suggestedFilter.Orientation / Review: @suggestedFilter.Review</div>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@working" OnClick="ApplySearchAsync">Apply suggested filters</Button>
                }
            </div>
        </div>
    }
    @if (Workflow == "ai")
    {
        <p class="text-muted-foreground">Generate descriptions, tags and collection suggestions for up to 24 selected images using your configured local vision model. Nothing is saved until you approve each suggestion. Existing tags and collections are preserved.</p>
        <Button Variant="ButtonVariant.Default" Size="ButtonSize.Default" Disabled="@(working || SelectedIds.Count is 0 or > 24)" OnClick="SuggestAsync">Analyze selected locally (@SelectedIds.Count)</Button>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@(!analyzing || cancelRequested)" OnClick="StopAnalysisAsync">Stop after current image</Button>
        @foreach (var suggestion in suggestions.ToArray())
        {
            <div class="mt-4 space-y-3 rounded-lg border border-primary/20 bg-primary/5 p-4 break-words">
                <strong>@suggestion.Name</strong><p>@suggestion.Description</p><p class="text-muted-foreground">Tags: @suggestion.Tags</p>
                <p>Suggested collection: @suggestion.Collection</p>
                @if (suggestion.Warning.Length > 0) { <Alert Variant="AlertVariant.Destructive">@suggestion.Warning</Alert> }
                <div class="flex flex-wrap items-center gap-2"><Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@working" OnClick="() => ApproveAsync(suggestion)">Approve &amp; save</Button><Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@working" OnClick="() => DismissAsync(suggestion)">Dismiss</Button></div>
            </div>
        }
    }
    @if (working) { <p class="my-4 flex items-center justify-between gap-3 rounded-lg border border-primary/25 bg-primary/5 p-4 text-sm break-words" role="status">@status</p> }
    @if (notice.Length > 0) { <p class="my-4 flex items-center justify-between gap-3 rounded-lg border border-primary/25 bg-primary/5 p-4 text-sm break-words" role="status">@notice</p> }
    @if (error.Length > 0) { <Alert Variant="AlertVariant.Destructive">@error</Alert> }
    @if (compareImages.Count == 2)
    {
        <div class="fixed inset-0 z-40 overflow-y-auto bg-black/90 p-3 md:p-7">
            <Card Class="mb-6 p-5 md:p-6" role="dialog" aria-modal="true" aria-label="Compare images">
                <div class="mb-4 flex flex-wrap items-center justify-between gap-3"><h2>Choose what deserves to stay.</h2><Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@working" OnClick="CloseComparison">Close comparison</Button></div>
                <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-2 [&>div]:min-w-0 [&>div]:space-y-3">
                    @foreach (var image in compareImages)
                    {
                        <article class="min-w-0 space-y-4 [&>img]:h-[55vh] [&>img]:w-full [&>img]:bg-black/40 [&>img]:object-contain"><h3>@image.Name</h3><img src="@comparison[image.Id]" alt="@image.Name" draggable="false" />
                            <p>@image.Width &times; @image.Height / Rating: @image.Rating / @(image.Reviewed ? "Reviewed" : "Pending review")</p>
                            <div class="flex flex-wrap items-center gap-2">
                                @for (var score = 1; score <= 5; score++)
                                {
                                    var value = score;
                                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@working" OnClick="() => RateOneAsync(image, value)">@value / 5</Button>
                                }
                            </div>
                        </article>
                    }
                </div>
                @if (error.Length > 0) { <Alert Variant="AlertVariant.Destructive">@error</Alert> }
            </Card>
        </div>
    }
</Card>

@code {
    [Parameter] public string Workflow { get; set; } = "organize";
    [Parameter] public bool Visible { get; set; } = true;
    [Parameter] public IReadOnlyList<ImageRecord> Images { get; set; } = [];
    [Parameter] public IReadOnlyCollection<string> SelectedIds { get; set; } = [];
    [Parameter, EditorRequired] public GalleryFilter Filter { get; set; } = new();
    [Parameter] public EventCallback<GalleryFilter> FilterChanged { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback<LibraryJobStatus> JobChanged { get; set; }
    private string collection = "", tags = "", viewName = "", query = "", error = "", notice = "", status = "";
    private int rating = -1;
    private string reviewStatus = "unchanged", jobWorkflow = "", jobMessage = "";
    private bool working, analyzing, reportingJob, cancelRequested, disposed;
    private List<SavedView> views = [];
    private List<OrganizationSuggestion> suggestions = [];
    private GalleryFilter? suggestedFilter;
    private List<ImageRecord> compareImages = [];
    private readonly Dictionary<string, string> comparison = [];
    private IEnumerable<string> Collections => Images.SelectMany(image => image.Collections).Distinct(StringComparer.OrdinalIgnoreCase).Order();
    protected override void OnParametersSet()
    {
        suggestions.RemoveAll(suggestion => !Images.Any(image => image.Id == suggestion.Id));
        var imagesById = Images.ToDictionary(image => image.Id);
        for (var index = 0; index < compareImages.Count; index++)
            if (imagesById.TryGetValue(compareImages[index].Id, out var image)) compareImages[index] = image;
    }

    protected override Task OnInitializedAsync() => RunAsync("Loading saved views...", async () => views = await Gallery.LoadViewsAsync());

    private async Task RunAsync(string message, Func<Task> action, bool reportJob = false)
    {
        if (working) return;
        working = true; status = message; error = notice = "";
        reportingJob = reportJob;
        if (reportJob) jobWorkflow = Workflow;
        try { await PublishJobAsync(); await action(); }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Library workbench operation failed");
            error = exception is InvalidOperationException or IOException or System.Text.Json.JsonException
                ? exception.Message : "The operation failed. Check the application console.";
        }
        finally
        {
            if (reportJob) jobMessage = error.Length > 0 ? "Operation reported errors. Open workflow for details." : notice;
            working = analyzing = reportingJob = false;
            await PublishJobAsync();
        }
    }

    private Task PublishJobAsync() => disposed ? Task.CompletedTask : JobChanged.InvokeAsync(
        new LibraryJobStatus(working && reportingJob, jobWorkflow, working && reportingJob ? status : jobMessage,
            suggestions.Count, analyzing && !cancelRequested));

    public async Task StopAnalysisAsync()
    {
        if (!analyzing) return;
        cancelRequested = true;
        status = "Stopping after the current image...";
        await PublishJobAsync();
    }

    private async Task DismissAsync(OrganizationSuggestion suggestion)
    {
        suggestions.Remove(suggestion);
        jobMessage = $"{suggestions.Count} suggestions await approval.";
        await PublishJobAsync();
    }

    private async Task ApplyBulkAsync(Func<ImageRecordEdit, ImageRecordEdit> change)
    {
        var failures = new List<string>();
        var ids = SelectedIds.ToArray();
        foreach (var id in ids)
        {
            try { await Gallery.UpdateAsync(id, change); }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Bulk organization failed for {ImageId}", id);
                failures.Add($"{id}: {exception.Message}");
            }
        }
        await Changed.InvokeAsync();
        notice = $"Updated {ids.Length - failures.Count} image(s).";
        error = string.Join(" / ", failures);
    }

    private Task OrganizeAsync() => RunAsync("Organizing selection...", async () =>
    {
        if (collection.Trim().Length > 80 || tags.Length > 4000)
            throw new InvalidOperationException("Collection or tags are too long.");
        if (collection.Trim().Length == 0 && tags.Trim().Length == 0)
            throw new InvalidOperationException("Enter a collection or tags.");
        await ApplyBulkAsync(image =>
        {
            var updated = image with { Tags = Gallery.MergeTags(image.Tags, tags) };
            return collection.Trim().Length > 0
                ? Gallery.SetOrganization(updated, updated.Rating, updated.Reviewed, collection) : updated;
        });
    });

    private Task RemoveCollectionAsync() => RunAsync("Updating collections...", () => ApplyBulkAsync(image =>
        image with { Collections = image.Collections.RemoveAll(name => name.Equals(collection.Trim(), StringComparison.OrdinalIgnoreCase)) }));

    private Task RateAsync() => RunAsync("Curating selection...", () => ApplyBulkAsync(image =>
        Gallery.SetCuration(image, rating == -1 ? null : rating,
            reviewStatus == "unchanged" ? null : reviewStatus == "reviewed")));

    private Task SaveViewAsync() => RunAsync("Saving view...", async () =>
    {
        await Gallery.SaveViewAsync(viewName, Filter);
        views = await Gallery.LoadViewsAsync();
        notice = "Saved view stored encrypted.";
    });

    private Task DeleteViewAsync(string name) => RunAsync("Deleting view...", async () =>
    {
        await Gallery.DeleteViewAsync(name);
        views = await Gallery.LoadViewsAsync();
    });

    private Task InterpretAsync() => RunAsync("Interpreting search locally...", async () =>
    {
        suggestedFilter = await Gallery.InterpretSearchAsync(await Gallery.SettingsAsync(), query, Collections.ToArray());
        notice = "Search interpretation ready to inspect.";
    }, reportJob: true);

    private async Task ApplySearchAsync()
    {
        if (suggestedFilter is not null) await FilterChanged.InvokeAsync(suggestedFilter with { });
        suggestedFilter = null;
    }

    private Task SuggestAsync() => RunAsync("Analyzing selection...", async () =>
    {
        if (SelectedIds.Count is 0 or > 24) throw new InvalidOperationException("Select between 1 and 24 images.");
        cancelRequested = false;
        analyzing = true;
        var settings = await Gallery.SettingsAsync();
        var selected = Images.Where(image => SelectedIds.Contains(image.Id)).ToArray();
        var failures = new List<string>();
        var completed = 0;
        foreach (var image in selected)
        {
            if (disposed || cancelRequested) break;
            status = $"Analyzing {completed + 1} / {selected.Length}: {image.Name}";
            await PublishJobAsync();
            await InvokeAsync(StateHasChanged);
            try
            {
                var result = await Gallery.AnalyzeImageWithCollectionAsync(settings, await Gallery.PreviewAsync(image.Id), Collections.ToArray());
                if (disposed) break;
                suggestions.RemoveAll(suggestion => suggestion.Id == image.Id);
                suggestions.Add(new(image.Id, image.Name, result.Description, result.Tags, result.Collection, settings.Model, result.Warning));
                if (result.Warning.Length > 0) Logger.LogWarning("Analysis collection warning for {ImageId}: {Warning}", image.Id, result.Warning);
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Local analysis failed for {ImageId}", image.Id);
                failures.Add($"{image.Name}: {exception.Message}");
            }
            completed++;
        }
        notice = $"{(cancelRequested ? "Stopped" : "Analysis finished")}: {completed} / {selected.Length} processed; {failures.Count} failed. {suggestions.Count} suggestions await approval.";
        error = string.Join(" / ", failures);
    }, reportJob: true);

    private Task ApproveAsync(OrganizationSuggestion suggestion) => RunAsync("Saving approved suggestion...", async () =>
    {
        await Gallery.UpdateAsync(suggestion.Id, image =>
        {
            var updated = image with { Description = suggestion.Description,
                Tags = Gallery.MergeTags(image.Tags, suggestion.Tags), AnalysisModel = suggestion.Model };
            return suggestion.Collection.Length > 0
                ? Gallery.SetOrganization(updated, updated.Rating, updated.Reviewed, suggestion.Collection) : updated;
        });
        suggestions.Remove(suggestion);
        jobMessage = $"{suggestions.Count} suggestions await approval.";
        await Changed.InvokeAsync();
    });

    private Task CompareAsync() => RunAsync("Preparing comparison...", async () =>
    {
        comparison.Clear();
        var selected = Images.Where(image => SelectedIds.Contains(image.Id)).ToList();
        if (selected.Count != 2) throw new InvalidOperationException("Select exactly two images.");
        foreach (var image in selected) comparison[image.Id] = await Gallery.ViewerImageAsync(image.Id, ImageResolution.Fit);
        compareImages = selected;
    });

    private Task RateOneAsync(ImageRecord image, int value) => RunAsync("Saving rating...", async () =>
    {
        await Gallery.UpdateAsync(image.Id, current => Gallery.SetOrganization(current, value, true, null));
        var comparisonIndex = compareImages.FindIndex(comparedImage => comparedImage.Id == image.Id);
        if (comparisonIndex >= 0) compareImages[comparisonIndex] = image with { Rating = value, Reviewed = true };
        await Changed.InvokeAsync();
    });

    private void CloseComparison() { compareImages.Clear(); comparison.Clear(); }
    public void Dispose() { disposed = true; cancelRequested = true; suggestions.Clear(); CloseComparison(); }
}
