                settingsTab = useRecovery ? "security" : "overview";
                density = (await Gallery.LoadPreferencesAsync()).GridDensity;
                await ReloadAsync();
            }
            else
            {
                if (secret != confirm) throw new InvalidOperationException("Passphrases do not match.");
                var created = await Vault.CreateAsync(secret);
                Session.Unlock(created.Key);
                recoveryPhrase = created.Recovery;
            }
        }
        catch
        {
            Lock();
            throw;
        }
        finally { secret = confirm = ""; }
    });

