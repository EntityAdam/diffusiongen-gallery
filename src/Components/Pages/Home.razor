        finally
        {
            busy = false;
            progress = "";
            if (disposed) Session.Lock();
        }
    }

    private void SwitchCredential(bool recovery) { useRecovery = recovery; secret = ""; }

    private Task UnlockAsync() => RunAsync("Unlocking vault...", async () =>
