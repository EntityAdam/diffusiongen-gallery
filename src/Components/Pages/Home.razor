        storageOverview = await Gallery.RefreshStorageOverviewAsync();
        message = "Gallery overview refreshed.";
    });
    private void LibraryJobChanged(LibraryJobStatus status) => libraryJob = status;
    private Task OpenLibraryJobAsync() => SwitchWorkflowAsync(libraryJob.Suggestions > 0 && !libraryJob.Running ? "ai" : libraryJob.Workflow);
    private void DismissLibraryJob() => libraryJob = new(false, "", "", 0, false);
    private Task StopLibraryJobAsync() => workbench?.StopAnalysisAsync() ?? Task.CompletedTask;
    private void ClearSelection() { librarySelection.Clear(); removalSelection.Clear(); selectionAnchor = null; }
    private void ViewerImageChanged(ImageRecord updated)
    {
        var image = images.Single(item => item.Id == updated.Id);
        image.Reviewed = updated.Reviewed;
        image.Rating = updated.Rating;
        image.Favorite = updated.Favorite;
        image.MarkedForDeletion = updated.MarkedForDeletion;
    }
    private void SelectLibraryPage() { librarySelection.UnionWith(PageImages.Select(image => image.Id)); }
    private void ToggleLibrarySelection(string id, bool value)
    {
        if (value) librarySelection.Add(id); else librarySelection.Remove(id);
    }
    private void SelectCard(string id, bool range)
    {
        var ordered = Filtered.Select(image => image.Id).ToList();
        var anchor = selectionAnchor is null ? -1 : ordered.IndexOf(selectionAnchor);
        var target = ordered.IndexOf(id);
        if (range && anchor >= 0 && target >= 0)
        {
            var (from, to) = anchor <= target ? (anchor, target) : (target, anchor);
            librarySelection.UnionWith(ordered.Skip(from).Take(to - from + 1));
        }
        else ToggleLibrarySelection(id, !librarySelection.Contains(id));
        selectionAnchor = id;
    }

    private Task ToggleQuickFilterAsync(QuickFilter chip)
    {
        chip.Toggle(filter, !chip.IsActive(filter));
        return FilterChangedAsync();
    }

    private Task SetDensityAsync(string value) => RunAsync("Saving thumbnail size...", async () =>
    {
        if (density == value) return;
        var first = page * PageSize;
        density = value;
        page = Math.Min(first / PageSize, PageCount - 1);
        await LoadThumbnailsAsync();
        await Gallery.SavePreferencesAsync(new UiPreferences { GridDensity = value });
    });

    private async Task CurateAsync(IReadOnlyCollection<string> ids, Action<ImageRecord> update, string done)
    {
        if (ids.Count == 0) return;
        var failed = await Gallery.UpdateManyAsync(ids, update);
        if (failed > 0) await ReloadAsync();
        else
        {
            foreach (var id in ids) if (imagesById.TryGetValue(id, out var image)) update(image);
            page = Math.Min(page, PageCount - 1);
            await LoadMissingThumbnailsAsync();
        }
        message = failed > 0 ? $"{done} {failed} image(s) could not be updated." : done;
    }

    private Task BulkAsync(string status, Action<ImageRecord> update, string done) =>
        RunAsync(status, () => CurateAsync(librarySelection.ToList(), update, $"{done} ({librarySelection.Count} images)."));
    private Task BulkRateAsync(int value) => BulkAsync("Rating selected images...", image => LibraryService.SetCuration(image, value, null), value == 0 ? "Ratings cleared" : $"Rated {value} stars");
    private Task BulkFavoriteAsync(bool value) => BulkAsync("Updating favorites...", image => image.Favorite = value, value ? "Added to favorites" : "Removed from favorites");
    private Task BulkReviewedAsync(bool value) => BulkAsync("Updating review status...", image => image.Reviewed = value, "Marked reviewed");
    private Task BulkMarkAsync(bool value) => BulkAsync("Updating deletion marks...", image => image.MarkedForDeletion = value, value ? "Marked for deletion" : "Deletion marks cleared");
    private Task BulkTagAsync()
    {
        var tags = bulkTags.Trim();
        if (tags.Length == 0) return Task.CompletedTask;
        bulkTags = "";
        return BulkAsync("Adding tags...", image => image.Tags = LibraryService.MergeTags(image.Tags, tags), "Tags added");
    }
    private Task BulkCollectAsync()
    {
        var name = bulkCollection.Trim();
        if (name.Length is 0 or > 80) return Task.CompletedTask;
        bulkCollection = "";
        return BulkAsync("Adding to collection...", image =>
        {
            if (!image.Collections.Contains(name, StringComparer.OrdinalIgnoreCase)) image.Collections.Add(name);
        }, $"Added to {name}");
    }

    [JSInvokable]
    public async Task HandleGridKey(string key, string id, bool shift)
    {
        if (!Session.IsUnlocked || busy || !ShowsGallery || selected is not null || removalPlan.Count > 0 || viewerImages.Count > 0 || reviewGroups.Count > 0) return;
        if (key == "escape") { ClearSelection(); selectionAnchor = null; StateHasChanged(); return; }
        if (!imagesById.TryGetValue(id, out var image)) return;
        if (key == "x")
        {
            if (workflow == "remove") return;
            SelectCard(id, shift);
            StateHasChanged();
            return;
        }
        Action<ImageRecord>? update = key switch
        {
            "0" or "1" or "2" or "3" or "4" or "5" => current => LibraryService.SetCuration(current, key[0] - '0', null),
            "f" when !image.Favorite => current => current.Favorite = true,
            "f" => current => current.Favorite = false,
            "delete" when !image.MarkedForDeletion => current => current.MarkedForDeletion = true,
            "delete" => current => current.MarkedForDeletion = false,
            _ => null
        };
        if (update is null) return;
        var done = key switch
        {
            "f" => image.Favorite ? "Removed from favorites." : "Added to favorites.",
            "delete" => image.MarkedForDeletion ? "Deletion mark cleared." : "Marked for deletion.",
            "0" => "Rating cleared.",
            _ => $"Rated {key} stars."
        };
        await RunAsync("Saving...", () => CurateAsync([id], update, $"{image.Name}: {done}"));
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        gridReference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("galleryGrid.attach", gridReference);
    }
    private Task PreviousAsync() => RunAsync("Loading previews...", async () => { page--; await LoadThumbnailsAsync(); });
    private Task NextAsync() => RunAsync("Loading previews...", async () => { page++; await LoadThumbnailsAsync(); });

    private Task ImportFolderAsync() => RunAsync("Scanning selected folder...", async () =>
    {
        EnsureNoLibraryJob();
        if (deleteSources && !confirmSourceDeletion)
            throw new InvalidOperationException("Confirm source deletion before importing, or disable it to keep originals.");
        importFailures = [];
        importProgress = new ImportProgress(null, 0, 0, 0, "Scanning selected folder...");
        await InvokeAsync(StateHasChanged);
        var lastProgressRender = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            importFailures = await Gallery.ImportFolderAsync(importPath, recursive, deleteSources: deleteSources,
                reportProgress: update => InvokeAsync(() =>
                {
                    if (disposed) return;
                    var render = update.Total != importProgress?.Total || update.Completed == update.Total
                        || update.Failed != importProgress?.Failed || lastProgressRender.ElapsedMilliseconds >= 100;
                    importProgress = update;
                    if (render)
                    {
                        StateHasChanged();
                        lastProgressRender.Restart();
                    }
                }));
            if (disposed) return;
            importProgress = importProgress with { Status = "Refreshing library..." };
            await InvokeAsync(StateHasChanged);
            await ReloadAsync();
            if (disposed) return;
            importProgress = importProgress with { Status = importProgress.Total == 0 ? "No supported images found." : "Ingestion complete." };
            message = $"Imported {importProgress.Imported} images. {importFailures.Count} file(s) reported errors."
                + (deleteSources ? " Sources of verified imports were deleted unless an error was reported; duplicates were retained." : " Sources were retained.");
        }
        catch
        {
            if (importProgress is not null)
                importProgress = importProgress with { Status = "Ingestion stopped. See the error above; completed imports were retained." };
            throw;
        }
        deleteSources = confirmSourceDeletion = false;
    });

    private Task RateImageAsync(ImageRecord image, int value) => RunAsync("Saving rating...", async () =>
    {
        await Gallery.UpdateAsync(image.Id, current =>
            LibraryService.SetCuration(current, current.Rating == value ? 0 : value, null));
        await ReloadAsync();
    });

    private Task FavoriteAsync(ImageRecord image) => RunAsync("Saving favorite...", async () =>
    {
        await Gallery.UpdateAsync(image.Id, current => current.Favorite = !current.Favorite);
        await ReloadAsync();
    });

    private Task MarkAsync(ImageRecord image) => RunAsync("Saving deletion mark...", async () =>
    {
        await Gallery.UpdateAsync(image.Id, current => current.MarkedForDeletion = !current.MarkedForDeletion);
        await ReloadAsync();
    });

    private void ToggleRemovalSelection(string id, bool value)
    {
        if (value) removalSelection.Add(id);
        else removalSelection.Remove(id);
    }

    private void SelectFilteredMarked()
    {
        removalSelection.Clear();
        removalSelection.UnionWith(Filtered.Where(image => image.MarkedForDeletion).Select(image => image.Id));
    }

    private Task PrepareBulkRemovalAsync() => PrepareRemovalAsync(removalSelection.ToArray());
    private Task PrepareRemovalAsync(IEnumerable<string> ids) => RunAsync("Checking originals...", async () =>
    {
        EnsureNoLibraryJob();
        removalPlan = await Gallery.PrepareRemovalAsync(ids);
        confirmRemoval = false;
        existingOriginalAction = ExistingOriginalAction.Retain;
        missingOriginalAction = MissingOriginalAction.RestorePng;
        removalResults.Clear();
    });

    private void CancelRemoval() { removalPlan.Clear(); confirmRemoval = false; }

    private Task ExecuteRemovalAsync() => RunAsync("Removing marked images...", async () =>
    {
        EnsureNoLibraryJob();
        if (!confirmRemoval) throw new InvalidOperationException("Confirm removal first.");
        removalResults = await Gallery.RemoveAsync(removalPlan, existingOriginalAction, missingOriginalAction, restoreFolder);
        foreach (var result in removalResults.Where(result => result.Error is not null))
            Logger.LogWarning("Image removal issue for {ImageId}: {Error}", result.Id, result.Error);
        CancelRemoval();
        CloseDetail();
        await ReloadAsync();
        message = $"Removed {removalResults.Count(result => result.Removed)} images. {removalResults.Count(result => result.Error is not null)} issue(s); review the removal results.";
    });

    private Task OpenAsync(ImageRecord image) => RunAsync("Decrypting preview...", async () =>
    {
        var data = await Gallery.PreviewAsync(image.Id);
        selected = image;
        preview = data;
        editDescription = image.Description;
        editTags = image.Tags;
        destination = Path.GetDirectoryName(image.StoredPath)!;
        rename = image.Name;
    });

    private void CloseDetail() { selected = null; preview = editDescription = editTags = destination = rename = ""; }

    private void OpenViewer(string? initialId = null)
    {
        reviewMode = false;
        viewerImages = PageImages.Select(image => image with { }).ToList();
        if (initialId is not null && !viewerImages.Any(image => image.Id == initialId) && selected is not null)
            viewerImages.Add(selected with { });
        viewerInitialId = initialId ?? viewerImages.FirstOrDefault()?.Id ?? "";
        CloseDetail();
    }

    private void StartReview()
    {
        viewerImages = Filtered.Where(image => !image.Reviewed && !image.MarkedForDeletion)
            .Select(image => image with { }).ToList();
        viewerInitialId = viewerImages.FirstOrDefault()?.Id ?? "";
        reviewMode = true;
        CloseDetail();
    }

    private Task CloseViewerAsync()
    {
        viewerImages.Clear();
        viewerInitialId = "";
        return RunAsync("Refreshing gallery...", ReloadAsync);
    }

    private Task SaveNotesAsync() => RunAsync("Saving notes...", async () =>
    {
        if (selected is null) return;
        await Gallery.UpdateAsync(selected.Id, image => { image.Description = editDescription.Trim(); image.Tags = editTags.Trim(); });
        await ReloadAsync();
        message = "Notes saved.";
    });

    private Task AnalyzeAsync() => RunAsync("Analyzing with your local vision model...", async () =>
    {
        if (selected is null) return;
        var result = await Vision.AnalyzeAsync(settings, preview);
        await Gallery.UpdateAsync(selected.Id, image =>
        {
            image.Description = result.Description;
            image.Tags = result.Tags;
            image.AnalysisModel = settings.Model;
        });
        await ReloadAsync();
        editDescription = selected!.Description;
        editTags = selected.Tags;
        message = "Vision analysis saved.";
    });

    private Task MoveAsync() => RunAsync("Moving encrypted image...", async () =>
    {
        EnsureNoLibraryJob();
        if (selected is null) return;
        try { await Gallery.MoveAsync(selected.Id, destination, rename); }
        finally { await ReloadAsync(); }
        message = "Encrypted image moved and renamed.";
    });

    private Task ChangePassphraseAsync() => RunAsync("Updating passphrase...", async () =>
    {
        EnsureNoLibraryJob();
        try
        {
            if (newPassphrase != newConfirm) throw new InvalidOperationException("New passphrases do not match.");
            using var key = Session.Borrow();
            await Vault.ChangePassphraseAsync(key.Bytes, newPassphrase);
            message = "Passphrase updated. Your recovery words are unchanged.";
        }
        finally { newPassphrase = newConfirm = ""; }
    });

    private void EnsureNoLibraryJob()
    {
        if (libraryJob.Running) throw new InvalidOperationException("Wait for the running LLM job to finish, or stop it after the current image, before changing files or vault settings.");
    }

    private void Lock()
    {
        Session.Lock();
        images.Clear();
        thumbnails.Clear();
        CloseDetail();
        secret = confirm = recoveryPhrase = newPassphrase = newConfirm = error = message = importPath = "";
        importFailures.Clear();
        importProgress = null;
        settings = new();
        filter = new();
        page = 0;
        useRecovery = recoverySaved = false;
        workflow = "library";
        settingsTab = "overview";
        storageOverview = null;
        browsingFilter = null;
        libraryJob = new(false, "", "", 0, false);
        deleteSources = confirmSourceDeletion = false;
        removalSelection.Clear();
        removalPlan.Clear();
        removalResults.Clear();
        confirmRemoval = false;
        restoreFolder = "";
        librarySelection.Clear();
        viewerImages.Clear();
        viewerInitialId = "";
        imagesById = [];
        density = "comfortable";
        bulkTags = bulkCollection = "";
        selectionAnchor = null;
        duplicateScan = null;
        duplicateThumbnails.Clear();
        VisibleDuplicateGroups = [];
        reviewGroups = [];
        DuplicateGroupsShown = 20;
    }

    public void Dispose()
    {
        disposed = true;
        Lock();
        gridReference?.Dispose();
    }
}
