                            {
                                <button disabled="@busy" @onclick="() => PrepareRemovalAsync(new[] { selected.Id })">Remove this image</button>
                            }
                        </div>
                        <h3>Vision notes</h3>
                        <label for="description">Description</label><textarea id="description" rows="4" @bind="editDescription"></textarea>
                        <label for="edit-tags">Tags, comma-separated</label><input id="edit-tags" @bind="editTags" placeholder="landscape, sunset, cinematic" />
                        <div class="actions"><button disabled="@busy" @onclick="SaveNotesAsync">Save notes</button><button class="primary" disabled="@busy" @onclick="AnalyzeAsync">Analyze locally</button></div>
                        @if (selected.AnalysisModel.Length > 0) { <small class="muted">Analyzed by @selected.AnalysisModel</small> }
                        <h3>Move &amp; rename</h3>
                        <form @onsubmit="MoveAsync" @onsubmit:preventDefault>
                            <label for="destination">Existing destination folder</label><input id="destination" @bind="destination" required />
                            <label for="rename">Filename</label><div class="filename-input"><input id="rename" @bind="rename" required /><span>.dpng</span></div>
                            <button type="submit" disabled="@busy">Move encrypted image &rarr;</button>
                        </form>
                        <small class="muted">No overwrite. The file remains encrypted. Deletion marks are reversible; permanent removal requires a separate confirmation.</small>
                        <details><summary>Embedded generation metadata</summary><pre>@selected.Metadata</pre></details>
                        <details><summary>File locations</summary><p class="path">@selected.StoredPath</p><p class="path">Source: @selected.SourceFolder</p></details>
                        @if (busy) { <p class="notice" role="status">@progress</p> }
                        @if (error.Length > 0) { <p class="notice error" role="alert">@error</p> }
                    </div>
                </div>
            </section>
        </div>
    }
    @if (removalPlan.Count > 0)
    {
        <div class="modal-backdrop">
            <section class="panel unlock-panel" role="dialog" aria-modal="true" aria-labelledby="removal-title">
                <div class="panel-header"><h2 id="removal-title">Remove @removalPlan.Count marked image(s)</h2><button class="icon-button" disabled="@busy" @onclick="CancelRemoval" aria-label="Cancel removal">&times;</button></div>
                <p>This removes gallery records, thumbnails and encrypted files. Each image is checked again before removal. Unmarked images cannot be removed.</p>
                <details><summary>Review affected images</summary>
                    @foreach (var item in removalPlan)
                    {
                        <p class="path">@item.Name: @(item.OriginalExists ? $"Original exists: {item.OriginalPath}" : "No accessible original (missing or browser upload)")</p>
                    }
                </details>
                @if (removalPlan.Any(item => item.OriginalExists))
                {
                    <label for="existing-action">Original exists (@removalPlan.Count(item => item.OriginalExists))</label>
                    <select id="existing-action" @bind="existingOriginalAction" disabled="@busy">
                        <option value="@ExistingOriginalAction.Retain">Remove from gallery, retain original</option>
                        <option value="@ExistingOriginalAction.Delete">Remove from gallery AND delete original</option>
                    </select>
                }
                @if (removalPlan.Any(item => !item.OriginalExists))
                {
                    <label for="missing-action">No accessible original (@removalPlan.Count(item => !item.OriginalExists))</label>
                    <select id="missing-action" @bind="missingOriginalAction" disabled="@busy">
                        <option value="@MissingOriginalAction.RestorePng">Restore a PNG copy, then remove from gallery</option>
                        <option value="@MissingOriginalAction.Discard">Remove from gallery without restoration (lost forever)</option>
                    </select>
                    @if (missingOriginalAction == MissingOriginalAction.RestorePng)
                    {
                        <label for="restore-folder">Existing folder for restored PNG files</label>
                        <input id="restore-folder" @bind="restoreFolder" disabled="@busy" />
                        <p class="muted">Restores full-resolution PNGs named by image ID; never overwrites. Exact JPEG/WebP source bytes are not retained. Browser uploads may still have originals the app cannot access.</p>
                    }
                }
                <div class="notice error">Removal bypasses the Recycle Bin. Without a retained or restored copy, images are lost from this vault. Backups may still contain them. This is not secure SSD/NVMe erasure.</div>
                <label class="check"><input type="checkbox" @bind="confirmRemoval" disabled="@busy" /> I reviewed these images and actions and confirm permanent removal.</label>
                <button class="primary full" disabled="@(busy || !confirmRemoval)" @onclick="ExecuteRemovalAsync">Confirm removal of @removalPlan.Count image(s)</button>
                @if (error.Length > 0) { <p class="notice error" role="alert">@error</p> }
                @if (busy) { <p role="status">@progress</p> }
            </section>
        </div>
    }
}

@if (Session.IsUnlocked && viewerImages.Count > 0)
{
    <FullscreenViewer Images="viewerImages" InitialId="@viewerInitialId" ReviewMode="reviewMode" OnClose="CloseViewerAsync" OnImageChanged="ViewerImageChanged" />
}
@if (Session.IsUnlocked && reviewGroups.Count > 0)
{
    <DuplicateReviewer Groups="reviewGroups" Lookup="@(id => ImageById(id))" InitialGroup="reviewStartGroup" OnClose="CloseDuplicateReviewAsync" />
}

@code {
