@page "/"
@implements IDisposable
@inject VaultStore Vault
@inject VaultSession Session
@inject GalleryService Gallery
@inject VisionService Vision
@inject ILogger<Home> Logger
@inject IJSRuntime JS

<PageTitle>Diffusion Gen Gallery 02</PageTitle>

@if (!Session.IsUnlocked)
{
<section class="hero">
    <div>
        <div class="eyebrow"><span></span> YOUR IMAGINATION, KEPT SAFE</div>
        <h1>A home for<br />every <span>what if.</span></h1>
        <p>Your private creative library. Organize with intent. Discover with local intelligence.</p>
    </div>
    <div class="hero-art" aria-hidden="true"><div class="orbit"></div><div class="orbit second"></div><span>&#10035;</span><div class="art-caption">CREATE. COLLECT. KEEP.</div></div>
</section>
}

@if (error.Length > 0)
{
    <div class="notice error" role="alert">@error <button class="icon-button" @onclick="() => error = string.Empty" aria-label="Dismiss error">&times;</button></div>
}
@if (message.Length > 0)
{
    <div class="notice" role="status">@message</div>
}

@if (!Session.IsUnlocked)
{
    <section class="panel unlock-panel">
        <div class="panel-header"><span class="eyebrow">ENCRYPTED VAULT</span><span class="pill">AES-256-GCM</span></div>
        <h2>@(Vault.Exists ? "Welcome back." : "Your gallery starts here.")</h2>
        <p class="muted">@(Vault.Exists ? "Unlock your collection with your passphrase or recovery words." : "Choose a strong, unique passphrase. We will generate a separate recovery phrase for you to save offline.")</p>
        <form @onsubmit="UnlockAsync" @onsubmit:preventDefault>
            @if (Vault.Exists)
            {
                <div class="segmented">
                    <button type="button" class="@(!useRecovery ? "active" : "")" @onclick="() => SwitchCredential(false)">Passphrase</button>
                    <button type="button" class="@(useRecovery ? "active" : "")" @onclick="() => SwitchCredential(true)">Recovery words</button>
                </div>
            }
            <label for="secret">@(useRecovery ? "32 recovery words" : "Passphrase")</label>
            @if (useRecovery)
            {
                <textarea id="secret" @bind="secret" rows="4" autocomplete="off" spellcheck="false" required></textarea>
            }
            else
            {
                <input id="secret" type="password" @bind="secret" autocomplete="off" minlength="14" required />
            }
            @if (!Vault.Exists)
            {
                <label for="confirm">Confirm passphrase</label>
                <input id="confirm" type="password" @bind="confirm" autocomplete="off" minlength="14" required />
            }
            <button class="primary full" disabled="@busy" type="submit">@(busy ? "Deriving encryption key..." : Vault.Exists ? "Unlock gallery" : "Create encrypted gallery") <span>&rarr;</span></button>
        </form>
        <div class="security-note"><strong>No reset link. No backdoor.</strong> If you lose both your passphrase and recovery words, your encrypted images cannot be recovered. Originals are retained unless you explicitly enable source deletion for a local folder import.</div>
    </section>
}
else if (recoveryPhrase.Length > 0)
{
    <section class="panel recovery-panel">
        <span class="eyebrow">SAVE THIS BEFORE CONTINUING</span>
        <h2>Your recovery words.</h2>
        <p>Write these 32 words down, in order, and keep them offline in a safe place. Anyone with these words can unlock your gallery. They are shown only now.</p>
        <div class="word-grid">
            @foreach (var (word, index) in recoveryPhrase.Split(' ').Select((word, index) => (word, index)))
            {
                <div><small>@(index + 1).</small> @word</div>
            }
        </div>
        <label class="check"><input type="checkbox" @bind="recoverySaved" /> I saved all 32 words securely and understand there is no other recovery method.</label>
        <button class="primary" disabled="@(!recoverySaved || busy)" @onclick="FinishSetupAsync">Open my gallery &rarr;</button>
    </section>
}
else
{
    <div class="workflow-layout">
    <nav class="workflow-nav panel" aria-label="Gallery workflows">
        <span class="eyebrow">YOUR WORKSPACE</span>
        @foreach (var item in Workflows)
        {
            <button disabled="@(busy || libraryJob.Running && item.Id is "remove" or "ingest" or "settings")" class="@(workflow == item.Id ? "active" : "")" aria-current="@(workflow == item.Id ? "page" : null)" @onclick="() => SwitchWorkflowAsync(item.Id)">@item.Name</button>
        }
        <div class="security-note"><strong>@images.Count images</strong><span data-testid="pending-count">@PendingReviewCount awaiting review</span></div>
        @if (libraryJob.Running || libraryJob.Suggestions > 0 || libraryJob.Message.Length > 0)
        {
            <div class="job-indicator" role="status">
                <strong>@(libraryJob.Running ? "Library job running" : "Library job")</strong>
                <p>@libraryJob.Message</p>
                @if (libraryJob.Suggestions > 0) { <p>@libraryJob.Suggestions suggestions await approval</p> }
                <button disabled="@busy" @onclick="OpenLibraryJobAsync">Open job</button>
                @if (libraryJob.CanStop)
                {
                    <button @onclick="StopLibraryJobAsync">Stop after current image</button>
                }
                @if (!libraryJob.Running && libraryJob.Suggestions == 0)
                {
                    <button @onclick="DismissLibraryJob">Dismiss job status</button>
                }
            </div>
        }
        <button disabled="@(busy || libraryJob.Running)" @onclick="Lock">Lock vault</button>
    </nav>
    <div class="workflow-content">
    <div class="collection-header">
        <div><span class="eyebrow">THE COLLECTION</span><h2>@Workflows.Single(item => item.Id == workflow).Name <span class="count">@images.Count</span></h2></div>
        <div class="actions">
            @if (ShowsGallery)
            {
                <button disabled="@(busy || !PageImages.Any())" @onclick="() => OpenViewer()">Full screen view</button>
            }
        </div>
    </div>

    @if (workflow == "ingest")
    {
        <section class="panel">
            <div class="panel-header"><h3>Bring your images home.</h3><span class="pill">PNG / JPEG / WEBP</span></div>
            <p class="muted">Copies are converted to PNG and encrypted as .dpng. Sources are retained by default. Duplicate images are reported, not reimported or deleted. Maximum 50 MiB / 40 MP per image.</p>
                <form @onsubmit="ImportFolderAsync" @onsubmit:preventDefault>
                    <label for="source">Local folder path</label>
                    <input id="source" @bind="importPath" placeholder="C:\Pictures\Diffusion" required disabled="@busy" />
                    <label class="check"><input type="checkbox" @bind="recursive" disabled="@busy" /> Include subfolders</label>
                    <label class="check"><input type="checkbox" @bind="deleteSources" disabled="@busy" /> Delete originals after verified import</label>
                    @if (deleteSources)
                    {
                        <div class="notice error">Originals will be deleted without the Recycle Bin after the saved image, catalog and thumbnail are verified. This is not secure shredding: SSD/NVMe remnants, backups and snapshots may remain recoverable.</div>
                        <label class="check"><input type="checkbox" @bind="confirmSourceDeletion" disabled="@busy" /> I understand this permanently removes successfully imported source files, not their forensic remnants.</label>
                    }
                    <button disabled="@busy" type="submit">Ingest this folder &rarr;</button>
                </form>
            @if (importProgress is not null)
            {
                <div class="ingestion-progress" aria-busy="@(busy ? "true" : "false")">
                    <label for="ingestion-progress">Image ingestion</label>
                    <progress id="ingestion-progress" max="@Math.Max(1, importProgress.Total ?? 1)"
                              value="@(importProgress.Total is null ? null : (double?)importProgress.Completed)"
                              aria-label="Image ingestion progress"></progress>
                    <p class="muted">
                        @if (importProgress.Total is int total)
                        {
                            <span>@importProgress.Completed / @total files processed &middot; @importProgress.Imported imported &middot; @importProgress.Failed reported issues</span>
                        }
                    </p>
                    <p role="status">@importProgress.Status</p>
                </div>
            }
            @if (importFailures.Count > 0)
            {
                <details open class="import-errors"><summary>@importFailures.Count file(s) reported issues</summary>
                    @foreach (var failure in importFailures) { <p>@failure</p> }
                </details>
            }
        </section>
    }
    @if (workflow == "settings")
    {
        <nav class="settings-tabs" aria-label="Settings sections">
            @foreach (var tab in SettingsTabs)
            {
                <button type="button" class="@(settingsTab == tab.Id ? "active" : "")" aria-current="@(settingsTab == tab.Id ? "page" : null)" disabled="@busy" @onclick="() => SwitchSettingsTabAsync(tab.Id)">@tab.Name</button>
            }
        </nav>
    }
    @if (workflow == "settings" && settingsTab == "overview")
    {
        <section class="panel storage-overview" aria-labelledby="storage-overview-title">
            <div class="panel-header">
                <h3 id="storage-overview-title">Gallery overview</h3>
                <button type="button" disabled="@busy" @onclick="RefreshStorageOverviewAsync">@(busy && progress.StartsWith("Measuring") ? "Refreshing..." : "Refresh")</button>
            </div>
            @if (storageOverview is null)
            {
                <p class="muted">Storage has not been measured yet. Select Refresh to calculate it.</p>
            }
            else
            {
                <dl class="overview-stats">
                    <div><dt>Database size</dt><dd data-testid="database-size">@StorageOverview.FormatBytes(storageOverview.DatabaseBytes)</dd><span class="muted">gallery.db with WAL files, including thumbnails</span></div>
                    <div><dt>Total file count</dt><dd data-testid="file-count">@storageOverview.TotalFileCount.ToString("N0")</dd><span class="muted">@storageOverview.ImageFileCount.ToString("N0") encrypted images + @storageOverview.VaultFileCount vault files</span></div>
                    <div><dt>Total size on disk</dt><dd data-testid="total-size">@StorageOverview.FormatBytes(storageOverview.TotalBytes)</dd><span class="muted">@StorageOverview.FormatBytes(storageOverview.ImageBytes) of encrypted images</span></div>
                </dl>
                @if (storageOverview.MissingImageFiles > 0)
                {
                    <div class="notice error">@storageOverview.MissingImageFiles catalogued image file(s) were not found on disk and are not counted.</div>
                }
                <p class="muted" data-testid="overview-updated">Last updated <time datetime="@storageOverview.UpdatedAt.ToString("O")">@storageOverview.UpdatedAt.ToLocalTime().ToString("g")</time>. Cached values are shown until you refresh.</p>
            }
            <p class="muted duplicate-hint">
                @if (duplicateScan is null) { <span>Duplicates have not been scanned yet.</span> }
                else { <span>Last duplicate scan found @VisibleDuplicateGroups.Sum(group => group.Ids.Count - 1).ToString("N0") likely duplicate(s), about @StorageOverview.FormatBytes(VisibleDuplicateGroups.Sum(group => group.ReclaimableBytes)) reclaimable.</span> }
                <button type="button" class="text-button" disabled="@busy" @onclick='() => SwitchSettingsTabAsync("duplicates")'>Find duplicates &rarr;</button>
            </p>
        </section>
    }
    @if (workflow == "settings" && settingsTab == "duplicates")
    {
        <section class="panel duplicates" aria-labelledby="duplicates-title">
            <div class="panel-header">
                <h3 id="duplicates-title">Duplicate finder</h3>
                <button type="button" class="primary" disabled="@busy" @onclick="ScanDuplicatesAsync">@(duplicateScan is null ? "Scan for duplicates" : "Scan again")</button>
            </div>
            <p class="muted">Compares a perceptual fingerprint of each encrypted thumbnail, so resized or re-encoded copies are found too. Fingerprints stay encrypted in the vault and only changed images are re-hashed. Nothing is deleted here: extra copies are marked for deletion and removed from <em>Remove marked images</em>.</p>
            @if (busy && progress.StartsWith("Scanning")) { <p class="progress" role="status"><span class="status-dot"></span> @progress</p> }
            @if (duplicateScan is not null)
            {
                var groups = VisibleDuplicateGroups;
                var pendingMarks = groups.Sum(group => group.Ids.Count(id => id != KeeperOf(group).Id && !ImageById(id)!.MarkedForDeletion));
                <div class="duplicate-summary">
                    <span><strong>@groups.Count</strong> group(s) &middot; <strong>@groups.Sum(group => group.Ids.Count - 1)</strong> extra copies &middot; <strong>@StorageOverview.FormatBytes(groups.Sum(group => group.ReclaimableBytes))</strong> reclaimable</span>
                    <span class="muted">Scanned @duplicateScan.ScannedCount.ToString("N0") images <time datetime="@duplicateScan.ScannedAt.ToString("O")">@duplicateScan.ScannedAt.ToLocalTime().ToString("g")</time></span>
                    <div class="actions">
                        <button type="button" class="primary" disabled="@(busy || groups.Count == 0)" @onclick="() => OpenDuplicateReview(groups, 0)">Review in full screen</button>
                        <button type="button" disabled="@(busy || pendingMarks == 0)" @onclick="() => MarkDuplicatesAsync(groups)">Mark all extra copies (@pendingMarks)</button>
                        <button type="button" disabled="@busy" @onclick='() => SwitchWorkflowAsync("remove")'>Go to Remove marked images</button>
                    </div>
                </div>
                @if (groups.Count == 0) { <p class="muted">No likely duplicates found.</p> }
                @foreach (var (group, groupNumber) in groups.Take(DuplicateGroupsShown).Select((group, index) => (group, index)))
                {
                    var keeper = KeeperOf(group);
                    var groupMarks = group.Ids.Count(id => id != keeper.Id && !ImageById(id)!.MarkedForDeletion);
                    <article class="duplicate-group" @key="group.Ids[0]">
                        <header>
                            <span>@(group.Exact ? "Exact copies" : $"Similar images (difference {group.MaxDistance}/64)") &middot; @StorageOverview.FormatBytes(group.ReclaimableBytes) reclaimable</span>
                            <div class="actions">
                                <button type="button" disabled="@busy" @onclick="() => OpenDuplicateReview(groups, groupNumber)">Review &amp; choose keepers</button>
                                <button type="button" disabled="@(busy || groupMarks == 0)" @onclick="() => MarkDuplicatesAsync([group])">@(groupMarks == 0 ? "Extra copies marked" : $"Mark {groupMarks} other(s) for deletion")</button>
                            </div>
                        </header>
                        <div class="duplicate-items">
                            @foreach (var id in group.Ids.OrderByDescending(id => id == keeper.Id))
                            {
                                var image = ImageById(id)!;
                                <figure class="@(id == keeper.Id ? "keep" : "") @(image.MarkedForDeletion ? "marked" : "")">
                                    @if (duplicateThumbnails.TryGetValue(id, out var thumbnail)) { <img src="@thumbnail" alt="@image.Name" draggable="false" /> }
                                    else { <div class="thumbnail-placeholder">Preview</div> }
                                    <figcaption>
                                        <strong title="@image.Name">@image.Name</strong>
                                        <span>@image.Width &times; @image.Height &middot; @StorageOverview.FormatBytes(image.OriginalBytes)@(image.Rating > 0 ? $" · {image.Rating}★" : "")@(image.Favorite ? " · Favorite" : "")</span>
                                        @if (id == keeper.Id) { <span class="badge keep-badge">Keep</span> }
                                        else if (image.MarkedForDeletion) { <span class="badge marked-badge">Marked</span> }
                                    </figcaption>
                                </figure>
                            }
                        </div>
                    </article>
                }
                @if (groups.Count > DuplicateGroupsShown)
                {
                    <button type="button" disabled="@busy" @onclick="ShowMoreDuplicatesAsync">Show more groups (@(groups.Count - DuplicateGroupsShown) remaining)</button>
                }
            }
        </section>
    }
    @if (workflow == "settings" && settingsTab == "endpoints")
    {
        <LlmEndpointSettings SavedSettings="settings" Saved="value => settings = value" />
    }
    @if (workflow == "settings" && settingsTab == "security")
    {
        <section class="panel settings">
            <h3>Vault security</h3>
                <form @onsubmit="ChangePassphraseAsync" @onsubmit:preventDefault>
                    <label for="new-passphrase">New passphrase</label>
                    <input id="new-passphrase" type="password" @bind="newPassphrase" minlength="14" autocomplete="off" required />
                    <label for="new-confirm">Confirm new passphrase</label>
                    <input id="new-confirm" type="password" @bind="newConfirm" minlength="14" autocomplete="off" required />
                    <p class="muted">Use this after unlocking with recovery words. Your recovery words remain unchanged. Back up the vault header, database, and all .dpng files together.</p>
                    <button disabled="@busy" type="submit">Change passphrase</button>
                </form>
            <p class="muted vault-location">Vault location: <code>@Vault.Root</code></p>
        </section>
    }

    @if (workflow == "library")
    {
    <div class="library-overview">
        <button disabled="@busy" @onclick='() => SetQueueAsync("all")'><strong>@images.Count</strong><span>In your library</span></button>
        <button disabled="@busy" @onclick='() => SetQueueAsync("pending")'><strong>@images.Count(image => !image.Reviewed && !image.MarkedForDeletion)</strong><span>Awaiting review</span></button>
        <button disabled="@busy" @onclick='() => SetQueueAsync("favorites")'><strong>@images.Count(image => image.Favorite && !image.MarkedForDeletion)</strong><span>Favorites</span></button>
        <button disabled="@busy" @onclick='() => SetQueueAsync("unorganized")'><strong>@images.Count(image => image.Collections.Count == 0 && !image.MarkedForDeletion)</strong><span>Without a collection</span></button>
    </div>
    }
    @if (workflow == "review")
    {
        <section class="panel review-intro">
            <h3>One image. One decision.</h3>
            <p class="muted">Keep, favorite, rate or mark for deletion to finish reviewing an image. Skip leaves it pending. The session includes pending, unmarked images matching your filters across all pages.</p>
            <button class="primary" disabled="@(busy || !Filtered.Any(image => !image.Reviewed && !image.MarkedForDeletion))" @onclick="StartReview">Start guided review (@Filtered.Count(image => !image.Reviewed && !image.MarkedForDeletion))</button>
        </section>
    }
    <LibraryWorkbench @ref="workbench" Visible="@(workflow is "organize" or "explore" or "ai")" Workflow="@workflow" Images="images" SelectedIds="librarySelection" Filter="filter" FilterChanged="ApplyLibraryFilterAsync" Changed="ReloadAsync" JobChanged="LibraryJobChanged" />
    @if (ShowsGallery)
    {
    <div class="gallery-layout">
        <aside class="panel filters">
            <details class="filter-disclosure">
            <summary>Filter images</summary>
            <div class="panel-header"><h3>Find your image</h3><button class="text-button" @onclick="ResetFilters" disabled="@busy">Reset</button></div>
            <label for="collection-filter">Collection</label>
            <select id="collection-filter" @bind="filter.Collection" @bind:after="FilterChangedAsync">
                <option value="">All collections</option>
                @foreach (var name in images.SelectMany(image => image.Collections).Distinct(StringComparer.OrdinalIgnoreCase).Order())
                { <option value="@name">@name</option> }
            </select>
            <label for="rating-filter">Minimum rating</label><select id="rating-filter" @bind="filter.MinRating" @bind:after="FilterChangedAsync">
                <option value="0">Any rating</option>@for (var score = 1; score <= 5; score++) { <option value="@score">@score / 5</option> }
            </select>
            <label for="review-filter">Review queue</label><select id="review-filter" @bind="filter.Review" @bind:after="FilterChangedAsync">
                <option value="all">All images</option><option value="pending">Awaiting review</option><option value="reviewed">Reviewed</option>
            </select>
            <label class="check"><input type="checkbox" @bind="filter.UnorganizedOnly" @bind:after="FilterChangedAsync" /> Without a collection only</label>
            <label for="search">Search everything</label>
            <input id="search" @bind="filter.Search" @bind:event="oninput" @bind:after="FilterChangedAsync" placeholder="Prompt, name, description..." />
            <label for="tag">Tag</label>
            <input id="tag" @bind="filter.Tag" @bind:after="FilterChangedAsync" placeholder="Exact tag" list="tags" />
            <datalist id="tags">@foreach (var tag in AllTags) { <option value="@tag"></option> }</datalist>
            <label for="folder">Folder</label>
            <input id="folder" @bind="filter.Folder" @bind:after="FilterChangedAsync" placeholder="Source or current folder" />
            <label for="analysis-model">Vision model</label>
            <input id="analysis-model" @bind="filter.Model" @bind:after="FilterChangedAsync" placeholder="Model name" />
            <label for="orientation">Orientation</label>
            <select id="orientation" @bind="filter.Orientation" @bind:after="FilterChangedAsync">
                <option value="all">All orientations</option><option value="landscape">Landscape</option><option value="portrait">Portrait</option><option value="square">Square</option>
            </select>
            <div class="two-fields">
                <div><label for="width">Min width</label><input id="width" type="number" min="0" @bind="filter.MinWidth" @bind:after="FilterChangedAsync" /></div>
                <div><label for="height">Min height</label><input id="height" type="number" min="0" @bind="filter.MinHeight" @bind:after="FilterChangedAsync" /></div>
            </div>
            <label for="analysis">Vision analysis</label>
            <select id="analysis" @bind="filter.Analysis" @bind:after="FilterChangedAsync">
                <option value="all">All images</option><option value="analyzed">Analyzed</option><option value="pending">Not analyzed yet</option>
            </select>
            <label for="deletion">Deletion status</label>
            <select id="deletion" @bind="filter.Deletion" @bind:after="FilterChangedAsync">
                <option value="active">Active images</option><option value="marked">Marked for deletion</option><option value="all">All images</option>
            </select>
            <label for="from">Imported from</label><input id="from" type="date" @bind="filter.From" @bind:after="FilterChangedAsync" />
            <label for="to">Imported through</label><input id="to" type="date" @bind="filter.To" @bind:after="FilterChangedAsync" />
            <label class="check"><input type="checkbox" @bind="filter.FavoritesOnly" @bind:after="FilterChangedAsync" /> Favorites only</label>
            <div class="security-note">Thumbnails and metadata are encrypted in SQLite. Filters run locally while the vault is unlocked.</div>
            </details>
        </aside>
        <section>
            <div class="quick-filters" role="group" aria-label="Quick filters">
                @foreach (var chip in QuickFilters)
                {
                    var active = chip.IsActive(filter);
                    <button type="button" class="quick-chip @(active ? "active" : "")" aria-pressed="@(active ? "true" : "false")" disabled="@busy" @onclick="() => ToggleQuickFilterAsync(chip)">
                        @chip.Label <span class="chip-count">@chip.Count(images)</span>
                    </button>
                }
            </div>
            <ActiveFilters Filter="filter" Changed="FilterChangedAsync" Reset="ResetFilters" Disabled="busy" />
            <div class="results-bar"><span><strong>@Filtered.Count</strong> images <span class="muted">/ @images.Count in vault</span></span>
                <div class="results-controls">
                    <div class="density-control" role="group" aria-label="Thumbnail size">
                        @foreach (var option in UiPreferences.Densities)
                        {
                            <button type="button" class="@(density == option ? "active" : "")" aria-pressed="@(density == option ? "true" : "false")" disabled="@busy" @onclick="() => SetDensityAsync(option)">@(char.ToUpperInvariant(option[0]) + option[1..])</button>
                        }
                    </div>
                    <select aria-label="Sort images" @bind="filter.Sort" @bind:after="FilterChangedAsync">
                        <option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="name">Name A-Z</option><option value="size">Largest first</option><option value="rating">Highest rated</option>
                    </select>
                </div>
            </div>
            <div class="actions">
                @if (workflow != "remove")
                {
                    <button disabled="@busy" @onclick="SelectLibraryPage">Select page</button>
                }
                @if (workflow == "remove")
                {
                    <button disabled="@busy" @onclick="SelectFilteredMarked">Select filtered marked images</button>
                    <button disabled="@(busy || removalSelection.Count == 0)" @onclick="PrepareBulkRemovalAsync">Remove selected (@removalSelection.Count)</button>
                }
                @if (librarySelection.Count > 0 || removalSelection.Count > 0)
                {
                    <button disabled="@busy" @onclick="ClearSelection">Clear selection (@(librarySelection.Count + removalSelection.Count))</button>
                }
            </div>
            @if (workflow != "remove" && librarySelection.Count > 0)
            {
                <div class="bulk-bar" role="region" aria-label="Bulk actions for selected images">
                    <strong>@librarySelection.Count selected</strong>
                    <div class="bulk-group" role="group" aria-label="Rate selected images">
                        @for (var score = 1; score <= 5; score++)
                        {
                            var value = score;
                            <button type="button" class="bulk-star" disabled="@busy" title="@($"Rate selected {value} stars")" aria-label="@($"Rate selected {value} out of 5 stars")" @onclick="() => BulkRateAsync(value)">@value&#9733;</button>
                        }
                        <button type="button" disabled="@busy" @onclick="() => BulkRateAsync(0)">Clear rating</button>
                    </div>
                    <div class="bulk-group">
                        <button type="button" disabled="@busy" @onclick="() => BulkFavoriteAsync(true)">&#9733; Favorite</button>
                        <button type="button" disabled="@busy" @onclick="() => BulkFavoriteAsync(false)">Unfavorite</button>
                        <button type="button" disabled="@busy" @onclick="() => BulkReviewedAsync(true)">Mark reviewed</button>
                        <button type="button" class="danger" disabled="@busy" @onclick="() => BulkMarkAsync(true)">Mark for deletion</button>
                        <button type="button" disabled="@busy" @onclick="() => BulkMarkAsync(false)">Unmark</button>
                        <button type="button" disabled="@busy" title="Compare the selected images against the whole library and review matches in full screen" @onclick="FindSelectedDuplicatesAsync">Find duplicates</button>
                    </div>
                    <form class="bulk-group" @onsubmit="BulkTagAsync" @onsubmit:preventDefault>
                        <input aria-label="Tags to add to selected images" placeholder="Add tags, comma-separated" @bind="bulkTags" @bind:event="oninput" list="tags" disabled="@busy" />
