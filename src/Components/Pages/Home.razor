                                        }
                                    </div>
                                    <span class="muted">@(image.Reviewed ? "Reviewed" : "Pending")</span>
                                </div>
                                @if (image.Collections.Count > 0) { <div class="collection-chips">@foreach (var name in image.Collections) { <span>@name</span> }</div> }
                            </div>
                            <div class="card-actions">
                                <button disabled="@busy" class="@(image.Favorite ? "selected" : "")" @onclick="() => FavoriteAsync(image)" aria-label="Toggle favorite">@(image.Favorite ? "\u2605" : "\u2606") Favorite</button>
                                <button disabled="@busy" class="@(image.MarkedForDeletion ? "danger selected" : "")" @onclick="() => MarkAsync(image)">@(image.MarkedForDeletion ? "Unmark" : "Mark deletion")</button>
                            </div>
                            @if (workflow == "remove" && image.MarkedForDeletion)
                            {
                                <label class="check"><input type="checkbox" checked="@removalSelection.Contains(image.Id)" disabled="@busy" @onchange="args => ToggleRemovalSelection(image.Id, args.Value is true)" /> Select for removal</label>
                            }
                        </article>
                    }
                </div>
                <div class="pagination">
                    <button disabled="@(page == 0 || busy)" @onclick="PreviousAsync">&larr; Previous</button>
                    <span>Page @(page + 1) of @PageCount</span>
                    <button disabled="@(page + 1 >= PageCount || busy)" @onclick="NextAsync">Next &rarr;</button>
                </div>
            }
        </section>
    </div>
