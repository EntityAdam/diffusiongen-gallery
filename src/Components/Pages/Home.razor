    </div>
    </div>

    @if (selected is not null)
    {
        <div class="modal-backdrop">
            <section class="detail-modal panel" role="dialog" aria-modal="true" aria-labelledby="detail-title" tabindex="-1">
                <div class="panel-header"><h2 id="detail-title">@selected.Name</h2><button class="icon-button" disabled="@busy" @onclick="CloseDetail" aria-label="Close image details">&times;</button></div>
                <div class="detail-columns">
                    <div class="preview"><img src="@preview" alt="@selected.Name" draggable="false" /></div>
                    <div class="detail-content">
                        <div class="eyebrow">ENCRYPTED ORIGINAL</div>
                        <p>@selected.Width &times; @selected.Height &middot; @((selected.OriginalBytes / 1024d / 1024d).ToString("F2")) MiB</p>
                        <p class="muted">Imported @selected.ImportedAt.ToLocalTime().ToString("g")<br />Original: @selected.OriginalName</p>
                        <div class="actions">
                            <button disabled="@busy" @onclick="() => OpenViewer(selected.Id)">Full screen view</button>
                            <button disabled="@busy" @onclick="() => FavoriteAsync(selected)">@(selected.Favorite ? "Remove favorite" : "Favorite")</button>
                            <button disabled="@busy" @onclick="() => MarkAsync(selected)">@(selected.MarkedForDeletion ? "Unmark deletion" : "Mark for deletion")</button>
