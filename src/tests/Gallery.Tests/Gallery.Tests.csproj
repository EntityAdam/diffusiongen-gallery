<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <Using Include="Xunit" />
    <ProjectReference Include="../../Gallery.Web/Gallery.Web.csproj" />
    <ProjectReference Include="../Gallery.TestSupport/Gallery.TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Gallery.ProcessMediator/Gallery.ProcessMediator.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyProcessMediator" AfterTargets="Build">
    <ItemGroup>
      <ProcessMediatorFiles Include="..\Gallery.ProcessMediator\$(BaseOutputPath)$(Configuration)\net10.0\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ProcessMediatorFiles)" DestinationFolder="$(OutDir)ProcessMediator" />
  </Target>
</Project>
