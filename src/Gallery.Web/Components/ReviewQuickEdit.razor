<aside class="bulk-bar quick-edit" aria-label="Guided Review Quick Edit">
    <h3>Quick Edit</h3>
    <div class="quick-edit-row">
        <strong>@SelectedCount Selected</strong>
        <Button Variant="ButtonVariant.Ghost" Disabled="@Busy" OnClick="Clear">Clear Selection <kbd>ESC</kbd></Button>
    </div>
    <div class="quick-edit-row" role="group" aria-label="Rate selected images">
        @for (var score = 1; score <= 5; score++)
        {
            var value = score;
            <Button Variant="ButtonVariant.Outline" Disabled="@Busy" OnClick="() => Rate.InvokeAsync(value)" aria-label="@($"Rate selected {value} out of 5 stars")">@value</Button>
        }
        <Button Variant="ButtonVariant.Outline" Disabled="@Busy" OnClick="() => Rate.InvokeAsync(0)">Clear Rating</Button>
    </div>
    <div class="quick-edit-pair">
        <Button Variant="ButtonVariant.Outline" Disabled="@Busy" OnClick="() => Reviewed.InvokeAsync(true)">Reviewed</Button>
        <Button Variant="ButtonVariant.Outline" Disabled="@Busy" OnClick="() => Reviewed.InvokeAsync(false)">Not Reviewed</Button>
    </div>
</aside>

@code {
    [Parameter] public int SelectedCount { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback Clear { get; set; }
    [Parameter] public EventCallback<int> Rate { get; set; }
    [Parameter] public EventCallback<bool> Reviewed { get; set; }
}
