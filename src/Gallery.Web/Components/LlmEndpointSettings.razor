@inject GalleryService Gallery
@inject ILogger<LlmEndpointSettings> Logger
@inject ISonnerService Toasts

<Card Class="llm-settings mb-6">
    <header class="llm-header">
        <div><h3>Local AI</h3><p class="text-muted-foreground">Connect a model, choose how it analyzes images, and tailor its instructions.</p></div>
        <Badge Variant="BadgeVariant.Secondary">OpenAI-compatible</Badge>
    </header>
    <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <section class="llm-section" aria-labelledby="llm-connection-title">
            <h4 id="llm-connection-title">Connection</h4>
            <div class="llm-grid">
                <div class="llm-field"><Label For="endpoint-url">Endpoint URL</Label>
                    <Input id="endpoint-url" Type="url" @bind-Value="draft.Endpoint" @bind-Value:after="EndpointChanged" Placeholder="http://127.0.0.1:1234/v1/" Disabled="@working" required /></div>
                <div class="llm-field"><Label For="api-key">API key <span class="text-muted-foreground">(optional)</span></Label>
                    <Input id="api-key" Type="password" autocomplete="new-password" @bind-Value="draft.ApiKey" Disabled="@working" Placeholder="Leave blank if not required" /></div>
                <div class="llm-field llm-full"><Label For="model-select">Model</Label>
                    <div class="llm-model-row">
                        @if (models.Count > 0)
                        {
                            <Select id="model-select" @bind-Value="draft.Model" Disabled="@working" required>
                                <option value="">Choose a model</option>
                                @foreach (var model in models) { <option value="@model">@model</option> }
                            </Select>
                        }
                        else { <Input id="model-select" @bind-Value="draft.Model" Disabled="@working" Placeholder="Enter a model ID or fetch available models" required /> }
                        <Button Variant="ButtonVariant.Outline" Type="button" Disabled="@working" OnClick="FetchModelsAsync">@(working ? "Working..." : "Fetch models")</Button>
                    </div>
                    <p class="llm-help">Use a vision-capable model. Discovery lists models but does not verify vision support.</p>
                </div>
            </div>
            <details class="llm-details">
                <summary>Connection requirements &amp; privacy</summary>
                <p class="llm-help">Use LM Studio, Ollama or another OpenAI-compatible server. Include /v1 when required. Only literal loopback or private LAN IP addresses are allowed; public addresses and hostnames are blocked.</p>
                <p class="llm-help">LAN requests send decrypted previews and metadata to your server. Use a trusted server and HTTPS when supported. Settings and the optional API key are encrypted in your gallery. Fetch models tests the entered connection without saving it.</p>
            </details>
        </section>

        <section class="llm-section" aria-labelledby="llm-analysis-title">
            <div class="llm-section-heading"><h4 id="llm-analysis-title">Image analysis</h4><Badge Variant="BadgeVariant.Secondary">@(draft.IsStructured ? "Structured" : "Description & tags")</Badge></div>
            <div class="llm-mode">
                <Checkbox id="structured-analysis-enabled" Disabled="@working" Checked="@draft.IsStructured" CheckedChanged="ToggleStructuredAnalysis" />
                <div><Label For="structured-analysis-enabled">Experimental scene analysis</Label>
                    <p class="llm-help">Describe subjects, their details, and relationships using the TypeScript template. Switching modes selects its saved prompt automatically.</p></div>
            </div>
            <div class="llm-tag-options">
                <div class="llm-check"><Checkbox id="vision-existing-tags" Disabled="@working" @bind-Checked="draft.UseExistingTags" /><Label For="vision-existing-tags">Choose from existing tags</Label></div>
                <div class="llm-check"><Checkbox id="vision-new-tags" Disabled="@working" @bind-Checked="draft.SuggestNewTags" /><Label For="vision-new-tags">Suggest new tags</Label></div>
            </div>
            <p class="llm-help">These controls are independent. With both off, analysis describes the image without assigning tags.</p>
        </section>

        <section class="llm-section" aria-labelledby="llm-prompts-title">
            <div class="llm-section-heading"><h4 id="llm-prompts-title">Prompts</h4><span class="llm-help">Edit one task at a time</span></div>
            <div class="llm-field">
                <Label For="prompt-task">Task</Label>
                <Select id="prompt-task" @bind-Value="selectedPrompt" Disabled="@working">
                    <option value="vision">Image analysis — @(draft.IsStructured ? "experimental" : "standard")</option>
                    <option value="tags">Tag reuse instructions</option>
                    <option value="collection-analysis">Collection-aware analysis instructions</option>
                    <option value="collection">Collection suggestions</option>
                    <option value="set">Set destination suggestions</option>
                    <option value="search">Search interpretation</option>
                </Select>
            </div>
            <div class="llm-prompt-heading"><Label For="@PromptId">@PromptLabel</Label>
                <Button id="restore-selected-prompt" Variant="ButtonVariant.Ghost" Type="button" Disabled="@working" OnClick="RestoreSelectedPrompt">Restore default prompt</Button></div>
            <textarea @key="selectedPrompt" id="@PromptId" rows="12" @bind="SelectedPromptText" @bind:event="oninput" disabled="@working" class="llm-prompt-editor" required="@(selectedPrompt is not ("tags" or "collection-analysis"))" aria-describedby="selected-prompt-help" spellcheck="false"></textarea>
            <p id="selected-prompt-help" class="llm-help">@PromptHelp</p>
            <details class="llm-details">
                <summary>Effective system prompt for collection-aware analysis</summary>
                <pre class="llm-prompt-preview">@draft.ToSettings().BuildImageAnalysisSystemPrompt(KnownTags.Any(), true)</pre>
            </details>
        </section>

        <details class="llm-section llm-generation">
            <summary>Advanced generation settings</summary>
            <p class="llm-help">Token budgets include reasoning on servers that count thinking tokens. Server context limits still apply.</p>
            <fieldset class="llm-grid" disabled="@working">
                <legend class="sr-only">Model generation settings</legend>
                <div class="llm-field"><Label For="request-timeout">Request timeout (seconds)</Label>
                    <input id="request-timeout" type="number" min="@VisionSettings.MinRequestTimeoutSeconds" max="@VisionSettings.MaxRequestTimeoutSeconds" @bind="draft.RequestTimeoutSeconds" required class="@GenerationInputClass" /></div>
                <div class="llm-field"><Label For="structured-analysis-max-tokens">Structured vision token limit</Label>
                    <input id="structured-analysis-max-tokens" type="number" min="1" max="@int.MaxValue" step="1" @bind="draft.StructuredAnalysisMaxTokens" required class="@GenerationInputClass" /></div>
                <div class="llm-field"><Label For="analysis-max-tokens">Standard vision token limit</Label>
                    <input id="analysis-max-tokens" type="number" min="1" max="@int.MaxValue" step="1" @bind="draft.AnalysisMaxTokens" required class="@GenerationInputClass" /></div>
                <div class="llm-field"><Label For="collection-analysis-max-tokens">Collection-aware vision token limit</Label>
                    <input id="collection-analysis-max-tokens" type="number" min="1" max="@int.MaxValue" step="1" @bind="draft.CollectionAnalysisMaxTokens" required class="@GenerationInputClass" /></div>
                <div class="llm-field"><Label For="analysis-temperature">Vision temperature</Label>
                    <input id="analysis-temperature" type="number" min="0" max="2" step="any" @bind="draft.AnalysisTemperature" required class="@GenerationInputClass" /></div>
                <div class="llm-field"><Label For="text-max-tokens">Text response token limit</Label>
                    <input id="text-max-tokens" type="number" min="1" max="@int.MaxValue" step="1" @bind="draft.TextMaxTokens" required class="@GenerationInputClass" /></div>
                <div class="llm-field"><Label For="text-temperature">Text temperature</Label>
                    <input id="text-temperature" type="number" min="0" max="2" step="any" @bind="draft.TextTemperature" required class="@GenerationInputClass" /></div>
            </fieldset>
            <Button Variant="ButtonVariant.Outline" Type="button" Disabled="@working" OnClick="RestoreDefaultGenerationSettings">Restore default generation settings</Button>
        </details>

        <footer class="llm-save-bar">
            <p class="llm-help" role="status">@(HasUnsavedChanges ? "Unsaved changes" : "All changes saved")</p>
            <div class="llm-actions">
                <Button Variant="ButtonVariant.Outline" Type="button" Disabled="@(working || !HasUnsavedChanges)" OnClick="DiscardDraft">Discard changes</Button>
                <Button Type="submit" Disabled="@(working || !HasUnsavedChanges)">Save LLM settings</Button>
            </div>
        </footer>
    </form>
</Card>

@code {
    private const string GenerationInputClass = "h-10 w-full min-w-0 rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-50";
    [Parameter, EditorRequired] public VisionSettings SavedSettings { get; set; } = new();
    [Parameter] public IEnumerable<string> KnownTags { get; set; } = [];
    [Parameter] public EventCallback<VisionSettings> Saved { get; set; }
    private VisionSettingsDraft draft = new();
    private VisionSettings? observedSettings;
    private VisionSettings? baseline;
    private string selectedPrompt = "vision";
    public bool HasUnsavedChanges => draft.ToSettings() != baseline;
    protected override void OnParametersSet()
    {
        if (Equals(observedSettings, SavedSettings)) return;
        draft = VisionSettingsDraft.From(SavedSettings);
        observedSettings = SavedSettings;
        baseline = draft.ToSettings();
    }
    private IReadOnlyList<string> models = [];
    private string message = "", error = "";
    private bool working;
    public bool IsBusy => working;
    public string ErrorMessage => error;
    public void DiscardDraft()
    {
        draft = VisionSettingsDraft.From(SavedSettings);
        baseline = draft.ToSettings();
    }
    public async Task<bool> SaveDraftAsync()
    {
        if (working) return false;
        await SaveAsync();
        return error.Length == 0 && !HasUnsavedChanges;
    }

    private void ToggleStructuredAnalysis(bool enabled)
    {
        draft.SwitchFormat(enabled);
        selectedPrompt = "vision";
    }

    private string PromptId => selectedPrompt switch
    {
        "tags" => "tag-vocabulary-instructions", "collection-analysis" => "collection-analysis-instructions",
        "collection" => "collection-suggestion-prompt", "set" => "set-suggestion-prompt",
        "search" => "search-system-prompt", _ => "vision-system-prompt"
    };
    private string PromptLabel => selectedPrompt switch
    {
        "tags" => "Tag vocabulary instructions", "collection-analysis" => "Collection analysis instructions",
        "collection" => "Collection suggestion system prompt", "set" => "Set destination system prompt",
        "search" => "Search interpretation system prompt", _ => "Vision system prompt"
    };
    private string PromptHelp => selectedPrompt switch
    {
        "tags" => "Appended when existing-tag reuse is enabled and the catalog is nonempty. Includes unused registered tags. Leave blank to append nothing.",
        "collection-analysis" => "Appended to image analysis when a collection suggestion is requested. Expects collection in the JSON response. Leave blank to append nothing.",
        "collection" => "Text-only collection suggestions. Return JSON with a nonempty collection name of up to 80 characters.",
        "set" => "Selects an existing set in the chosen collection. Return JSON with setId, or an empty string if none fit. Suggestions never move media automatically.",
        "search" => "Translates natural-language search into JSON: search, tag, collection, minRating, favoritesOnly, orientation and review.",
        _ => draft.IsStructured ? "Return JSON with a scene object and entities array; relationships are optional. The TypeScript comments guide detailed observations. Each mode remembers its own custom prompt."
            : "Return JSON with description (a string) and tags (an array of strings). Each mode remembers its own custom prompt."
    };
    private string SelectedPromptText
    {
        get => selectedPrompt switch
        {
            "tags" => draft.TagVocabularyInstructions, "collection-analysis" => draft.CollectionAnalysisInstructions,
            "collection" => draft.CollectionSuggestionSystemPrompt, "set" => draft.SetSuggestionSystemPrompt,
            "search" => draft.SearchSystemPrompt, _ => draft.SystemPrompt
        };
        set
        {
            switch (selectedPrompt)
            {
                case "tags": draft.TagVocabularyInstructions = value; break;
                case "collection-analysis": draft.CollectionAnalysisInstructions = value; break;
                case "collection": draft.CollectionSuggestionSystemPrompt = value; break;
                case "set": draft.SetSuggestionSystemPrompt = value; break;
                case "search": draft.SearchSystemPrompt = value; break;
                default: draft.SystemPrompt = value; break;
            }
        }
    }
    private void RestoreSelectedPrompt() => SelectedPromptText = selectedPrompt switch
    {
        "tags" => VisionSettings.DefaultTagVocabularyInstructions,
        "collection-analysis" => VisionSettings.DefaultCollectionAnalysisInstructions,
        "collection" => VisionSettings.DefaultCollectionSuggestionSystemPrompt,
        "set" => VisionSettings.DefaultSetSuggestionSystemPrompt,
        "search" => VisionSettings.DefaultSearchSystemPrompt,
        _ => draft.IsStructured ? global::Gallery.Core.Services.Processors.StructuredVision.DefaultSystemPrompt : VisionSettings.DefaultSystemPrompt
    };
    private void RestoreDefaultGenerationSettings()
    {
        var defaults = new VisionSettings();
        draft.AnalysisMaxTokens = defaults.AnalysisMaxTokens;
        draft.StructuredAnalysisMaxTokens = defaults.StructuredAnalysisMaxTokens;
        draft.CollectionAnalysisMaxTokens = defaults.CollectionAnalysisMaxTokens;
        draft.TextMaxTokens = defaults.TextMaxTokens;
        draft.AnalysisTemperature = defaults.AnalysisTemperature;
        draft.TextTemperature = defaults.TextTemperature;
    }

    private void EndpointChanged() { models = []; message = error = ""; }
    private Task FetchModelsAsync() => RunAsync(async () =>
    {
        models = [];
        models = await Gallery.GetVisionModelsAsync(draft.ToSettings());
        if (models.Count == 0) message = "The endpoint is reachable, but it returned no models. Load a model or enter its ID manually.";
        else
        {
            if (!models.Contains(draft.Model, StringComparer.Ordinal)) draft.Model = models[0];
            message = $"Connected: {models.Count} model(s) found. Choose a model and save settings.";
        }
    });

    private Task SaveAsync() => RunAsync(async () =>
    {
        var settings = draft.ToSettings();
        await Gallery.SaveSettingsAsync(settings);
        observedSettings = settings;
        baseline = settings;
        await Saved.InvokeAsync(settings);
        message = "LLM settings saved encrypted in this gallery.";
    });

    private async Task RunAsync(Func<Task> action)
    {
        if (working) return;
        working = true; message = error = "";
        try { await action(); }
        catch (Exception exception)
        {
            Logger.LogError(exception, "LLM endpoint settings operation failed");
            error = exception is InvalidOperationException or HttpRequestException or System.Text.Json.JsonException
                ? exception.Message : "Could not update LLM settings. Check the application console.";
        }
        finally
        {
            working = false;
            if (error.Length > 0) Toasts.Show("Could not update LLM settings", error, SonnerToastVariant.Destructive, 8000);
            if (message.Length > 0) Toasts.Show(message, "", SonnerToastVariant.Default, 4000);
        }
    }

    private sealed class VisionSettingsDraft
    {
        public string Endpoint { get; set; } = "";
        public string Model { get; set; } = "";
        public string ApiKey { get; set; } = "";
        public string OutputFormat { get; set; } = "legacy";
        public bool IsStructured => OutputFormat == "structured";
        public string LegacyPrompt { get; set; } = VisionSettings.DefaultSystemPrompt;
        public string StructuredPrompt { get; set; } = global::Gallery.Core.Services.Processors.StructuredVision.DefaultSystemPrompt;
        public void SwitchFormat(bool enabled)
        {
            if (enabled == IsStructured) return;
            if (IsStructured) StructuredPrompt = SystemPrompt;
            else LegacyPrompt = SystemPrompt;
            OutputFormat = enabled ? "structured" : "legacy";
            SystemPrompt = enabled ? StructuredPrompt : LegacyPrompt;
        }
        public bool UseExistingTags { get; set; } = true;
        public bool SuggestNewTags { get; set; } = true;
        public string SystemPrompt { get; set; } = VisionSettings.DefaultSystemPrompt;
        public string TagVocabularyInstructions { get; set; } = VisionSettings.DefaultTagVocabularyInstructions;
        public string CollectionAnalysisInstructions { get; set; } = VisionSettings.DefaultCollectionAnalysisInstructions;
        public string CollectionSuggestionSystemPrompt { get; set; } = VisionSettings.DefaultCollectionSuggestionSystemPrompt;
        public string SetSuggestionSystemPrompt { get; set; } = VisionSettings.DefaultSetSuggestionSystemPrompt;
        public string SearchSystemPrompt { get; set; } = VisionSettings.DefaultSearchSystemPrompt;
        public int RequestTimeoutSeconds { get; set; }
        public int StructuredAnalysisMaxTokens { get; set; }
        public int AnalysisMaxTokens { get; set; }
        public int CollectionAnalysisMaxTokens { get; set; }
        public int TextMaxTokens { get; set; }
        public double AnalysisTemperature { get; set; }
        public double TextTemperature { get; set; }

        public static VisionSettingsDraft From(VisionSettings settings) => new()
        {
            Endpoint = settings.Endpoint,
            Model = settings.Model,
            ApiKey = settings.ApiKey,
            OutputFormat = settings.StructuredAnalysis ? "structured" : "legacy",
            UseExistingTags = settings.UseExistingTags, SuggestNewTags = settings.SuggestNewTags,
            SystemPrompt = settings.SystemPrompt,
            LegacyPrompt = settings.LegacySystemPrompt ?? (settings.StructuredAnalysis ? VisionSettings.DefaultSystemPrompt : settings.SystemPrompt),
            StructuredPrompt = settings.StructuredSystemPrompt ?? (settings.StructuredAnalysis ? settings.SystemPrompt : global::Gallery.Core.Services.Processors.StructuredVision.DefaultSystemPrompt),
            TagVocabularyInstructions = settings.TagVocabularyInstructions,
            CollectionAnalysisInstructions = settings.CollectionAnalysisInstructions,
            CollectionSuggestionSystemPrompt = settings.CollectionSuggestionSystemPrompt,
            SetSuggestionSystemPrompt = settings.SetSuggestionSystemPrompt,
            SearchSystemPrompt = settings.SearchSystemPrompt,
            RequestTimeoutSeconds = settings.RequestTimeoutSeconds,
            StructuredAnalysisMaxTokens = settings.StructuredAnalysisMaxTokens,
            AnalysisMaxTokens = settings.AnalysisMaxTokens,
            CollectionAnalysisMaxTokens = settings.CollectionAnalysisMaxTokens,
            TextMaxTokens = settings.TextMaxTokens,
            AnalysisTemperature = settings.AnalysisTemperature,
            TextTemperature = settings.TextTemperature
        };

        public VisionSettings ToSettings() => new()
        {
            Endpoint = Endpoint,
            Model = Model,
            ApiKey = ApiKey,
            StructuredAnalysis = OutputFormat == "structured",
            UseExistingTags = UseExistingTags, SuggestNewTags = SuggestNewTags,
            SystemPrompt = SystemPrompt,
            LegacySystemPrompt = IsStructured ? LegacyPrompt : SystemPrompt,
            StructuredSystemPrompt = IsStructured ? SystemPrompt : StructuredPrompt,
            TagVocabularyInstructions = TagVocabularyInstructions,
            CollectionAnalysisInstructions = CollectionAnalysisInstructions,
            CollectionSuggestionSystemPrompt = CollectionSuggestionSystemPrompt,
            SetSuggestionSystemPrompt = SetSuggestionSystemPrompt,
            SearchSystemPrompt = SearchSystemPrompt,
            RequestTimeoutSeconds = RequestTimeoutSeconds,
            StructuredAnalysisMaxTokens = StructuredAnalysisMaxTokens,
            AnalysisMaxTokens = AnalysisMaxTokens,
            CollectionAnalysisMaxTokens = CollectionAnalysisMaxTokens,
            TextMaxTokens = TextMaxTokens,
            AnalysisTemperature = AnalysisTemperature,
            TextTemperature = TextTemperature
        };
    }
}
