@inject GalleryService Gallery
@inject ILogger<LlmEndpointSettings> Logger

<Card Class="mb-6 p-5 md:p-6 space-y-4">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3"><h3>Connect your local LLM</h3><Badge Variant="BadgeVariant.Secondary" Class="border-primary/20 bg-primary/10 text-primary">OPENAI-COMPATIBLE</Badge></div>
    <p class="text-muted-foreground">Configure LM Studio, Ollama or another local server. Include /v1 when required. Use a literal loopback or private LAN IP: 10.x.x.x, 172.16.x.x through 172.31.x.x, or 192.168.x.x. Public addresses and hostnames are blocked.</p>
    <p class="text-muted-foreground">LAN analysis sends decrypted previews and metadata to that server. Only connect to servers you trust; HTTP is not encrypted in transit. Use HTTPS when supported.</p>
    <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <Label For="endpoint-url" Class="mt-4 mb-2 block">Endpoint URL</Label>
        <Input id="endpoint-url" Type="url" @bind-Value="draft.Endpoint" @bind-Value:after="EndpointChanged" Placeholder="http://127.0.0.1:1234/v1/" Disabled="@working" required />
        <Label For="api-key" Class="mt-4 mb-2 block">API key (optional)</Label>
        <Input id="api-key" Type="password" autocomplete="new-password" @bind-Value="draft.ApiKey" Disabled="@working" Placeholder="Leave blank for unauthenticated local endpoints" />
        <Label For="request-timeout" Class="mt-4 mb-2 block">Request timeout (seconds)</Label>
        <input id="request-timeout" type="number" min="@VisionSettings.MinRequestTimeoutSeconds" max="@VisionSettings.MaxRequestTimeoutSeconds" @bind="draft.RequestTimeoutSeconds" disabled="@working" required  class="h-10 w-full min-w-0 rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-50"/>
        <Label For="model-select" Class="mt-4 mb-2 block">Model</Label>
        @if (models.Count > 0)
        {
            <Select id="model-select" @bind-Value="draft.Model" Disabled="@working" required>
                <option value="">Choose a model</option>
                @foreach (var model in models) { <option value="@model">@model</option> }
            </Select>
        }
        else
        {
            <Input id="model-select" @bind-Value="draft.Model" Disabled="@working" Placeholder="Fetch models or enter a model ID" required />
        }
        <p class="text-muted-foreground">Choose a vision-capable model for image analysis. Model discovery does not verify vision support. Text search interpretation uses this model too.</p>
        <Label For="vision-system-prompt" Class="mt-4 mb-2 block">Vision system prompt</Label>
        <textarea id="vision-system-prompt" rows="8" @bind="draft.SystemPrompt" @bind:event="oninput" disabled="@working" class="prompt-editor" required aria-describedby="vision-system-prompt-help"></textarea>
        <p id="vision-system-prompt-help" class="text-muted-foreground">Used by image analysis in the detail view and toolbox. Responses must be JSON with description (a string) and tags (an array of strings). Toolbox collection suggestions and full organization analysis also append the collection instructions below. Tag suggestions use this prompt plus the tag vocabulary instructions below.</p>
        <Button Variant="ButtonVariant.Outline" Type="button" Disabled="@working" OnClick="RestoreDefaultPrompt">Restore default prompt</Button>
        <Label For="tag-vocabulary-instructions" Class="mt-4 mb-2 block">Tag vocabulary instructions</Label>
        <textarea id="tag-vocabulary-instructions" rows="5" @bind="draft.TagVocabularyInstructions" @bind:event="oninput" disabled="@working" class="prompt-editor"></textarea>
        <p class="text-muted-foreground">Image analysis receives the entire registered tag vocabulary, including unused tags. These instructions are appended when the catalog is nonempty. The toolbox keeps new tags as suggestions until approved.</p>
        <Button Variant="ButtonVariant.Outline" Type="button" Disabled="@working" OnClick="() => draft.TagVocabularyInstructions = VisionSettings.DefaultTagVocabularyInstructions">Restore default tag vocabulary instructions</Button>
        <Label For="collection-analysis-instructions" Class="mt-4 mb-2 block">Collection analysis instructions</Label>
        <textarea id="collection-analysis-instructions" rows="5" @bind="draft.CollectionAnalysisInstructions" @bind:event="oninput" disabled="@working" class="prompt-editor" aria-describedby="collection-analysis-instructions-help"></textarea>
        <p id="collection-analysis-instructions-help" class="text-muted-foreground">Appended to the vision system prompt for toolbox collection suggestions and full organization analysis. Leave empty to append nothing. Collection suggestions expect a collection string of 1–80 characters in the JSON response.</p>
        <Button Variant="ButtonVariant.Outline" Type="button" Disabled="@working" OnClick="RestoreDefaultCollectionInstructions">Restore default collection instructions</Button>
        <details>
            <summary>Effective system prompt for collection-aware analysis</summary>
            <pre>@draft.ToSettings().BuildImageAnalysisSystemPrompt(KnownTags.Any(), true)</pre>
        </details>
        <Label For="collection-suggestion-prompt" Class="mt-4 mb-2 block">Collection suggestion system prompt</Label>
        <textarea id="collection-suggestion-prompt" rows="5" @bind="draft.CollectionSuggestionSystemPrompt" @bind:event="oninput" disabled="@working" class="prompt-editor" required aria-describedby="collection-suggestion-prompt-help"></textarea>
        <p id="collection-suggestion-prompt-help" class="text-muted-foreground">Used by the text-only collection suggestion request. Expects JSON with a collection string of 1–80 characters.</p>
        <Button Variant="ButtonVariant.Outline" Type="button" Disabled="@working" OnClick="RestoreDefaultCollectionPrompt">Restore default collection suggestion prompt</Button>
        <Label For="set-suggestion-prompt" Class="mt-4 mb-2 block">Set destination suggestion system prompt</Label>
        <textarea id="set-suggestion-prompt" rows="5" @bind="draft.SetSuggestionSystemPrompt" @bind:event="oninput" disabled="@working" class="prompt-editor" required></textarea>
        <p class="text-muted-foreground">Used by the shared move dialog. Chooses an existing set in the selected collection; returns JSON with setId. Suggestions never move media automatically.</p>
        <Button Variant="ButtonVariant.Ghost" Disabled="@working" OnClick="() => draft.SetSuggestionSystemPrompt = VisionSettings.DefaultSetSuggestionSystemPrompt">Restore default set prompt</Button>
        <Label For="search-system-prompt" Class="mt-4 mb-2 block">Search interpretation system prompt</Label>
        <textarea id="search-system-prompt" rows="8" @bind="draft.SearchSystemPrompt" @bind:event="oninput" disabled="@working" class="prompt-editor" required aria-describedby="search-system-prompt-help"></textarea>
        <p id="search-system-prompt-help" class="text-muted-foreground">Used by natural-language search. Expects JSON with search, tag, collection, minRating, favoritesOnly, orientation and review.</p>
        <Button Variant="ButtonVariant.Outline" Type="button" Disabled="@working" OnClick="RestoreDefaultSearchPrompt">Restore default search prompt</Button>
        <div class="flex flex-wrap items-center gap-2">
            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="button" Disabled="@working" OnClick="FetchModelsAsync">@(working ? "Working..." : "Fetch models")</Button>
            <Button Variant="ButtonVariant.Default" Size="ButtonSize.Default" Type="submit" Disabled="@working">Save LLM settings</Button>
        </div>
    </form>
    @if (message.Length > 0) { <p class="my-4 flex items-center justify-between gap-3 rounded-lg border border-primary/25 bg-primary/5 p-4 text-sm break-words" role="status">@message</p> }
    @if (error.Length > 0) { <Alert Variant="AlertVariant.Destructive">@error</Alert> }
    <div class="mt-6 space-y-2 border-t border-border pt-4 text-xs leading-relaxed text-muted-foreground [&>strong]:block [&>strong]:text-foreground">Settings, including the optional API key, are encrypted in your gallery. Fetch models tests the entered endpoint without saving it. Save to apply changes to subsequent requests.</div>
</Card>

@code {
    [Parameter, EditorRequired] public VisionSettings SavedSettings { get; set; } = new();
    [Parameter] public IEnumerable<string> KnownTags { get; set; } = [];
    [Parameter] public EventCallback<VisionSettings> Saved { get; set; }
    private VisionSettingsDraft draft = new();
    private VisionSettings? observedSettings;
    protected override void OnParametersSet()
    {
        if (Equals(observedSettings, SavedSettings)) return;
        draft = VisionSettingsDraft.From(SavedSettings);
        observedSettings = SavedSettings;
    }
    private IReadOnlyList<string> models = [];
    private string message = "", error = "";
    private bool working;

    private void RestoreDefaultPrompt() => draft.SystemPrompt = VisionSettings.DefaultSystemPrompt;
    private void RestoreDefaultCollectionInstructions() => draft.CollectionAnalysisInstructions = VisionSettings.DefaultCollectionAnalysisInstructions;
    private void RestoreDefaultCollectionPrompt() => draft.CollectionSuggestionSystemPrompt = VisionSettings.DefaultCollectionSuggestionSystemPrompt;
    private void RestoreDefaultSearchPrompt() => draft.SearchSystemPrompt = VisionSettings.DefaultSearchSystemPrompt;

    private void EndpointChanged() { models = []; message = error = ""; }
    private Task FetchModelsAsync() => RunAsync(async () =>
    {
        models = [];
        models = await Gallery.GetVisionModelsAsync(draft.ToSettings());
        if (models.Count == 0) message = "The endpoint is reachable, but it returned no models. Load a model or enter its ID manually.";
        else
        {
            if (!models.Contains(draft.Model, StringComparer.Ordinal)) draft.Model = models[0];
            message = $"Connected: {models.Count} model(s) found. Choose a model and save settings.";
        }
    });

    private Task SaveAsync() => RunAsync(async () =>
    {
        var settings = draft.ToSettings();
        await Gallery.SaveSettingsAsync(settings);
        await Saved.InvokeAsync(settings);
        message = "LLM settings saved encrypted in this gallery.";
    });

    private async Task RunAsync(Func<Task> action)
    {
        if (working) return;
        working = true; message = error = "";
        try { await action(); }
        catch (Exception exception)
        {
            Logger.LogError(exception, "LLM endpoint settings operation failed");
            error = exception is InvalidOperationException or HttpRequestException or System.Text.Json.JsonException
                ? exception.Message : "Could not update LLM settings. Check the application console.";
        }
        finally { working = false; }
    }

    private sealed class VisionSettingsDraft
    {
        public string Endpoint { get; set; } = "";
        public string Model { get; set; } = "";
        public string ApiKey { get; set; } = "";
        public string SystemPrompt { get; set; } = VisionSettings.DefaultSystemPrompt;
        public string TagVocabularyInstructions { get; set; } = VisionSettings.DefaultTagVocabularyInstructions;
        public string CollectionAnalysisInstructions { get; set; } = VisionSettings.DefaultCollectionAnalysisInstructions;
        public string CollectionSuggestionSystemPrompt { get; set; } = VisionSettings.DefaultCollectionSuggestionSystemPrompt;
        public string SetSuggestionSystemPrompt { get; set; } = VisionSettings.DefaultSetSuggestionSystemPrompt;
        public string SearchSystemPrompt { get; set; } = VisionSettings.DefaultSearchSystemPrompt;
        public int RequestTimeoutSeconds { get; set; }

        public static VisionSettingsDraft From(VisionSettings settings) => new()
        {
            Endpoint = settings.Endpoint,
            Model = settings.Model,
            ApiKey = settings.ApiKey,
            SystemPrompt = settings.SystemPrompt,
            TagVocabularyInstructions = settings.TagVocabularyInstructions,
            CollectionAnalysisInstructions = settings.CollectionAnalysisInstructions,
            CollectionSuggestionSystemPrompt = settings.CollectionSuggestionSystemPrompt,
            SetSuggestionSystemPrompt = settings.SetSuggestionSystemPrompt,
            SearchSystemPrompt = settings.SearchSystemPrompt,
            RequestTimeoutSeconds = settings.RequestTimeoutSeconds
        };

        public VisionSettings ToSettings() => new()
        {
            Endpoint = Endpoint,
            Model = Model,
            ApiKey = ApiKey,
            SystemPrompt = SystemPrompt,
            TagVocabularyInstructions = TagVocabularyInstructions,
            CollectionAnalysisInstructions = CollectionAnalysisInstructions,
            CollectionSuggestionSystemPrompt = CollectionSuggestionSystemPrompt,
            SetSuggestionSystemPrompt = SetSuggestionSystemPrompt,
            SearchSystemPrompt = SearchSystemPrompt,
            RequestTimeoutSeconds = RequestTimeoutSeconds
        };
    }
}
