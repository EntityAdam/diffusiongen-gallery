@using Gallery.Web.Components.Features.Backups
@using Gallery.Web.Components.Features.Storage
@using Gallery.Web.Components.Features.Tags
@using Gallery.Web.Components.Features.Vaults
@using Gallery.Web.Components.Features.Vision
@implements IDisposable
@inject IGalleryBackup GalleryBackup
@inject IGalleryStorage GalleryStorage
@inject IGalleryVision GalleryVision

@if (Active)
{
    <Tabs Value="@Tab" ValueChanged="TabChanged" Class="mb-4">
        <TabsList Class="h-auto max-w-full flex-wrap justify-start gap-1" aria-label="Settings sections">
            @foreach (var tab in Tabs)
            {
                <TabsTrigger Value="@tab.Id" disabled="@Activity.Busy">@tab.Name</TabsTrigger>
            }
        </TabsList>
    </Tabs>
    @switch (Tab)
    {
        case "overview":
            <GalleryStorageOverview @bind-Overview="storageOverview" Busy="Activity.Busy" CatalogPartial="Catalog.IsPartial"
                                    HasScan="Duplicates.HasScan" Groups="Duplicates.Groups" FindDuplicates="FindDuplicates" />
            break;
        case "gallery":
            <GalleryManagement Busy="Activity.Busy" JobRunning="JobRunning" Locked="Locked" Purged="Purged" />
            break;
        case "endpoints":
            <LlmEndpointSettings @ref="llmEndpointSettings" KnownTags="Catalog.AllTags" SavedSettings="settings" Saved="value => settings = value" />
            break;
        case "tags":
            <TagCsvSettings Changed="Reload" />
            break;
        case "backups":
            <BackupWorkspace Draft="backup" Busy="Activity.Busy" />
            break;
        case "security":
            <SecuritySettings AutoLockMinutes="Preferences.AutoLockMinutes" Busy="Activity.Busy" UpdateTimer="UpdateTimerAsync" Panic="Panic" />
            break;
    }
}
