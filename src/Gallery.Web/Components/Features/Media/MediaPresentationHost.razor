@using Gallery.Web.Components.Workspace
@using Gallery.Web.Components.Features.Curation
@using Gallery.Web.Components.Features.Media.Removal
@using Gallery.Web.Components.Features.Vision
@using Gallery.Web.Components.Features.Browsing
@implements IDisposable

@if (State.CanPresent && State.Selected is { } selected)
{
    <MediaDetailDialog @key="selected.Id" @ref="detailDialog" Image="selected" Preview="@State.Preview" VideoUrl="@State.VideoUrl"
                       Busy="Activity.Busy" CatalogPartial="Catalog.IsPartial" Progress="@Activity.Progress" Error="@Activity.Error"
                       Close="CloseDetail" Fullscreen="() => OpenViewerAsync(selected.Id)" Rate="value => Curation.ToggleRatingAsync(selected, value)"
                       Favorite="() => Curation.ToggleFavoriteAsync(selected)" Mark="() => Curation.ToggleMarkAsync(selected)" Analyze="() => AnalyzeAsync(selected)"
                       ShowPrompt="() => Navigation!.ShowPromptAsync(selected.Prompt)" Remove="() => Removal.PrepareAsync([selected.Id])"
                       Suggestion="@Suggestions.GetValueOrDefault(selected.Id)" Approve="Analysis.ApproveAsync" Dismiss="Analysis.DismissAsync"
                       Changed="Catalog.UpdateAsync" DraftChanged="Changed" />
}
@if (State.CanPresent && State.ViewerImages.Count > 0)
{
    <FullscreenViewer KnownTags="Catalog.AllTags" Images="State.ViewerImages" InitialId="@State.ViewerInitialId" InitialPreview="@State.ViewerInitialPreview"
                      ReviewMode="State.ReviewMode" OrderedGallery="State.OrderedGalleryViewer" OnClose="CloseViewerAsync"
                      OnImageChanged="Catalog.UpdateAsync" OnImagesChanged="UpdateImagesAsync"
                      Suggestions="Suggestions" ApproveSuggestion="Analysis.ApproveAsync" DismissSuggestion="Analysis.DismissAsync" />
}

@code {
    [CascadingParameter] public WorkspaceCommands Commands { get; set; } = default!;
    [Parameter, EditorRequired] public MediaPresentationState State { get; set; } = default!;
    [Parameter, EditorRequired] public WorkspaceCatalog Catalog { get; set; } = default!;
    [Parameter, EditorRequired] public GalleryActivity Activity { get; set; } = default!;
    [Parameter] public IReadOnlyDictionary<string, OrganizationSuggestion> Suggestions { get; set; } = new Dictionary<string, OrganizationSuggestion>();
    [CascadingParameter] public WorkspaceNavigationState? Navigation { get; set; }
    [Parameter, EditorRequired] public MediaCurationCommands Curation { get; set; } = default!;
    [Parameter, EditorRequired] public LibraryAnalysis Analysis { get; set; } = default!;
    [Parameter, EditorRequired] public RemovalWorkflowState Removal { get; set; } = default!;
    [Parameter, EditorRequired] public GalleryBrowserState Browser { get; set; } = default!;
    [Parameter] public EventCallback Changed { get; set; }
    private MediaDetailDialog? detailDialog;

    protected override void OnInitialized() => Navigation?.AddDraftSource(GetDraft);
    public void Dispose() => Navigation?.RemoveDraftSource(GetDraft);

    private UnsavedChangesSource? GetDraft() =>
        State.Selected is { } selected && detailDialog?.Image.Id == selected.Id ? detailDialog.Draft : null;

    private Task AnalyzeAsync(ImageRecord image) =>
        Commands.RunLibraryChangeAsync("Analyzing with your local vision model...", async () =>
        {
            await Analysis.AnalyzeDetailAsync(image);
            if (Catalog.CanRead)
                Activity.Message = "Review available suggestions in the AI analysis drawer. Unfinished analysis can be resumed there.";
        });

    private async Task OpenViewerAsync(string id)
    {
        if (Browser.InfiniteScroll && Navigation?.Section == "gallery") State.OpenOrderedViewer(Browser.Filtered, id);
        else State.OpenViewer(Browser.PageImages, id);
        await Changed.InvokeAsync();
    }

    private async Task CloseDetail() { State.CloseDetail(); await Changed.InvokeAsync(); }
    private Task UpdateImagesAsync(IReadOnlyList<ImageRecord> records) => Catalog.UpdateAsync(records, reloadThumbnails: false);

    private Task CloseViewerAsync((string Id, int Index) position)
    {
        var restore = State.OrderedGalleryViewer;
        State.CloseViewer();
        return Commands.RunAsync("Refreshing gallery...", async () =>
        {
            await Catalog.ReloadAsync();
            if (restore) Browser.RestoreViewerPosition(position);
        });
    }
}
