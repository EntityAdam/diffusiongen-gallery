@using Microsoft.AspNetCore.Components.Sections
@using Gallery.Web.Components.Features.Curation
@using Gallery.Web.Components.Features.Media
@using Gallery.Web.Components.Features.Media.Removal
@using Gallery.Web.Components.Features.Tags
@inject IConfiguration Configuration

<SectionContent SectionName="gallery-browser">
    @if (Active)
    {
        <div class="gallery-layout grid min-w-0 grid-cols-1"
             data-has-selection="@((State.LibrarySelection.Count > 0 || State.RemovalSelection.Count > 0) ? "true" : "false")"
             data-can-edit-tags="@(CanEditTags ? "true" : "false")">
            @if (Configuration.GetValue<bool>("Gallery:BrowsingDiagnostics"))
            {
                <GalleryBrowsingCapture InfiniteScroll="State.InfiniteScroll" />
            }
            <section aria-label="@(State.TrashActive ? "Trash" : "Gallery")">
                @if (Catalog.IsPartial)
                {
                    <CatalogLoadStatus Catalog="Catalog" InfiniteScroll="State.InfiniteScroll" />
                }
                @if (State.TrashActive && !OverlayOpen)
                {
                    <div class="mb-6 max-w-xl">
                        <TrashTool Busy="Activity.Busy" SelectedCount="State.RemovalSelection.Count" Results="Removal.Results"
                                   ClearSelection="State.ClearSelection" Delete="DeleteAsync" Restore="RestoreAsync" />
                    </div>
                }
                <GalleryResults @ref="results" State="State" CatalogPartial="Catalog.IsPartial" OverlayOpen="OverlayOpen"
                                ShowPrompt="Navigation.ShowPromptAsync" ChildContent="RenderCard" />
            </section>
        </div>
    }
</SectionContent>

@if (taggingImages is not null)
{
    <TaggingDialog Images="taggingImages" Options="Catalog.AllTags" Busy="Activity.Busy" Error="@tagError"
                   Save="SaveDialogTagsAsync" Cancel="CloseTagging" />
}

<LibraryWorkbench KnownTags="Catalog.AllTags" Analysis="Analysis" Visible="@(!Catalog.IsPartial && State.ActiveTool is "organize" or "intelligence")"
                  Workflow="@State.ActiveTool" Images="Catalog.Images" SelectedIds="State.LibrarySelection" Busy="Activity.Busy"
                  SaveTags="SaveTagsAsync" TagError="@tagError" Changed="Catalog.ReloadAsync" ClearSelection="State.ClearSelection" />

<GalleryToolPanel State="State" Catalog="Catalog" Visible="@(Active && !OverlayOpen)"
                  Fullscreen="() => OpenViewerAsync(null)" StartReview="StartReviewAsync" Refreshed="Refreshed" />

@code {
    private RenderFragment<ImageRecord> RenderCard => image =>
        @<GalleryImageCard @key="image.Id" Image="image" Thumbnail="@State.Thumbnails.Get(image.Id)" ThumbnailFailed="@State.Thumbnails.Failed(image.Id)"
                           Busy="Activity.Busy" Selected="@((State.TrashActive ? State.RemovalSelection : State.LibrarySelection).Contains(image.Id))"
                           Select="args => State.SelectCard(image.Id, args.ShiftKey)" Open="() => Presentation.OpenAsync(image)"
                           Rate="value => Curation.ToggleRatingAsync(image, value)" Favorite="() => Curation.ToggleFavoriteAsync(image)"
                           Mark="() => Curation.ToggleMarkAsync(image)"
                           HasSuggestion="@State.Suggestions.ContainsKey(image.Id)" ReviewSuggestion="() => OpenViewerAsync(image.Id)" />;
}
