<div class="image-grid density-@Density">
    @{ PromptGroup? previousGroup = null; DiffusionModelGroup? previousModelGroup = null; var firstOnPage = true; }
    @foreach (var image in Images)
    {
        if (Grouping == "prompt" && PromptGroups.TryGetValue(image.Id, out var group) && !ReferenceEquals(group, previousGroup))
        {
            var continued = firstOnPage && group.Images[0].Id != image.Id;
            previousGroup = group;
            <GalleryGroupHeader @key="group" Prompt="group" Continued="continued" Busy="Busy" ShowPrompt="ShowPrompt" />
        }
        else if (Grouping == "model" && ModelGroups.TryGetValue(image.Id, out var modelGroup) && !ReferenceEquals(modelGroup, previousModelGroup))
        {
            var continued = firstOnPage && modelGroup.Images[0].Id != image.Id;
            previousModelGroup = modelGroup;
            <GalleryGroupHeader @key="modelGroup" Model="modelGroup" Continued="continued" />
        }
        firstOnPage = false;
        @ChildContent(image)
    }
</div>

@code {
    [Parameter, EditorRequired] public IEnumerable<ImageRecord> Images { get; set; } = [];
    [Parameter, EditorRequired] public RenderFragment<ImageRecord> ChildContent { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, PromptGroup> PromptGroups { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, DiffusionModelGroup> ModelGroups { get; set; } = default!;
    [Parameter] public string Grouping { get; set; } = "none";
    [Parameter] public string Density { get; set; } = "";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<string> ShowPrompt { get; set; }
}
