@using Gallery.Core.Features.Settings
@using Gallery.Core.Features.Vaults
@using Gallery.Web.Components.Workspace
@inject IGallerySettings GallerySettings
@inject IGalleryVault GalleryVault

<aside id="@GalleryToolbox.FilterDrawerId" class="gallery-filter-drawer" aria-labelledby="gallery-filter-drawer-title">
    <div class="gallery-filter-drawer-header">
        <h2 id="gallery-filter-drawer-title" class="sr-only">Filters</h2>
        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Disabled="Busy" OnClick='() => Close.InvokeAsync()' aria-label="Close filters"><XIcon aria-hidden="true" /></Button>
        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" OnClick="Reset" Disabled="@(Busy || CatalogPartial)">Reset filters</Button>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="BeginSaveQuickFilter" Disabled="@(Busy || CatalogPartial || GalleryFilterPanel.CountChanged(Filter) == 0)"><BookmarkPlusIcon Size="16" aria-hidden="true" />Save quick filter</Button>
    </div>
    @if (CatalogPartial)
    {
        <p class="p-4 text-muted-foreground" role="status">Filters will be available when the full library finishes loading.</p>
    }
    else
    {
        <GalleryFilterPanel KnownTags="KnownTags" Filter="Filter" Images="Images" ResultCount="ResultCount" Changed="Changed" QuickFilters="QuickFilters" Disabled="Busy" ResetVersion="ResetVersion" />
    }
</aside>
@if (quickFilterSnapshot is not null)
{
    <ModalDialog LabelledBy="save-quick-filter-title" Busy="@Busy" Close="CloseQuickFilterDialog">
        <Card Class="mx-auto w-full max-w-lg p-5">
            <h2 id="save-quick-filter-title">Save quick filter</h2>
            <form @onsubmit="SaveQuickFilterAsync" @onsubmit:preventDefault>
                <Label For="quick-filter-name" Class="mb-2 block">Name</Label>
                <Input id="quick-filter-name" @bind-Value="quickFilterName" Placeholder="My favorite portraits" maxlength="80" required autofocus Disabled="@Busy" />
                @if (ReplacesQuickFilter) { <p class="mt-3 text-sm text-muted-foreground">This replaces the existing quick filter with the same name.</p> }
                <div class="mt-4 flex justify-end gap-2">
                    <Button Variant="ButtonVariant.Outline" Type="button" Disabled="@Busy" OnClick="CloseQuickFilterDialog">Cancel</Button>
                    <Button Type="submit" Disabled="@(Busy || string.IsNullOrWhiteSpace(quickFilterName))">@(ReplacesQuickFilter ? "Replace quick filter" : "Save quick filter")</Button>
                </div>
            </form>
        </Card>
    </ModalDialog>
}


@code {
    [Parameter, EditorRequired] public GalleryFilter Filter { get; set; } = default!;
    [Parameter] public IEnumerable<string> KnownTags { get; set; } = [];
    [Parameter] public IReadOnlyList<ImageRecord> Images { get; set; } = [];
    [Parameter] public int ResultCount { get; set; }
    [Parameter] public IReadOnlyList<SavedView> QuickFilters { get; set; } = [];
    [Parameter] public long ResetVersion { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool CatalogPartial { get; set; }
    [Parameter] public EventCallback Close { get; set; }
    [Parameter] public EventCallback Reset { get; set; }
    [Parameter] public EventCallback<GalleryFilter> Changed { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<SavedView>> Saved { get; set; }
    [CascadingParameter] public WorkspaceCommands Commands { get; set; } = default!;
    private GalleryFilter? quickFilterSnapshot;
    private string quickFilterName = "";
    private bool ReplacesQuickFilter => QuickFilters.Any(view => view.Name.Equals(quickFilterName.Trim(), StringComparison.OrdinalIgnoreCase));

    private void BeginSaveQuickFilter()
    {
        if (Busy || CatalogPartial || GalleryFilterPanel.CountChanged(Filter) == 0) return;
        quickFilterName = "";
        quickFilterSnapshot = Filter with { };
    }

    private void CloseQuickFilterDialog()
    {
        quickFilterSnapshot = null;
        quickFilterName = "";
    }

    private Task SaveQuickFilterAsync()
    {
        if (Busy || quickFilterSnapshot is null || string.IsNullOrWhiteSpace(quickFilterName)) return Task.CompletedTask;
        var snapshot = quickFilterSnapshot;
        var name = quickFilterName.Trim();
        return Commands.RunAsync("Saving quick filter...", async () =>
        {
            await GallerySettings.SaveViewAsync(name, snapshot);
            var saved = await GallerySettings.LoadViewsAsync();
            if (!GalleryVault.IsUnlocked) return;
            await Saved.InvokeAsync(saved.OrderBy(view => view.Name, StringComparer.OrdinalIgnoreCase).ToArray());
            CloseQuickFilterDialog();
            Commands.Activity.Message = "Quick filter saved.";
        });
    }
}
