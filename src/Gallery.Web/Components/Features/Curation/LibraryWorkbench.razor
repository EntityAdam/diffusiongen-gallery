@using Gallery.Web.Components.Workspace
@using Gallery.Core.Features.Settings
@using Gallery.Web.Components.Features.Collections
@using Gallery.Web.Components.Features.Tags
@using Gallery.Web.Components.Features.Vision
@inject IGalleryCollections GalleryCollections
@inject IGalleryMedia GalleryMedia
@inject IGalleryRecordEditor GalleryRecords
@inject IGallerySettings GallerySettings
@inject OrganizationHistory OrganizationHistory
@inject ISonnerService Toasts
@inject ILogger<LibraryWorkbench> Logger
@implements IDisposable

<Microsoft.AspNetCore.Components.Sections.SectionContent SectionName="gallery-workbench">
<div class="toolbox-workbench space-y-4" hidden="@(!Visible)">
    @if (Workflow == "organize")
    {
        <p class="text-muted-foreground">Organize your media into collections and use tags to filter.</p>
        <Separator />
        <section class="space-y-2" aria-labelledby="selected-tags-heading">
            <h4 id="selected-tags-heading">Tags</h4>
            @if (SelectedTags.Count == 0)
            {
                <p class="text-muted-foreground text-sm">@(SelectedIds.Count == 0 ? "Select media to see their tags." : "The selected media have no tags.")</p>
            }
            else
            {
                <ul class="tag-chips" aria-label="Tags on selected media">
                    @foreach (var (tag, count) in SelectedTags)
                    {
                        <li class="tag-chip" title="@($"On {count} of {SelectedIds.Count} selected")">
                            <span>@tag</span>
                            @if (count < SelectedIds.Count) { <span class="tag-chip-count">@count</span> }
                            <button type="button" aria-label="@($"Remove tag {tag} from selected media")" disabled="@IsBusy" @onclick="() => RemoveTagAsync(tag)">
                                <XIcon Size="12" aria-hidden="true" />
                            </button>
                        </li>
                    }
                </ul>
            }
        </section>
        <Separator />
        <div class="flex flex-wrap items-center gap-3">
            <strong>@SelectedIds.Count selected</strong>
            <Button Variant="ButtonVariant.Ghost" Disabled="@(IsBusy || SelectedIds.Count == 0)" OnClick="ClearSelection">Clear selection <kbd>ESC</kbd></Button>
        </div>
        <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-2 [&>div]:min-w-0 [&>div]:space-y-3">
            <div>
                <h4>Collections</h4>
                <p class="text-muted-foreground">Move selected media to one set within a collection.</p>
                <Button Variant="ButtonVariant.Outline" Disabled="@(IsBusy || SelectedIds.Count == 0)" OnClick="() => showDestination = true">Move to set</Button>
                <Button Variant="ButtonVariant.Ghost" Disabled="@(IsBusy || SelectedIds.Count == 0)" OnClick="RemoveFromSetAsync">Remove from set</Button>
            </div>
            <div>
                <h4>Tags</h4>
                <Label For="bulk-tags" Class="mt-4 mb-2 block">Add tags</Label>
                <AdvancedSelect Id="bulk-tags" Label="Tags" ItemLabel="tag" Placeholder="Select tags…" Multiple="true" MaxLength="4000"
                                Options="@Tags" Counts="@TagCounts" Values="@TagValues" ValuesChanged="SetTagValues" Disabled="@IsBusy" />
                <div class="flex flex-wrap items-center gap-2">
                    <Button Variant="ButtonVariant.Outline" Disabled="@(IsBusy || SelectedIds.Count == 0 || string.IsNullOrWhiteSpace(tags))" OnClick="ApplyTagsAsync">Apply</Button>
                    <Button Variant="ButtonVariant.Outline" Disabled="@IsBusy" OnClick='() => tags = ""'>Clear</Button>
                    <Button Variant="ButtonVariant.Outline" Disabled="@(IsBusy || SelectedIds.Count is 0 or > 24)" OnClick="() => AnalyzeSelectionAsync(tagsOnly: true)">Suggest (AI Vision)</Button>
                </div>
                @foreach (var suggestion in Analysis.TagSuggestions)
                {
                    <div class="rounded-lg border border-border p-3">
                        <strong>@suggestion.Name</strong><p>@suggestion.Tags</p>
                        <Button Variant="ButtonVariant.Outline" Disabled="@(IsBusy || string.IsNullOrWhiteSpace(suggestion.Tags))" OnClick="() => Analysis.ApplyTagSuggestionAsync(suggestion)">Apply</Button>
                        <Button Variant="ButtonVariant.Ghost" Disabled="@IsBusy" OnClick="() => Analysis.DismissTagSuggestionAsync(suggestion)">Dismiss</Button>
                    </div>
                }
            </div>
        </div>
        @if (Analysis.IsAnalyzing)
        {
            <Button Variant="ButtonVariant.Outline" Disabled="@(!Analysis.Status.CanStop)" OnClick="Analysis.StopAnalysis">Stop after active requests</Button>
        }
    }
    @if (Workflow == "intelligence")
    {
        <p class="text-muted-foreground text-sm">Describe and tag media with your configured vision endpoints. Review pending suggestions individually or accept or discard them together.</p>
        <div class="flex flex-wrap items-center gap-2">
            @if (Analysis.IsAnalyzing)
            {
                <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Icon" Disabled="@(!Analysis.Status.CanStop)" OnClick="Analysis.StopAnalysis"
                        aria-label="Stop after active requests" title="Stop after active requests"><SquareIcon Size="16" aria-hidden="true" /></Button>
            }
            else
            {
                <Button Variant="ButtonVariant.Default" Size="ButtonSize.Icon" Disabled="@(IsBusy || UnanalyzedCount == 0)" OnClick="Analysis.AnalyzeUnanalyzedAsync"
                        aria-label="Start analyzing unanalyzed media" title="Start analyzing unanalyzed media"><PlayIcon Size="16" aria-hidden="true" /></Button>
            }
            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Disabled="@(IsBusy || SelectedIds.Count is 0 or > 24)" OnClick="() => AnalyzeSelectionAsync(tagsOnly: false)"
                    title="Analyze up to 24 selected media items">Analyze selected (@SelectedIds.Count)</Button>
        </div>
        <p class="text-muted-foreground text-sm">@UnanalyzedCount unanalyzed · @Analysis.Suggestions.Count awaiting approval</p>
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Pending analysis suggestions">
            <Button Size="ButtonSize.Sm" Disabled="@(IsBusy || Analysis.Suggestions.Count == 0)" OnClick="Analysis.AcceptAllVisionAsync">Accept all (@Analysis.Suggestions.Count)</Button>
            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Disabled="@(IsBusy || Analysis.Suggestions.Count == 0)" OnClick="Analysis.DiscardAllVisionAsync">Discard all (@Analysis.Suggestions.Count)</Button>
        </div>
    }
    @if (!IsBusy && Analysis.PendingAnalysisCount > 0)
    {
        <div class="flex flex-wrap items-center gap-2" role="status">
            <p>@Analysis.PendingAnalysisCount unfinished selected media item(s). Completed suggestions are saved.</p>
            <Button Variant="ButtonVariant.Outline" OnClick="() => Analysis.ResumeAnalysisAsync(Workflow)">Resume selected media</Button>
            <Button Variant="ButtonVariant.Ghost" OnClick="Analysis.DiscardQueueAsync">Discard selected queue</Button>
        </div>
    }
    @if (IsBusy) { <p class="flex items-center justify-between gap-3 rounded-lg border border-primary/25 bg-primary/5 p-3 text-sm break-words" role="status">@(editing ? status : Analysis.Progress)</p> }

    @if (compareImages.Count == 2)
    {
        <div class="fixed inset-0 z-40 overflow-y-auto bg-black/90 p-3 md:p-7">
            <Card Class="mb-6 p-5 md:p-6" role="dialog" aria-modal="true" aria-label="Compare media">
                <div class="mb-4 flex flex-wrap items-center justify-between gap-3"><h2>Choose what deserves to stay.</h2><Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@IsBusy" OnClick="CloseComparison">Close comparison</Button></div>
                <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-2 [&>div]:min-w-0 [&>div]:space-y-3">
                    @foreach (var image in compareImages)
                    {
                        <article class="min-w-0 space-y-4 [&>img]:h-[55vh] [&>img]:w-full [&>img]:bg-black/40 [&>img]:object-contain"><h3>@image.Name</h3><img src="@comparison[image.Id]" alt="@image.Name" draggable="false" />
                            <p>@image.Width &times; @image.Height / Rating: @image.Rating / @(image.IsReviewed ? "Reviewed" : "Pending review")</p>
                            <div class="flex flex-wrap items-center gap-2">
                                @for (var score = 1; score <= 5; score++)
                                {
                                    var value = score;
                                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@IsBusy" OnClick="() => RateOneAsync(image, value)">@value / 5</Button>
                                }
                            </div>
                        </article>
                    }
                </div>
                @if (error.Length > 0) { <Alert Variant="AlertVariant.Destructive">@error</Alert> }
            </Card>
        </div>
    }
</div>

</Microsoft.AspNetCore.Components.Sections.SectionContent>

@code {
    [Parameter] public string Workflow { get; set; } = "organize";
    [Parameter] public bool Visible { get; set; } = true;
    [Parameter] public IReadOnlyList<ImageRecord> Images { get; set; } = [];
    [Parameter] public IReadOnlyCollection<string> SelectedIds { get; set; } = [];
    [Parameter, EditorRequired] public GalleryFilter Filter { get; set; } = new();
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback ClearSelection { get; set; }
    [Parameter, EditorRequired] public LibraryAnalysis Analysis { get; set; } = default!;
    [Parameter] public IEnumerable<string> KnownTags { get; set; } = [];
    private bool showDestination;
    private async Task DestinationSavedAsync(CollectionMutation result) { OrganizationHistory.Record(result.Undo);showDestination = false;notice = "Media moved to set.";await Changed.InvokeAsync(); }
    private async Task DestinationCanceledAsync() { showDestination = false;await Changed.InvokeAsync(); }
    private Task RemoveFromSetAsync() => RunAsync("Removing from set...", async () => { var result = await GalleryCollections.MoveMediaToSetAsync(SelectedIds, null);OrganizationHistory.Record(result.Undo);notice = "Media moved to Unorganized.";await Changed.InvokeAsync(); });
    private string tags = "", viewName = "", error = "", notice = "", status = "";
    private int rating = -1;
    private string reviewStatus = "unchanged";
    private bool editing, disposed;
    private bool IsBusy => editing || Analysis.IsBusy;
    private List<SavedView> views = [];
    private List<ImageRecord> compareImages = [];
    private readonly Dictionary<string, string> comparison = [];
    private IEnumerable<string> Tags => KnownTags.Concat(Images.SelectMany(image => image.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)))
        .Distinct(StringComparer.OrdinalIgnoreCase).Order();
    private static string[] TagsOf(ImageRecord image) => image.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    private IReadOnlyList<(string Tag, int Count)> SelectedTags => Images.Where(image => SelectedIds.Contains(image.Id))
        .SelectMany(image => TagsOf(image).Distinct(StringComparer.OrdinalIgnoreCase))
        .GroupBy(tag => tag, StringComparer.OrdinalIgnoreCase)
        .Select(group => (group.First(), group.Count()))
        .OrderBy(item => item.Item1, StringComparer.OrdinalIgnoreCase).ToList();
    private IEnumerable<ImageRecord> UnanalyzedImages => Images.Where(Analysis.NeedsVisionAnalysis);
    private int UnanalyzedCount => UnanalyzedImages.Count();
    private IReadOnlyList<string> TagValues => tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    private void SetTagValues(IReadOnlyList<string> values) => tags = string.Join(", ", values);
    private IReadOnlyDictionary<string, int> TagCounts => Images.SelectMany(image => TagsOf(image).Distinct(StringComparer.OrdinalIgnoreCase))
        .GroupBy(value => value, StringComparer.OrdinalIgnoreCase).ToDictionary(group => group.Key, group => group.Count(), StringComparer.OrdinalIgnoreCase);
    protected override void OnParametersSet()
    {
        var imagesById = Images.ToDictionary(image => image.Id);
        for (var index = 0; index < compareImages.Count; index++)
            if (imagesById.TryGetValue(compareImages[index].Id, out var image)) compareImages[index] = image;
    }

    // Saved views are an unexposed feature: the UI is hidden, but views stay loaded and encrypted for a future surface.
    protected override Task OnInitializedAsync() =>
        RunAsync("Loading saved views...", async () => views = await GallerySettings.LoadViewsAsync());

    private async Task RunAsync(string message, Func<Task> action)
    {
        if (editing) return;
        editing = true;
        status = message;
        error = notice = "";
        try { await action(); }
        catch (Exception) when (disposed) { }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Library workbench operation failed");
            error = exception is InvalidSavedViewNameException or InvalidOperationException or IOException or System.Text.Json.JsonException
                ? exception.Message : "The operation failed. Check the application console.";
        }
        finally
        {
            if (!disposed && error.Length > 0) Toasts.Show("Something went wrong", error, SonnerToastVariant.Destructive, 8000);
            if (!disposed && notice.Length > 0) Toasts.Show(notice, "", SonnerToastVariant.Default, 4000);
            editing = false;
        }
    }

    private async Task ApplyBulkAsync(string[] ids, Func<ImageRecordEdit, ImageRecordEdit> change,
        string operation, Func<int, string> successMessage)
    {
        var failures = new List<string>();
        foreach (var id in ids)
        {
            try { await GalleryRecords.UpdateAsync(id, change); }
            catch (Exception exception)
            {
                Logger.LogError(exception, "{Operation} failed for {ImageId}", operation, id);
                failures.Add($"{id}: {exception.Message}");
            }
        }
        await Changed.InvokeAsync();
        notice = successMessage(ids.Length - failures.Count);
        error = string.Join(" / ", failures);
    }

    private Task RemoveTagAsync(string tag) => RunAsync($"Removing tag {tag}...", () =>
    {
        var ids = Images.Where(image => SelectedIds.Contains(image.Id) && TagsOf(image).Contains(tag, StringComparer.OrdinalIgnoreCase))
            .Select(image => image.Id).ToArray();
        return ApplyBulkAsync(ids, image => image with { Tags = GalleryRecords.RemoveTag(image.Tags, tag) },
            "Tag removal", count => $"Removed \"{tag}\" from {count} media item(s).");
    });

    private Task RateAsync() => RunAsync("Curating selection...", () => ApplyBulkAsync(SelectedIds.ToArray(),
        image => GalleryRecords.SetCuration(image, rating == -1 ? null : rating,
            reviewStatus == "unchanged" ? null : reviewStatus == "reviewed"),
        "Bulk organization", count => $"Updated {count} media item(s)."));

    private Task SaveViewAsync() => RunAsync("Saving view...", async () =>
    {
        await GallerySettings.SaveViewAsync(viewName, Filter);
        views = await GallerySettings.LoadViewsAsync();
        notice = "Saved view stored encrypted.";
    });

    private Task DeleteViewAsync(string name) => RunAsync("Deleting view...", async () =>
    {
        await GallerySettings.DeleteViewAsync(name);
        views = await GallerySettings.LoadViewsAsync();
    });

    private Task AnalyzeSelectionAsync(bool tagsOnly)
    {
        if (SelectedIds.Count is 0 or > 24)
            return RunAsync("Analyzing selection...", () => throw new InvalidOperationException("Select between 1 and 24 media items."));
        var selected = Images.Where(image => SelectedIds.Contains(image.Id)).ToArray();
        return Analysis.AnalyzeSelectionAsync(selected, tagsOnly, Workflow);
    }

    private Task ApplyTagsAsync() => RunAsync("Applying tags...", async () =>
    {
        if (string.IsNullOrWhiteSpace(tags) || tags.Length > 4000) throw new InvalidOperationException("Enter tags of up to 4000 characters.");
        await ApplyBulkAsync(SelectedIds.ToArray(), image => image with { Tags = GalleryRecords.MergeTags(image.Tags, tags) },
            "Bulk organization", count => $"Updated {count} media item(s).");
    });

    private Task CompareAsync() => RunAsync("Preparing comparison...", async () =>
    {
        comparison.Clear();
        var selected = Images.Where(image => SelectedIds.Contains(image.Id)).ToList();
        if (selected.Count != 2) throw new InvalidOperationException("Select exactly two media items.");
        foreach (var image in selected) comparison[image.Id] = await GalleryMedia.ViewerImageAsync(image.Id, ImageResolution.Fit);
        compareImages = selected;
    });

    private Task RateOneAsync(ImageRecord image, int value) => RunAsync("Saving rating...", async () =>
    {
        var updated = await GalleryRecords.UpdateAsync(image.Id, current => GalleryRecords.SetCuration(current, value, true));
        var comparisonIndex = compareImages.FindIndex(comparedImage => comparedImage.Id == image.Id);
        if (comparisonIndex >= 0) compareImages[comparisonIndex] = updated;
        await Changed.InvokeAsync();
    });

    private void CloseComparison() { compareImages.Clear(); comparison.Clear(); }
    public void Dispose()
    {
        disposed = true;
        CloseComparison();
    }
}

@if (showDestination) { <CollectionDestinationDialog Images="@Images.Where(image => SelectedIds.Contains(image.Id)).ToArray()" Saved="DestinationSavedAsync" Cancel="DestinationCanceledAsync" /> }
