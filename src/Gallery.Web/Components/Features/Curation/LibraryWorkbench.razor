@using Gallery.Web.Components.Workspace
@using Gallery.Web.Components.Features.Collections
@using Gallery.Web.Components.Features.Tags
@using Gallery.Web.Components.Features.Vision
@inject IGalleryCollections GalleryCollections
@inject OrganizationHistory OrganizationHistory
@inject ISonnerService Toasts
@inject ILogger<LibraryWorkbench> Logger
@implements IDisposable

<Microsoft.AspNetCore.Components.Sections.SectionContent SectionName="gallery-workbench">
<div class="library-workbench space-y-4" hidden="@(!Visible)">
    @if (Workflow == "organize")
    {
        <p class="text-muted-foreground">Organize your media into collections and use tags to filter.</p>
        <Separator />
        <section class="space-y-2" aria-labelledby="selected-tags-heading">
            <h4 id="selected-tags-heading">Tags</h4>
            <Tagging Images="@(Images.Where(image => SelectedIds.Contains(image.Id)).ToArray())" Options="KnownTags"
                     Busy="IsBusy" Error="@TagError" Save="SaveTags" />
        </section>
        <Separator />
        <div class="flex flex-wrap items-center gap-3">
            <Button Variant="ButtonVariant.Ghost" Disabled="@(IsBusy || SelectedIds.Count == 0)" OnClick="ClearSelection">Clear selection <kbd>ESC</kbd></Button>
        </div>
        <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-2 [&>div]:min-w-0 [&>div]:space-y-3">
            <div>
                <h4>Collections</h4>
                <p class="text-muted-foreground">Move selected media to one set within a collection.</p>
                <Button Variant="ButtonVariant.Outline" Disabled="@(IsBusy || SelectedIds.Count == 0)" OnClick="() => showDestination = true">Move to set</Button>
                <Button Variant="ButtonVariant.Ghost" Disabled="@(IsBusy || SelectedIds.Count == 0)" OnClick="RemoveFromSetAsync">Remove from set</Button>
            </div>
            <div>
                <h4>Tag suggestions</h4>
                <div class="flex flex-wrap items-center gap-2">
                    <Button Variant="ButtonVariant.Outline" Disabled="@(IsBusy || SelectedIds.Count is 0 or > 24)" OnClick="() => AnalyzeSelectionAsync(tagsOnly: true)">Suggest (AI Vision)</Button>
                </div>
                @foreach (var suggestion in Analysis.TagSuggestions)
                {
                    <div class="rounded-lg border border-border p-3">
                        <strong>@suggestion.Name</strong><p>@suggestion.Tags</p>
                        <Button Variant="ButtonVariant.Outline" Disabled="@(IsBusy || string.IsNullOrWhiteSpace(suggestion.Tags))" OnClick="() => Analysis.ApplyTagSuggestionAsync(suggestion)">Apply</Button>
                        <Button Variant="ButtonVariant.Ghost" Disabled="@IsBusy" OnClick="() => Analysis.DismissTagSuggestionAsync(suggestion)">Dismiss</Button>
                    </div>
                }
            </div>
        </div>
        @if (Analysis.IsAnalyzing)
        {
            <Button Variant="ButtonVariant.Outline" Disabled="@(!Analysis.Status.CanStop)" OnClick="Analysis.StopAnalysis">Stop after active requests</Button>
        }
    }
    @if (Workflow == "intelligence")
    {
        <p class="text-muted-foreground text-sm">Describe and tag media with your configured vision endpoints. Review pending suggestions individually or accept or discard them together.</p>
        <div class="flex flex-wrap items-center gap-2">
            @if (Analysis.IsAnalyzing)
            {
                <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Icon" Disabled="@(!Analysis.Status.CanStop)" OnClick="Analysis.StopAnalysis"
                        aria-label="Stop after active requests" title="Stop after active requests"><SquareIcon Size="16" aria-hidden="true" /></Button>
            }
            else
            {
                <Button Variant="ButtonVariant.Default" Size="ButtonSize.Icon" Disabled="@(IsBusy || UnanalyzedCount == 0)" OnClick="Analysis.AnalyzeUnanalyzedAsync"
                        aria-label="Start analyzing unanalyzed media" title="Start analyzing unanalyzed media"><PlayIcon Size="16" aria-hidden="true" /></Button>
            }
            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Disabled="@(IsBusy || SelectedIds.Count is 0 or > 24)" OnClick="() => AnalyzeSelectionAsync(tagsOnly: false)"
                    title="Analyze up to 24 selected media items">Analyze selected (@SelectedIds.Count)</Button>
        </div>
        <p class="text-muted-foreground text-sm">@UnanalyzedCount unanalyzed · @Analysis.Suggestions.Count awaiting approval</p>
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Pending analysis suggestions">
            <Button Size="ButtonSize.Sm" Disabled="@(IsBusy || Analysis.Suggestions.Count == 0)" OnClick="Analysis.AcceptAllVisionAsync">Accept all (@Analysis.Suggestions.Count)</Button>
            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Disabled="@(IsBusy || Analysis.Suggestions.Count == 0)" OnClick="Analysis.DiscardAllVisionAsync">Discard all (@Analysis.Suggestions.Count)</Button>
        </div>
    }
    @if (!IsBusy && Analysis.PendingAnalysisCount > 0)
    {
        <div class="flex flex-wrap items-center gap-2" role="status">
            <p>@Analysis.PendingAnalysisCount unfinished selected media item(s). Completed suggestions are saved.</p>
            <Button Variant="ButtonVariant.Outline" OnClick="() => Analysis.ResumeAnalysisAsync(Workflow)">Resume selected media</Button>
            <Button Variant="ButtonVariant.Ghost" OnClick="Analysis.DiscardQueueAsync">Discard selected queue</Button>
        </div>
    }
    @if (editing || Analysis.IsBusy) { <p class="flex items-center justify-between gap-3 rounded-lg border border-primary/25 bg-primary/5 p-3 text-sm break-words" role="status">@(editing ? status : Analysis.Progress)</p> }

</div>

</Microsoft.AspNetCore.Components.Sections.SectionContent>

@code {
    [Parameter] public string Workflow { get; set; } = "organize";
    [Parameter] public bool Visible { get; set; } = true;
    [Parameter] public IReadOnlyList<ImageRecord> Images { get; set; } = [];
    [Parameter] public IReadOnlyCollection<string> SelectedIds { get; set; } = [];
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback ClearSelection { get; set; }
    [Parameter, EditorRequired] public LibraryAnalysis Analysis { get; set; } = default!;
    [Parameter] public IEnumerable<string> KnownTags { get; set; } = [];
    [Parameter] public EventCallback<TagEdit> SaveTags { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string TagError { get; set; } = "";
    private bool showDestination;
    private async Task DestinationSavedAsync(CollectionMutation result) { OrganizationHistory.Record(result.Undo);showDestination = false;notice = "Media moved to set.";await Changed.InvokeAsync(); }
    private async Task DestinationCanceledAsync() { showDestination = false;await Changed.InvokeAsync(); }
    private Task RemoveFromSetAsync() => RunAsync("Removing from set...", async () => { var result = await GalleryCollections.MoveMediaToSetAsync(SelectedIds, null);OrganizationHistory.Record(result.Undo);notice = "Media moved to Unorganized.";await Changed.InvokeAsync(); });
    private string notice = "", status = "";
    private bool editing, disposed;
    private bool IsBusy => Busy || editing || Analysis.IsBusy;
    private IEnumerable<ImageRecord> UnanalyzedImages => Images.Where(Analysis.NeedsVisionAnalysis);
    private int UnanalyzedCount => UnanalyzedImages.Count();

    private async Task RunAsync(string message, Func<Task> action)
    {
        if (editing) return;
        editing = true;
        status = message;
        var error = "";
        notice = "";
        try { await action(); }
        catch (Exception) when (disposed) { }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Library workbench operation failed");
            error = exception is InvalidOperationException or IOException or System.Text.Json.JsonException
                ? exception.Message : "The operation failed. Check the application console.";
        }
        finally
        {
            if (!disposed && error.Length > 0) Toasts.Show("Something went wrong", error, SonnerToastVariant.Destructive, 8000);
            if (!disposed && notice.Length > 0) Toasts.Show(notice, "", SonnerToastVariant.Default, 4000);
            editing = false;
        }
    }

    private Task AnalyzeSelectionAsync(bool tagsOnly)
    {
        if (SelectedIds.Count is 0 or > 24)
            return RunAsync("Analyzing selection...", () => throw new InvalidOperationException("Select between 1 and 24 media items."));
        var selected = Images.Where(image => SelectedIds.Contains(image.Id)).ToArray();
        return Analysis.AnalyzeSelectionAsync(selected, tagsOnly, Workflow);
    }

    public void Dispose() => disposed = true;
}

@if (showDestination) { <CollectionDestinationDialog Images="@Images.Where(image => SelectedIds.Contains(image.Id)).ToArray()" Saved="DestinationSavedAsync" Cancel="DestinationCanceledAsync" /> }
