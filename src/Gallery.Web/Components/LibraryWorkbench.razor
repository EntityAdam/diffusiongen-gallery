@inject GalleryService Gallery
@inject ILogger<LibraryWorkbench> Logger
@implements IDisposable

<div class="toolbox-workbench space-y-4" hidden="@(!Visible)">
    @if (Workflow == "organize")
    {
        <p class="text-muted-foreground">Organize your media into collections and use tags to filter.</p>
        <div class="flex flex-wrap items-center gap-3">
            <strong>@SelectedIds.Count selected</strong>
            <Button Variant="ButtonVariant.Ghost" Disabled="@(working || SelectedIds.Count == 0)" OnClick="ClearSelection">Clear selection <kbd>ESC</kbd></Button>
        </div>
        <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-2 [&>div]:min-w-0 [&>div]:space-y-3">
            <div>
                <h4>Collections</h4>
                <Label For="bulk-collection" Class="mt-4 mb-2 block">Add to collection</Label>
                <Select id="bulk-collection" @bind-Value="CollectionChoice" Disabled="@working">
                    <option value="">Choose a collection</option>
                    @foreach (var name in Collections) { <option value="@("value:" + name)">@name</option> }
                    <option value="new">Create new collection...</option>
                </Select>
                @if (newCollection)
                {
                    <Label For="new-collection" Class="mb-2 block">New collection name</Label>
                    <Input id="new-collection" @bind-Value="collection" Disabled="@working" maxlength="80" Placeholder="Worlds, portraits, final picks..." />
                }
                <div class="flex flex-wrap items-center gap-2">
                    <Button Variant="ButtonVariant.Outline" Disabled="@(working || SelectedIds.Count == 0 || string.IsNullOrWhiteSpace(collection))" OnClick="ApplyCollectionAsync">Apply</Button>
                    <Button Variant="ButtonVariant.Outline" Disabled="@working" OnClick='() => CollectionChoice = ""'>Clear</Button>
                    <Button Variant="ButtonVariant.Outline" Disabled="@(working || SelectedIds.Count is 0 or > 24)" OnClick="() => AnalyzeSelectionAsync(collectionSuggestions)">Suggest (AI Vision)</Button>
                </div>
                @foreach (var suggestion in collectionSuggestions.ToArray())
                {
                    <div class="rounded-lg border border-border p-3">
                        <strong>@suggestion.Name</strong><p>@suggestion.Collection</p>
                        @if (suggestion.Warning.Length > 0) { <Alert Variant="AlertVariant.Destructive">@suggestion.Warning</Alert> }
                        <Button Variant="ButtonVariant.Outline" Disabled="@(working || string.IsNullOrWhiteSpace(suggestion.Collection))" OnClick="() => ApplyOrganizationSuggestionAsync(suggestion, true)">Apply</Button>
                        <Button Variant="ButtonVariant.Ghost" Disabled="@working" OnClick="() => collectionSuggestions.Remove(suggestion)">Dismiss</Button>
                    </div>
                }
            </div>
            <div>
                <h4>Tags</h4>
                <Label For="bulk-tags" Class="mt-4 mb-2 block">Add tags</Label>
                <Select id="bulk-tags" @bind-Value="TagChoice" Disabled="@working">
                    <option value="">Choose a tag</option>
                    @foreach (var tag in Tags) { <option value="@("value:" + tag)">@tag</option> }
                    <option value="new">Create new tags...</option>
                </Select>
                @if (newTags)
                {
                    <Label For="new-tags" Class="mb-2 block">New tags (comma-separated)</Label>
                    <Input id="new-tags" @bind-Value="tags" Disabled="@working" maxlength="4000" Placeholder="cinematic, warm light" />
                }
                <div class="flex flex-wrap items-center gap-2">
                    <Button Variant="ButtonVariant.Outline" Disabled="@(working || SelectedIds.Count == 0 || string.IsNullOrWhiteSpace(tags))" OnClick="ApplyTagsAsync">Apply</Button>
                    <Button Variant="ButtonVariant.Outline" Disabled="@working" OnClick='() => TagChoice = ""'>Clear</Button>
                    <Button Variant="ButtonVariant.Outline" Disabled="@(working || SelectedIds.Count is 0 or > 24)" OnClick="() => AnalyzeSelectionAsync(tagSuggestions)">Suggest (AI Vision)</Button>
                </div>
                @foreach (var suggestion in tagSuggestions.ToArray())
                {
                    <div class="rounded-lg border border-border p-3">
                        <strong>@suggestion.Name</strong><p>@suggestion.Tags</p>
                        <Button Variant="ButtonVariant.Outline" Disabled="@(working || string.IsNullOrWhiteSpace(suggestion.Tags))" OnClick="() => ApplyOrganizationSuggestionAsync(suggestion, false)">Apply</Button>
                        <Button Variant="ButtonVariant.Ghost" Disabled="@working" OnClick="() => tagSuggestions.Remove(suggestion)">Dismiss</Button>
                    </div>
                }
            </div>
        </div>
        @if (analyzing)
        {
            <Button Variant="ButtonVariant.Outline" Disabled="@cancelRequested" OnClick="StopAnalysisAsync">Stop after current image</Button>
        }
    }
    @if (Workflow == "search")
    {
        <div class="space-y-3">
            <Label For="smart-query" Class="mb-2 block">Describe what you want to find</Label>
            <Input id="smart-query" @bind-Value="query" maxlength="2000" Placeholder="Highly rated landscape favorites" />
            <Button Variant="ButtonVariant.Default" Size="ButtonSize.Sm" Disabled="@working" OnClick="InterpretAsync"><SearchIcon Size="16" aria-hidden="true" />Convert to filters</Button>
            <p class="text-muted-foreground text-sm">Your local LLM converts language to explicit filters, not embedding search. Review the interpretation before applying it.</p>
            @if (suggestedFilter is not null)
            {
                <div class="space-y-3 rounded-lg border border-primary/20 bg-primary/5 p-3 text-sm break-words">Search: @suggestedFilter.Search / Tag: @suggestedFilter.Tag / Collection: @suggestedFilter.Collection / Minimum rating: @suggestedFilter.MinRating / Favorites: @suggestedFilter.IncludesFavoritesOnly / Orientation: @suggestedFilter.Orientation / Review: @suggestedFilter.Review</div>
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Disabled="@working" OnClick="ApplySearchAsync">Apply suggested filters</Button>
            }
        </div>
    }
    @if (Workflow == "intelligence")
    {
        <p class="text-muted-foreground text-sm">Describe and tag images with your local vision model. Nothing is saved until you approve: cards with a suggestion show a <SparklesIcon Size="12" aria-hidden="true" /> badge, which opens the image in full screen for review.</p>
        <div class="flex flex-wrap items-center gap-2">
            @if (analyzing)
            {
                <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Icon" Disabled="@cancelRequested" OnClick="StopAnalysisAsync"
                        aria-label="Stop after the current image" title="Stop after the current image"><SquareIcon Size="16" aria-hidden="true" /></Button>
            }
            else
            {
                <Button Variant="ButtonVariant.Default" Size="ButtonSize.Icon" Disabled="@(working || UnanalyzedCount == 0)" OnClick="AnalyzeUnanalyzedAsync"
                        aria-label="Analyze all images without a description" title="Analyze all images without a description"><PlayIcon Size="16" aria-hidden="true" /></Button>
            }
            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Disabled="@(working || SelectedIds.Count is 0 or > 24)" OnClick="SuggestAsync"
                    title="Analyze up to 24 selected images">Analyze selected (@SelectedIds.Count)</Button>
        </div>
        <p class="text-muted-foreground text-sm">@UnanalyzedCount without a description · @suggestions.Count awaiting approval</p>
    }
    @if (working) { <p class="flex items-center justify-between gap-3 rounded-lg border border-primary/25 bg-primary/5 p-3 text-sm break-words" role="status">@status</p> }
    @if (notice.Length > 0) { <p class="flex items-center justify-between gap-3 rounded-lg border border-primary/25 bg-primary/5 p-3 text-sm break-words" role="status">@notice</p> }
    @if (error.Length > 0) { <Alert Variant="AlertVariant.Destructive">@error</Alert> }
    @if (compareImages.Count == 2)
    {
        <div class="fixed inset-0 z-40 overflow-y-auto bg-black/90 p-3 md:p-7">
            <Card Class="mb-6 p-5 md:p-6" role="dialog" aria-modal="true" aria-label="Compare images">
                <div class="mb-4 flex flex-wrap items-center justify-between gap-3"><h2>Choose what deserves to stay.</h2><Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@working" OnClick="CloseComparison">Close comparison</Button></div>
                <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-2 [&>div]:min-w-0 [&>div]:space-y-3">
                    @foreach (var image in compareImages)
                    {
                        <article class="min-w-0 space-y-4 [&>img]:h-[55vh] [&>img]:w-full [&>img]:bg-black/40 [&>img]:object-contain"><h3>@image.Name</h3><img src="@comparison[image.Id]" alt="@image.Name" draggable="false" />
                            <p>@image.Width &times; @image.Height / Rating: @image.Rating / @(image.IsReviewed ? "Reviewed" : "Pending review")</p>
                            <div class="flex flex-wrap items-center gap-2">
                                @for (var score = 1; score <= 5; score++)
                                {
                                    var value = score;
                                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@working" OnClick="() => RateOneAsync(image, value)">@value / 5</Button>
                                }
                            </div>
                        </article>
                    }
                </div>
                @if (error.Length > 0) { <Alert Variant="AlertVariant.Destructive">@error</Alert> }
            </Card>
        </div>
    }
</div>

@code {
    [Parameter] public string Workflow { get; set; } = "organize";
    [Parameter] public bool Visible { get; set; } = true;
    [Parameter] public IReadOnlyList<ImageRecord> Images { get; set; } = [];
    [Parameter] public IReadOnlyCollection<string> SelectedIds { get; set; } = [];
    [Parameter, EditorRequired] public GalleryFilter Filter { get; set; } = new();
    [Parameter] public EventCallback<GalleryFilter> FilterChanged { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback ClearSelection { get; set; }
    [Parameter] public EventCallback<LibraryJobStatus> JobChanged { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<OrganizationSuggestion>> SuggestionsChanged { get; set; }
    private string collection = "", tags = "", viewName = "", query = "", error = "", notice = "", status = "";
    private int rating = -1;
    private string reviewStatus = "unchanged", jobWorkflow = "", jobMessage = "";
    private bool working, analyzing, reportingJob, cancelRequested, disposed;
    private List<SavedView> views = [];
    private List<OrganizationSuggestion> suggestions = [];
    private readonly List<OrganizationSuggestion> collectionSuggestions = [], tagSuggestions = [];
    private GalleryFilter? suggestedFilter;
    private List<ImageRecord> compareImages = [];
    private readonly Dictionary<string, string> comparison = [];
    private IEnumerable<string> Collections => Images.SelectMany(image => image.Collections).Distinct(StringComparer.OrdinalIgnoreCase).Order();
    private IEnumerable<string> Tags => Images.SelectMany(image => image.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        .Distinct(StringComparer.OrdinalIgnoreCase).Order();
    private IEnumerable<ImageRecord> UnanalyzedImages => Images.Where(image => image.Description.Length == 0 && !image.IsMarkedForDeletion
        && !suggestions.Any(suggestion => suggestion.Id == image.Id));
    private int UnanalyzedCount => UnanalyzedImages.Count();
    private bool newCollection, newTags;
    private string CollectionChoice
    {
        get => newCollection ? "new" : collection.Length > 0 ? "value:" + collection : "";
        set { newCollection = value == "new"; collection = value.StartsWith("value:", StringComparison.Ordinal) ? value[6..] : ""; }
    }
    private string TagChoice
    {
        get => newTags ? "new" : tags.Length > 0 ? "value:" + tags : "";
        set { newTags = value == "new"; tags = value.StartsWith("value:", StringComparison.Ordinal) ? value[6..] : ""; }
    }
    protected override void OnParametersSet()
    {
        if (suggestions.RemoveAll(suggestion => !Images.Any(image => image.Id == suggestion.Id)) > 0) _ = PublishSuggestionsAsync();
        collectionSuggestions.RemoveAll(suggestion => !Images.Any(image => image.Id == suggestion.Id));
        tagSuggestions.RemoveAll(suggestion => !Images.Any(image => image.Id == suggestion.Id));
        var imagesById = Images.ToDictionary(image => image.Id);
        for (var index = 0; index < compareImages.Count; index++)
            if (imagesById.TryGetValue(compareImages[index].Id, out var image)) compareImages[index] = image;
    }

    // Saved views are an unexposed feature: the UI is hidden, but views stay loaded and encrypted for a future surface.
    protected override Task OnInitializedAsync() => RunAsync("Loading saved views...", async () => views = await Gallery.LoadViewsAsync());

    private async Task RunAsync(string message, Func<Task> action, bool reportJob = false)
    {
        if (working) return;
        working = true; status = message; error = notice = "";
        reportingJob = reportJob;
        if (reportJob) jobWorkflow = Workflow;
        try { await PublishJobAsync(); await action(); }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Library workbench operation failed");
            error = exception is InvalidOperationException or IOException or System.Text.Json.JsonException
                ? exception.Message : "The operation failed. Check the application console.";
        }
        finally
        {
            if (reportJob) jobMessage = error.Length > 0 ? "Operation reported errors. Open workflow for details." : notice;
            working = analyzing = reportingJob = false;
            await PublishJobAsync();
        }
    }

    private Task PublishJobAsync() => disposed ? Task.CompletedTask : JobChanged.InvokeAsync(
        new LibraryJobStatus(working && reportingJob, jobWorkflow, working && reportingJob ? status : jobMessage,
            suggestions.Count + collectionSuggestions.Count + tagSuggestions.Count, analyzing && !cancelRequested));

    public async Task StopAnalysisAsync()
    {
        if (!analyzing) return;
        cancelRequested = true;
        status = "Stopping after the current image...";
        await PublishJobAsync();
    }

    public async Task DismissSuggestionAsync(OrganizationSuggestion suggestion)
    {
        suggestions.RemoveAll(item => item.Id == suggestion.Id);
        if (!working) jobMessage = $"{suggestions.Count} suggestions await approval.";
        await PublishSuggestionsAsync();
        await PublishJobAsync();
        StateHasChanged();
    }

    private async Task ApplyBulkAsync(Func<ImageRecordEdit, ImageRecordEdit> change)
    {
        var failures = new List<string>();
        var ids = SelectedIds.ToArray();
        foreach (var id in ids)
        {
            try { await Gallery.UpdateAsync(id, change); }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Bulk organization failed for {ImageId}", id);
                failures.Add($"{id}: {exception.Message}");
            }
        }
        await Changed.InvokeAsync();
        notice = $"Updated {ids.Length - failures.Count} image(s).";
        error = string.Join(" / ", failures);
    }

    private Task OrganizeAsync() => RunAsync("Organizing selection...", async () =>
    {
        if (collection.Trim().Length > 80 || tags.Length > 4000)
            throw new InvalidOperationException("Collection or tags are too long.");
        if (collection.Trim().Length == 0 && tags.Trim().Length == 0)
            throw new InvalidOperationException("Enter a collection or tags.");
        await ApplyBulkAsync(image =>
        {
            var updated = image with { Tags = Gallery.MergeTags(image.Tags, tags) };
            return collection.Trim().Length > 0
                ? Gallery.SetOrganization(updated, updated.Rating, updated.IsReviewed, collection) : updated;
        });
    });

    private Task RemoveCollectionAsync() => RunAsync("Updating collections...", () => ApplyBulkAsync(image =>
        Gallery.RemoveCollection(image, collection)));

    private Task RateAsync() => RunAsync("Curating selection...", () => ApplyBulkAsync(image =>
        Gallery.SetCuration(image, rating == -1 ? null : rating,
            reviewStatus == "unchanged" ? null : reviewStatus == "reviewed")));

    private Task SaveViewAsync() => RunAsync("Saving view...", async () =>
    {
        await Gallery.SaveViewAsync(viewName, Filter);
        views = await Gallery.LoadViewsAsync();
        notice = "Saved view stored encrypted.";
    });

    private Task DeleteViewAsync(string name) => RunAsync("Deleting view...", async () =>
    {
        await Gallery.DeleteViewAsync(name);
        views = await Gallery.LoadViewsAsync();
    });

    private Task InterpretAsync() => RunAsync("Interpreting search locally...", async () =>
    {
        suggestedFilter = await Gallery.InterpretSearchAsync(await Gallery.SettingsAsync(), query, Collections.ToArray());
        notice = "Search interpretation ready to inspect.";
    }, reportJob: true);

    private async Task ApplySearchAsync()
    {
        if (suggestedFilter is not null) await FilterChanged.InvokeAsync(suggestedFilter with { });
        suggestedFilter = null;
    }

    private Task SuggestAsync() => AnalyzeSelectionAsync(suggestions);

    private Task AnalyzeSelectionAsync(List<OrganizationSuggestion> target)
    {
        if (SelectedIds.Count is 0 or > 24) return RunAsync("Analyzing selection...", () => throw new InvalidOperationException("Select between 1 and 24 images."));
        return AnalyzeAsync(Images.Where(image => SelectedIds.Contains(image.Id)).ToArray(), target, "Analyzing selection...");
    }

    private Task AnalyzeUnanalyzedAsync() => AnalyzeAsync(UnanalyzedImages.ToArray(), suggestions, "Analyzing images without a description...");

    private Task AnalyzeAsync(ImageRecord[] selected, List<OrganizationSuggestion> target, string message) => RunAsync(message, async () =>
    {
        if (selected.Length == 0) throw new InvalidOperationException("There are no images to analyze.");
        cancelRequested = false;
        analyzing = true;
        var settings = await Gallery.SettingsAsync();
        var failures = new List<string>();
        var completed = 0;
        foreach (var image in selected)
        {
            if (disposed || cancelRequested) break;
            status = $"Analyzing {completed + 1} / {selected.Length}: {image.Name}";
            await PublishJobAsync();
            await InvokeAsync(StateHasChanged);
            try
            {
                var result = await Gallery.AnalyzeImageWithCollectionAsync(settings, await Gallery.PreviewAsync(image.Id), Collections.ToArray());
                if (disposed) break;
                target.RemoveAll(suggestion => suggestion.Id == image.Id);
                target.Add(new(image.Id, image.Name, result.Description, result.Tags, result.Collection, settings.Model, result.Warning));
                if (ReferenceEquals(target, suggestions)) await PublishSuggestionsAsync();
                if (result.Warning.Length > 0) Logger.LogWarning("Analysis collection warning for {ImageId}: {Warning}", image.Id, result.Warning);
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Local analysis failed for {ImageId}", image.Id);
                failures.Add($"{image.Name}: {exception.Message}");
            }
            completed++;
        }
        notice = $"{(cancelRequested ? "Stopped" : "Analysis finished")}: {completed} / {selected.Length} processed; {failures.Count} failed. {target.Count} suggestions await approval.";
        error = string.Join(" / ", failures);
    }, reportJob: true);

    private Task ApplyCollectionAsync() => RunAsync("Applying collection...", async () =>
    {
        if (collection.Trim().Length is 0 or > 80) throw new InvalidOperationException("Enter a collection of 1 to 80 characters.");
        await ApplyBulkAsync(image => Gallery.AddCollection(image, collection));
    });

    private Task ApplyTagsAsync() => RunAsync("Applying tags...", async () =>
    {
        if (string.IsNullOrWhiteSpace(tags) || tags.Length > 4000) throw new InvalidOperationException("Enter tags of up to 4000 characters.");
        await ApplyBulkAsync(image => image with { Tags = Gallery.MergeTags(image.Tags, tags) });
    });

    private Task ApplyOrganizationSuggestionAsync(OrganizationSuggestion suggestion, bool forCollection) => RunAsync("Saving approved suggestion...", async () =>
    {
        await Gallery.UpdateAsync(suggestion.Id, image => forCollection
            ? Gallery.AddCollection(image, suggestion.Collection)
            : image with { Tags = Gallery.MergeTags(image.Tags, suggestion.Tags) });
        (forCollection ? collectionSuggestions : tagSuggestions).Remove(suggestion);
        await Changed.InvokeAsync();
    });

    // Approval runs outside RunAsync so suggestions can be reviewed while a Play analysis is still running.
    public async Task<ImageRecord?> ApproveSuggestionAsync(OrganizationSuggestion suggestion)
    {
        var record = await Gallery.UpdateAsync(suggestion.Id, image =>
        {
            var updated = image with { Description = suggestion.Description,
                Tags = Gallery.MergeTags(image.Tags, suggestion.Tags), AnalysisModel = suggestion.Model };
            return suggestion.Collection.Length > 0
                ? Gallery.SetOrganization(updated, updated.Rating, updated.IsReviewed, suggestion.Collection) : updated;
        });
        suggestions.RemoveAll(item => item.Id == suggestion.Id);
        if (!working) jobMessage = $"{suggestions.Count} suggestions await approval.";
        await PublishSuggestionsAsync();
        await PublishJobAsync();
        await Changed.InvokeAsync();
        StateHasChanged();
        return record;
    }

    private Task PublishSuggestionsAsync() => disposed ? Task.CompletedTask : SuggestionsChanged.InvokeAsync(suggestions.ToArray());

    private Task CompareAsync() => RunAsync("Preparing comparison...", async () =>
    {
        comparison.Clear();
        var selected = Images.Where(image => SelectedIds.Contains(image.Id)).ToList();
        if (selected.Count != 2) throw new InvalidOperationException("Select exactly two images.");
        foreach (var image in selected) comparison[image.Id] = await Gallery.ViewerImageAsync(image.Id, ImageResolution.Fit);
        compareImages = selected;
    });

    private Task RateOneAsync(ImageRecord image, int value) => RunAsync("Saving rating...", async () =>
    {
        var updated = await Gallery.UpdateAsync(image.Id, current => Gallery.SetOrganization(current, value, true, null));
        var comparisonIndex = compareImages.FindIndex(comparedImage => comparedImage.Id == image.Id);
        if (comparisonIndex >= 0) compareImages[comparisonIndex] = updated;
        await Changed.InvokeAsync();
    });

    private void CloseComparison() { compareImages.Clear(); comparison.Clear(); }
    public void Dispose() { disposed = true; cancelRequested = true; suggestions.Clear(); CloseComparison(); }
}
