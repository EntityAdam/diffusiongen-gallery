@implements IDisposable

@if (Catalog.CanRead)
{
    @if (Router is not null)
    {
        <NavigationLock OnBeforeInternalNavigation="Navigation.BeforeNavigationAsync" ConfirmExternalNavigation="Navigation.HasUnsavedChanges" />
    }

    <WorkspaceFeedback Activity="Activity" Enabled="UsesToasts" />

    @if (Activity.Error.Length > 0 && !UsesToasts)
    {
        <Alert Variant="AlertVariant.Destructive" Class="mb-6 flex items-center justify-between gap-3">@Activity.Error <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" OnClick="() => Activity.Error = string.Empty" aria-label="Dismiss error"><XIcon aria-hidden="true" /></Button></Alert>
    }
    @if (Activity.Message.Length > 0 && !UsesToasts)
    {
        <div class="my-4 flex items-center justify-between gap-3 rounded-lg border border-primary/25 bg-primary/5 p-4 text-sm break-words" role="status">@Activity.Message</div>
    }

    <CascadingValue Value="Navigation" IsFixed="true">
    <CascadingValue Value="Session.Guard" IsFixed="true">
    <CascadingValue Value="Session.Commands" IsFixed="true">
        <GalleryWorkspaceLayout Workflow="@Section" ActiveTool="@Browser.ActiveTool" ItemDisabled="Navigation.SidebarItemDisabled"
                                Navigate="Navigation.NavigateSidebarAsync" Location="Session.Collections.Location" LocationChanged="Navigation.NavigateCollectionsAsync"
                                Catalog="Catalog.Collections" Images="Catalog.Images" CatalogPartial="Catalog.IsPartial" Busy="Session.IsBusy" JobRunning="JobRunning"
                                Settings='() => Navigation.SwitchWorkflowAsync("settings")' Panic="Panic">
            @if (Session.CanUndo)
            {
                <div class="mb-4 flex flex-wrap items-center gap-2" aria-label="Organization actions">
                    <Button Variant="ButtonVariant.Outline" Disabled="@(Session.IsBusy || JobRunning || Catalog.IsPartial)" OnClick="Session.UndoOrganizationAsync">Undo organization change</Button>
                </div>
            }
            @if (Section is not ("gallery" or "collections" or "unorganized"))
            {
                <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
                    <div><span class="eyebrow">THE COLLECTION</span><div class="mt-2 flex items-center gap-2"><h2 class="mb-0">@WorkspaceNavigationState.Sections.Single(item => item.Id == Section).Name</h2></div></div>
                </div>
            }

            @if (Section == "ingest")
            {
                <IngestionWorkspace Session="Activity.Ingestion" Busy="Activity.Busy" Lifetime="Session.ImportLifetime" />
            }
            <SettingsWorkspace Active='@(Section == "settings")' Tab="@Navigation.SettingsTab"
                               TabChanged="Navigation.SwitchSettingsTabAsync" Activity="Activity" Catalog="Catalog" Duplicates="Session.Duplicates"
                               JobRunning="JobRunning" Locked="Locked" Purged="Purged" Panic="Panic"
                               FindDuplicates='() => Navigation.SwitchWorkflowAsync("duplicates")' Reload="Catalog.ReloadAsync"
                               Preferences="Session.Preferences" />
            @if (Section == "duplicates")
            {
                <DuplicateFinder @ref="duplicateFinder" Catalog="Session.Duplicates.Results" Lookup="Catalog.ImagesById.GetValueOrDefault"
                                 Busy="Activity.Busy" Reload="Catalog.ReloadAsync" OpenTrash="Navigation.OpenTrashAsync" />
            }
            @if (Section == "tags")
            {
                <TagManagement Changed="Session.TagsManagedAsync" View="Navigation.ViewTagAsync" ViewDisabled="@(Session.IsBusy || Catalog.IsPartial)" />
            }

            @if (Section is "collections" or "unorganized")
            {
                @if (Catalog.IsPartial)
                {
                    <div class="collection-empty" role="status">
                        <p>Loading the full collection library…</p>
                        @if (Catalog.LoadError.Length > 0)
                        {
                            <p role="alert">@Catalog.LoadError</p><Button OnClick="RetryCatalogLoadAsync">Retry</Button>
                        }
                    </div>
                }
                else
                {
                    <CollectionsWorkspace @ref="collectionsWorkspace" Disabled="@Activity.Busy" Catalog="Catalog.Collections" Images="Catalog.Images"
                                          KnownTags="Catalog.AllTags" Location="Session.Collections.Location" LocationChanged="Navigation.NavigateCollectionsAsync"
                                          Reload="Session.Collections.ReloadAsync" ImageChanged="Catalog.UpdateAsync" BusyChanged="value => Session.Collections.IsBusy = value"
                                          Open="OpenCollectionDetailsAsync" BackToGallery='() => Navigation.SwitchWorkflowAsync("gallery")' />
                }
            }
            <Microsoft.AspNetCore.Components.Sections.SectionOutlet SectionName="gallery-browser" />
        </GalleryWorkspaceLayout>

        <GalleryBrowser @ref="galleryBrowser" State="Browser" Catalog="Catalog" Active='@(Section == "gallery")'
                        Presentation="Presentation" Removal="Session.Removal" Curation="Session.Curation"
                        Analysis="Session.Analysis" Refreshed="RefreshWorkspace" />
        <MediaPresentationHost State="Presentation" Catalog="Catalog" Activity="Activity" PageImages="Browser.PageImages"
                               Suggestions="Browser.Suggestions" Curation="Session.Curation" Analysis="Session.Analysis"
                               Removal="Session.Removal" Changed="RefreshWorkspace" />
        <RemovalWorkflow State="Session.Removal" Activity="Activity" Changed="RefreshWorkspace" />
        <UnsavedChangesGuard State="Session.Guard" Error="@Activity.Error" Changed="RefreshWorkspace" />
        <GalleryGridShortcuts Blocked="GridBlocked" Toolbox="HandleToolboxShortcutAsync" Grid="HandleGridShortcutAsync" />
    </CascadingValue>
    </CascadingValue>
    </CascadingValue>
}
