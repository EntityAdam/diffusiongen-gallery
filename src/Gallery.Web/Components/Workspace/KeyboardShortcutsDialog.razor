<ModalDialog Class="keyboard-shortcuts-dialog" LabelledBy="keyboard-shortcuts-title" Close="Close">
    <div class="keyboard-shortcuts-card" @onkeydown="HandleKeyDownAsync">
        <header class="keyboard-shortcuts-header">
            <div>
                <h2 id="keyboard-shortcuts-title">Keyboard shortcuts</h2>
                <p>Shortcuts by workspace and viewing mode.</p>
            </div>
            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Type="button" aria-label="Close keyboard shortcuts"
                    autofocus OnClick="Close"><XIcon aria-hidden="true" /></Button>
        </header>
        <div class="keyboard-shortcuts-content" role="region" aria-label="Shortcut list" tabindex="0">
            @foreach (var group in Groups)
            {
                <section class="keyboard-shortcuts-group">
                    <h3>@group.Title</h3>
                    @if (group.Note is not null)
                    {
                        <p>@group.Note</p>
                    }
                    <dl>
                        @foreach (var (action, keys) in group.Shortcuts)
                        {
                            <div class="keyboard-shortcuts-row">
                                <dt>@action</dt>
                                <dd>
                                    @foreach (var key in keys)
                                    {
                                        <kbd>@key</kbd>
                                    }
                                </dd>
                            </div>
                        }
                    </dl>
                </section>
            }
        </div>
    </div>
</ModalDialog>

@code {
    [Parameter] public EventCallback Close { get; set; }

    private Task HandleKeyDownAsync(KeyboardEventArgs args) =>
        args.Key == "Escape" && !args.ShiftKey && !args.CtrlKey && !args.AltKey && !args.MetaKey
            ? Close.InvokeAsync()
            : Task.CompletedTask;

    private sealed record ShortcutGroup(string Title, string? Note, (string Action, string[] Keys)[] Shortcuts);

    private static readonly ShortcutGroup[] Groups =
    [
