<div class="filter-panel">
        <p class="text-muted-foreground text-sm" aria-live="polite">@ResultCount of @Images.Count media items match</p>
        <div class="filter-panel-body">
            <div class="filter-primary">
                <Label For="search" Class="mb-2 block">Search</Label>
                <DebouncedFilterInput Disabled="@Disabled" Id="search" ResetVersion="@ResetVersion" @bind-Value="draft.Search" @bind-Value:after="NotifyChangedAsync" Placeholder="Prompt, name, description..." />
                <Label For="diffusion-model" Class="mt-4 mb-2 block">Diffusion model</Label>
                <DebouncedFilterInput Disabled="@Disabled" Id="diffusion-model" ResetVersion="@ResetVersion" @bind-Value="draft.DiffusionModel" @bind-Value:after="NotifyChangedAsync" Placeholder="Any diffusion model" List="diffusion-models" />
                <datalist id="diffusion-models">@foreach (var model in DiffusionModels) { <option value="@model"></option> }</datalist>
            </div>

            @foreach (var section in Sections)
            {
                var isExpanded = expanded.Contains(section.Id);
                var count = section.ActiveCount(Filter);
                <section class="filter-section">
                    <h3>
                        <button type="button" class="filter-section-toggle" data-filter-navigation aria-expanded="@(isExpanded ? "true" : "false")" aria-controls="@($"filter-section-{section.Id}")" @onclick="() => ToggleSection(section.Id)">
                            <span>@(section.Title)</span>
                            @if (count > 0)
                            {
                                <span class="filter-count" aria-label="@($"{count} active")">@count</span>
                            }
                            <ChevronDownIcon Size="16" ClassName="filter-section-chevron" aria-hidden="true" />
                        </button>
                    </h3>
                    <div id="@($"filter-section-{section.Id}")" class="filter-section-body" hidden="@(!isExpanded)">
                        @switch (section.Id)
                        {
                            case "organization":
                                <Label For="collection-filter" Class="mb-2 block">Collection</Label>
                                <AdvancedSelect Disabled="@Disabled" Id="collection-filter" Label="Collections" ItemLabel="collection" Placeholder="All collections"
                                                Options="@Collections" AllowCreate="false" @bind-Value="draft.Collection" @bind-Value:after="NotifyChangedAsync" />
                                <div class="mt-3 flex items-start gap-3"><Checkbox Disabled="@Disabled" id="check-draft-unorganizedonly" Class="mt-0.5" @bind-Checked="draft.IncludesUnorganizedOnly" @bind-Checked:after="NotifyChangedAsync" /><Label For="check-draft-unorganizedonly" Class="text-sm leading-relaxed">Without a collection only</Label></div>
                                <Label For="tag" Class="mt-4 mb-2 block">Tags</Label>
                                <AdvancedSelect Disabled="@Disabled" Id="tag" Label="Tags" ItemLabel="tag" Placeholder="All tags" MaxLength="4000" Multiple="true"
                                                Options="@Tags" AllowCreate="false" @bind-Values="draft.Tags" @bind-Values:after="NotifyChangedAsync" />
                                <p class="mt-2 text-sm text-muted-foreground">Matches all selected tags.</p>
                                <Label For="folder" Class="mt-4 mb-2 block">Folder</Label>
                                <DebouncedFilterInput Disabled="@Disabled" Id="folder" ResetVersion="@ResetVersion" @bind-Value="draft.Folder" @bind-Value:after="NotifyChangedAsync" Placeholder="Source or current folder" />
                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <Label For="rating-filter" Class="mt-4 mb-2 block">Minimum rating</Label>
                                        <select disabled="@Disabled" id="rating-filter" @bind="draft.MinRating" @bind:after="NotifyChangedAsync" class="@NativeInputClass">
                                            <option value="0">Any rating</option>@for (var score = 1; score <= 5; score++) { <option value="@score">@score / 5</option> }
                                        </select>
                                    </div>
                                    <div>
                                        <Label For="review-filter" Class="mt-4 mb-2 block">Review</Label>
                                        <Select Disabled="@Disabled" id="review-filter" @bind-Value="draft.Review" @bind-Value:after="NotifyChangedAsync">
                                            <option value="all">All media</option><option value="pending">Awaiting review</option><option value="reviewed">Reviewed</option>
                                        </Select>
                                    </div>
                                </div>
                                <div class="mt-4 flex items-start gap-3"><Checkbox Disabled="@Disabled" id="check-draft-favoritesonly" Class="mt-0.5" @bind-Checked="draft.IncludesFavoritesOnly" @bind-Checked:after="NotifyChangedAsync" /><Label For="check-draft-favoritesonly" Class="text-sm leading-relaxed">Favorites only</Label></div>
                                <Label For="deletion" Class="mt-4 mb-2 block">Deletion status</Label>
                                <Select Disabled="@Disabled" id="deletion" @bind-Value="draft.Deletion" @bind-Value:after="NotifyChangedAsync">
                                    <option value="active">Active media</option><option value="marked">Marked for deletion</option><option value="all">All media</option>
                                </Select>
                                break;
                            case "media":
                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <Label For="media-filter" Class="mb-2 block">Media type</Label>
                                        <Select Disabled="@Disabled" id="media-filter" @bind-Value="draft.Media" @bind-Value:after="NotifyChangedAsync">
                                            <option value="all">All media</option><option value="image">Images only</option><option value="video">Videos only</option>
                                        </Select>
                                    </div>
                                    <div>
                                        <Label For="orientation" Class="mb-2 block">Orientation</Label>
                                        <Select Disabled="@Disabled" id="orientation" @bind-Value="draft.Orientation" @bind-Value:after="NotifyChangedAsync">
                                            <option value="all">All orientations</option><option value="landscape">Landscape</option><option value="portrait">Portrait</option><option value="square">Square</option>
                                        </Select>
                                    </div>
                                    <div><Label For="width" Class="mt-1 mb-2 block">Min width</Label><input disabled="@Disabled" id="width" type="number" min="0" @bind="draft.MinWidth" @bind:after="NotifyChangedAsync" class="@NativeInputClass" /></div>
                                    <div><Label For="height" Class="mt-1 mb-2 block">Min height</Label><input disabled="@Disabled" id="height" type="number" min="0" @bind="draft.MinHeight" @bind:after="NotifyChangedAsync" class="@NativeInputClass" /></div>
                                </div>
                                break;
                            case "vision":
                                <Label For="analysis" Class="mb-2 block">Analysis status</Label>
                                <Select Disabled="@Disabled" id="analysis" @bind-Value="draft.Analysis" @bind-Value:after="NotifyChangedAsync">
                                    <option value="all">All media</option><option value="analyzed">Analyzed</option><option value="@GalleryFilter.AwaitingApproval">Awaiting approval</option><option value="pending">Not analyzed yet</option>
                                </Select>
                                <Label For="analysis-model" Class="mt-4 mb-2 block">Vision model</Label>
                                <DebouncedFilterInput Disabled="@Disabled" Id="analysis-model" ResetVersion="@ResetVersion" @bind-Value="draft.Model" @bind-Value:after="NotifyChangedAsync" Placeholder="Model name" />
                                <p class="mt-4 text-muted-foreground">Structured analysis (experimental): kinds and relationships match exactly; attribute values match a phrase. With an object, attributes apply to that same object. Without one, they apply to the subject.</p>
                                <datalist id="vision-kinds">@foreach (var kind in VisionKinds) { <option value="@kind"></option> }</datalist>
                                <datalist id="vision-predicates">@foreach (var predicate in VisionPredicates) { <option value="@predicate"></option> }</datalist>
                                <Label For="vision-subject" Class="mt-3 mb-2 block">Subject kind</Label>
                                <DebouncedFilterInput Disabled="@Disabled" Id="vision-subject" List="vision-kinds" ResetVersion="@ResetVersion" @bind-Value="draft.VisionSubject" @bind-Value:after="NotifyChangedAsync" Placeholder="man" />
                                <Label For="vision-relationship" Class="mt-3 mb-2 block">Relationship</Label>
                                <DebouncedFilterInput Disabled="@Disabled" Id="vision-relationship" List="vision-predicates" ResetVersion="@ResetVersion" @bind-Value="draft.VisionRelationship" @bind-Value:after="NotifyChangedAsync" Placeholder="wearing" />
                                <Label For="vision-object" Class="mt-3 mb-2 block">Object kind</Label>
                                <DebouncedFilterInput Disabled="@Disabled" Id="vision-object" List="vision-kinds" ResetVersion="@ResetVersion" @bind-Value="draft.VisionObject" @bind-Value:after="NotifyChangedAsync" Placeholder="hat" />
                                <Label For="vision-attribute" Class="mt-3 mb-2 block">Attribute name</Label>
                                <DebouncedFilterInput Disabled="@Disabled" Id="vision-attribute" ResetVersion="@ResetVersion" @bind-Value="draft.VisionAttribute" @bind-Value:after="NotifyChangedAsync" Placeholder="color" />
                                <Label For="vision-value" Class="mt-3 mb-2 block">Attribute value</Label>
                                <DebouncedFilterInput Disabled="@Disabled" Id="vision-value" ResetVersion="@ResetVersion" @bind-Value="draft.VisionValue" @bind-Value:after="NotifyChangedAsync" Placeholder="yellow" />
                                break;
                            case "imported":
                                <div class="grid grid-cols-2 gap-3">
                                    <div><Label For="from" Class="mb-2 block">From</Label><input disabled="@Disabled" id="from" type="date" @bind="draft.From" @bind:after="NotifyChangedAsync" class="@NativeInputClass" /></div>
                                    <div><Label For="to" Class="mb-2 block">Through</Label><input disabled="@Disabled" id="to" type="date" @bind="draft.To" @bind:after="NotifyChangedAsync" class="@NativeInputClass" /></div>
                                </div>
                                break;
                        }
                    </div>
                </section>
            }

            <p class="filter-panel-note">Thumbnails and metadata are encrypted in SQLite. Filters run locally while the gallery is unlocked, and results update as you change them.</p>
        </div>

        <div class="filter-panel-footer">
            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="Reset" Disabled="@Disabled">Reset filters</Button>
        </div>
</div>

@code {
    private const string NativeInputClass = "h-10 w-full min-w-0 rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-50";

    [Parameter, EditorRequired] public GalleryFilter Filter { get; set; } = new();
    [Parameter] public IReadOnlyList<ImageRecord> Images { get; set; } = [];
    [Parameter] public int ResultCount { get; set; }
    [Parameter] public EventCallback<GalleryFilter> Changed { get; set; }
    [Parameter] public EventCallback Reset { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public long ResetVersion { get; set; }

    private sealed record FilterSection(string Id, string Title, Func<GalleryFilter, int> ActiveCount);

    private static readonly FilterSection[] Sections =
    [
        new("organization", "Organization", filter => Count(
            filter.Collection.Length > 0, filter.IncludesUnorganizedOnly, filter.Tag.Length > 0, filter.Folder.Length > 0,
            filter.MinRating > 0, filter.Review != GalleryFilter.AnyValue, filter.IncludesFavoritesOnly,
            filter.Deletion != GalleryFilter.AnyValue)),
        new("media", "Media & dimensions", filter => Count(
            filter.Media != GalleryFilter.AnyValue, filter.Orientation != GalleryFilter.AnyValue, filter.MinWidth > 0, filter.MinHeight > 0)),
        new("vision", "Vision analysis", filter => Count(filter.Analysis != GalleryFilter.AnyValue, filter.Model.Length > 0, filter.Vision is { IsEmpty: false })),
        new("imported", "Imported date", filter => Count(filter.From is not null, filter.To is not null))
    ];

    private static int Count(params bool[] conditions) => conditions.Count(condition => condition);

    private FilterDraft draft = new();
    private GalleryFilter? receivedFilter;
    private long receivedResetVersion;
    private readonly HashSet<string> expanded = [];

    public static int CountActive(GalleryFilter filter) => Sections.Sum(section => section.ActiveCount(filter))
        + Count(filter.Search.Length > 0, filter.DiffusionModel.Length > 0, filter.Prompt.Length > 0);

    // Counts criteria that differ from a new filter, so the default deletion view is not reported as a filter.
    public static int CountChanged(GalleryFilter filter) =>
        CountActive(filter with { Deletion = GalleryFilter.AnyValue }) + Count(filter.Deletion != new GalleryFilter().Deletion);

    protected override void OnInitialized()
    {
        foreach (var section in Sections.Where(section => section.ActiveCount(Filter) > 0)) expanded.Add(section.Id);
    }

    protected override void OnParametersSet()
    {
        if (receivedFilter != Filter || receivedResetVersion != ResetVersion)
        {
            draft = FilterDraft.CreateFrom(Filter);
            receivedFilter = Filter;
            receivedResetVersion = ResetVersion;
        }
    }

    private IEnumerable<string> Collections => Images.SelectMany(image => image.Collections)
        .Distinct(StringComparer.OrdinalIgnoreCase).Order();

    [Parameter] public IEnumerable<string> KnownTags { get; set; } = [];
    private IEnumerable<string> Tags => KnownTags.Concat(Images.SelectMany(image =>
            image.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)))
        .Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase);

    private IEnumerable<string> DiffusionModels => Images.Select(image => image.Generation?.Model.Trim() ?? "")
        .Where(model => model.Length > 0).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase);

    private IEnumerable<string> VisionKinds => Images.Where(image => image.VisionFacts is not null)
        .SelectMany(image => image.VisionFacts!.Entities).Select(entity => entity.Kind).Where(kind => kind.Length > 0)
        .Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase);
    private IEnumerable<string> VisionPredicates => Images.Where(image => image.VisionFacts is not null)
        .SelectMany(image => image.VisionFacts!.Relationships).Select(relation => relation.Predicate)
        .Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase);

    private Task NotifyChangedAsync() => Changed.InvokeAsync(draft.ToFilter());

    private void ToggleSection(string id)
    {
        if (!expanded.Remove(id)) expanded.Add(id);
    }

    private sealed class FilterDraft
    {
        public string VisionSubject { get; set; } = "";
        public string VisionRelationship { get; set; } = "";
        public string VisionObject { get; set; } = "";
        public string VisionAttribute { get; set; } = "";
        public string VisionValue { get; set; } = "";
        public string Search { get; set; } = "";
        public string Folder { get; set; } = "";
        public IReadOnlyList<string> Tags { get; set; } = [];
        public string Model { get; set; } = "";
        public string DiffusionModel { get; set; } = "";
        public bool IncludesFavoritesOnly { get; set; }
        public string Deletion { get; set; } = "active";
        public string Analysis { get; set; } = GalleryFilter.AnyValue;
        public string Orientation { get; set; } = GalleryFilter.AnyValue;
        public int MinWidth { get; set; }
        public int MinHeight { get; set; }
        public DateTime? From { get; set; }
        public DateTime? To { get; set; }
        public string Sort { get; set; } = "newest";
        public string Collection { get; set; } = "";
        public int MinRating { get; set; }
        public string Review { get; set; } = GalleryFilter.AnyValue;
        public bool IncludesUnorganizedOnly { get; set; }
        public string Media { get; set; } = GalleryFilter.AnyValue;
        public string Prompt { get; set; } = "";

        public static FilterDraft CreateFrom(GalleryFilter filter) => new()
        {
            VisionSubject = filter.Vision?.Subject ?? "",
            VisionRelationship = filter.Vision?.Relationship ?? "",
            VisionObject = filter.Vision?.Object ?? "",
            VisionAttribute = filter.Vision?.Attribute ?? "",
            VisionValue = filter.Vision?.Value ?? "",
            Search = filter.Search, Folder = filter.Folder, Tags = filter.Tag.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries), Model = filter.Model,
            DiffusionModel = filter.DiffusionModel,
            IncludesFavoritesOnly = filter.IncludesFavoritesOnly, Deletion = filter.Deletion, Analysis = filter.Analysis,
            Orientation = filter.Orientation, MinWidth = filter.MinWidth, MinHeight = filter.MinHeight,
            From = filter.From, To = filter.To, Sort = filter.Sort, Collection = filter.Collection,
            MinRating = filter.MinRating, Review = filter.Review, IncludesUnorganizedOnly = filter.IncludesUnorganizedOnly,
            Media = filter.Media, Prompt = filter.Prompt
        };

        public GalleryFilter ToFilter() => new()
        {
            Vision = new VisionQuery { Subject = VisionSubject.Trim(), Relationship = VisionRelationship.Trim(), Object = VisionObject.Trim(), Attribute = VisionAttribute.Trim(), Value = VisionValue.Trim() },
            Search = Search, Folder = Folder, Tag = string.Join(", ", Tags), Model = Model, DiffusionModel = DiffusionModel,
            IncludesFavoritesOnly = IncludesFavoritesOnly,
            Deletion = Deletion, Analysis = Analysis, Orientation = Orientation, MinWidth = MinWidth,
            MinHeight = MinHeight, From = From, To = To, Sort = Sort, Collection = Collection,
            MinRating = MinRating, Review = Review, IncludesUnorganizedOnly = IncludesUnorganizedOnly,
            Media = Media, Prompt = Prompt
        };
    }
}
