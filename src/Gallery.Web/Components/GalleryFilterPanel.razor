<Card Class="mb-6 p-5 md:p-6 space-y-4" role="complementary">
    <details class="filter-disclosure">
        <summary>Filter images</summary>
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3"><h3>Find your image</h3><Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Default" Class="h-auto px-0" OnClick="Reset" Disabled="@Disabled">Reset</Button></div>
        <Label For="collection-filter" Class="mt-4 mb-2 block">Collection</Label>
        <Select Disabled="@Disabled" id="collection-filter" @bind-Value="draft.Collection" @bind-Value:after="NotifyChangedAsync">
            <option value="">All collections</option>
            @foreach (var name in Collections)
            { <option value="@name">@name</option> }
        </Select>
        <Label For="rating-filter" Class="mt-4 mb-2 block">Minimum rating</Label><select disabled="@Disabled" id="rating-filter" @bind="draft.MinRating" @bind:after="NotifyChangedAsync" class="h-10 w-full min-w-0 rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-50">
            <option value="0">Any rating</option>@for (var score = 1; score <= 5; score++) { <option value="@score">@score / 5</option> }
        </select>
        <Label For="review-filter" Class="mt-4 mb-2 block">Review queue</Label><Select Disabled="@Disabled" id="review-filter" @bind-Value="draft.Review" @bind-Value:after="NotifyChangedAsync">
            <option value="all">All images</option><option value="pending">Awaiting review</option><option value="reviewed">Reviewed</option>
        </Select>
        <div class="mt-4 flex items-start gap-3"><Checkbox Disabled="@Disabled" id="check-draft-unorganizedonly" Class="mt-0.5" @bind-Checked="draft.UnorganizedOnly" @bind-Checked:after="NotifyChangedAsync"  /><Label For="check-draft-unorganizedonly" Class="text-sm leading-relaxed">Without a collection only</Label></div>
        <Label For="media-filter" Class="mt-4 mb-2 block">Media type</Label>
        <Select Disabled="@Disabled" id="media-filter" @bind-Value="draft.Media" @bind-Value:after="NotifyChangedAsync">
            <option value="all">Images and videos</option><option value="image">Images only</option><option value="video">Videos only</option>
        </Select>
        <Label For="search" Class="mt-4 mb-2 block">Search everything</Label>
        <Input Disabled="@Disabled" id="search" @bind-Value="draft.Search" @bind-Value:after="NotifyChangedAsync" Placeholder="Prompt, name, description..." />
        <Label For="tag" Class="mt-4 mb-2 block">Tag</Label>
        <Input Disabled="@Disabled" id="tag" @bind-Value="draft.Tag" @bind-Value:after="NotifyChangedAsync" Placeholder="Exact tag" list="tags" />
        <datalist id="tags">@foreach (var tag in Tags) { <option value="@tag"></option> }</datalist>
        <Label For="folder" Class="mt-4 mb-2 block">Folder</Label>
        <Input Disabled="@Disabled" id="folder" @bind-Value="draft.Folder" @bind-Value:after="NotifyChangedAsync" Placeholder="Source or current folder" />
        <Label For="analysis-model" Class="mt-4 mb-2 block">Vision model</Label>
        <Input Disabled="@Disabled" id="analysis-model" @bind-Value="draft.Model" @bind-Value:after="NotifyChangedAsync" Placeholder="Model name" />
        <Label For="orientation" Class="mt-4 mb-2 block">Orientation</Label>
        <Select Disabled="@Disabled" id="orientation" @bind-Value="draft.Orientation" @bind-Value:after="NotifyChangedAsync">
            <option value="all">All orientations</option><option value="landscape">Landscape</option><option value="portrait">Portrait</option><option value="square">Square</option>
        </Select>
        <div class="grid grid-cols-2 gap-3">
            <div><Label For="width" Class="mt-4 mb-2 block">Min width</Label><input disabled="@Disabled" id="width" type="number" min="0" @bind="draft.MinWidth" @bind:after="NotifyChangedAsync"  class="h-10 w-full min-w-0 rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-50"/></div>
            <div><Label For="height" Class="mt-4 mb-2 block">Min height</Label><input disabled="@Disabled" id="height" type="number" min="0" @bind="draft.MinHeight" @bind:after="NotifyChangedAsync"  class="h-10 w-full min-w-0 rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-50"/></div>
        </div>
        <Label For="analysis" Class="mt-4 mb-2 block">Vision analysis</Label>
        <Select Disabled="@Disabled" id="analysis" @bind-Value="draft.Analysis" @bind-Value:after="NotifyChangedAsync">
            <option value="all">All images</option><option value="analyzed">Analyzed</option><option value="pending">Not analyzed yet</option>
        </Select>
        <Label For="deletion" Class="mt-4 mb-2 block">Deletion status</Label>
        <Select Disabled="@Disabled" id="deletion" @bind-Value="draft.Deletion" @bind-Value:after="NotifyChangedAsync">
            <option value="active">Active images</option><option value="marked">Marked for deletion</option><option value="all">All images</option>
        </Select>
        <Label For="from" Class="mt-4 mb-2 block">Imported from</Label><input disabled="@Disabled" id="from" type="date" @bind="draft.From" @bind:after="NotifyChangedAsync"  class="h-10 w-full min-w-0 rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-50"/>
        <Label For="to" Class="mt-4 mb-2 block">Imported through</Label><input disabled="@Disabled" id="to" type="date" @bind="draft.To" @bind:after="NotifyChangedAsync"  class="h-10 w-full min-w-0 rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-50"/>
        <div class="mt-4 flex items-start gap-3"><Checkbox Disabled="@Disabled" id="check-draft-favoritesonly" Class="mt-0.5" @bind-Checked="draft.FavoritesOnly" @bind-Checked:after="NotifyChangedAsync"  /><Label For="check-draft-favoritesonly" Class="text-sm leading-relaxed">Favorites only</Label></div>
        <div class="mt-6 space-y-2 border-t border-border pt-4 text-xs leading-relaxed text-muted-foreground [&>strong]:block [&>strong]:text-foreground">Thumbnails and metadata are encrypted in SQLite. Filters run locally while the gallery is unlocked.</div>
    </details>
</Card>

@code {
    [Parameter, EditorRequired] public WebGalleryFilter Filter { get; set; } = new();
    [Parameter] public IReadOnlyList<WebImageRecord> Images { get; set; } = [];
    [Parameter] public EventCallback<WebGalleryFilter> Changed { get; set; }
    [Parameter] public EventCallback Reset { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private FilterDraft draft = new();
    protected override void OnParametersSet() => draft = FilterDraft.CreateFrom(Filter);

    private IEnumerable<string> Collections => Images.SelectMany(image => image.Collections)
        .Distinct(StringComparer.OrdinalIgnoreCase).Order();

    private IEnumerable<string> Tags => Images.SelectMany(image =>
            image.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        .Distinct().Order();

    private Task NotifyChangedAsync() => Changed.InvokeAsync(draft.ToFilter());

    private sealed class FilterDraft
    {
        public string Search { get; set; } = "";
        public string Folder { get; set; } = "";
        public string Tag { get; set; } = "";
        public string Model { get; set; } = "";
        public bool FavoritesOnly { get; set; }
        public string Deletion { get; set; } = "active";
        public string Analysis { get; set; } = WebGalleryFilter.AnyValue;
        public string Orientation { get; set; } = WebGalleryFilter.AnyValue;
        public int MinWidth { get; set; }
        public int MinHeight { get; set; }
        public DateTime? From { get; set; }
        public DateTime? To { get; set; }
        public string Sort { get; set; } = "newest";
        public string Collection { get; set; } = "";
        public int MinRating { get; set; }
        public string Review { get; set; } = WebGalleryFilter.AnyValue;
        public bool UnorganizedOnly { get; set; }
        public string Media { get; set; } = WebGalleryFilter.AnyValue;
        public string Prompt { get; set; } = "";

        public static FilterDraft CreateFrom(WebGalleryFilter filter) => new()
        {
            Search = filter.Search, Folder = filter.Folder, Tag = filter.Tag, Model = filter.Model,
            FavoritesOnly = filter.FavoritesOnly, Deletion = filter.Deletion, Analysis = filter.Analysis,
            Orientation = filter.Orientation, MinWidth = filter.MinWidth, MinHeight = filter.MinHeight,
            From = filter.From, To = filter.To, Sort = filter.Sort, Collection = filter.Collection,
            MinRating = filter.MinRating, Review = filter.Review, UnorganizedOnly = filter.UnorganizedOnly,
            Media = filter.Media, Prompt = filter.Prompt
        };

        public WebGalleryFilter ToFilter() => new()
        {
            Search = Search, Folder = Folder, Tag = Tag, Model = Model, FavoritesOnly = FavoritesOnly,
            Deletion = Deletion, Analysis = Analysis, Orientation = Orientation, MinWidth = MinWidth,
            MinHeight = MinHeight, From = From, To = To, Sort = Sort, Collection = Collection,
            MinRating = MinRating, Review = Review, UnorganizedOnly = UnorganizedOnly,
            Media = Media, Prompt = Prompt
        };
    }
}
