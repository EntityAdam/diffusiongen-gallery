<div class="inline-flex min-w-0 items-center" role="group" aria-label="@($"Rating for {Image.Name}: {Image.Rating} out of 5 stars")">
    @for (var score = 1; score <= 5; score++)
    {
        var value = score;
        var label = ClearOnRepeat && Image.Rating == value ? "Clear rating" : $"Rate {value} out of 5 stars";
        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Disabled="@Disabled" Class="@(value <= Image.Rating ? "h-7! w-7! text-primary" : "h-7! w-7! text-muted-foreground")"
                aria-label="@label" title="@label" aria-pressed="@(Image.Rating == value ? "true" : "false")" OnClick="() => Rate.InvokeAsync(value)">
            <StarIcon Size="16" Fill="@(value <= Image.Rating ? "currentColor" : "none")" aria-hidden="true" />
        </Button>
    }
</div>

@code {
    [Parameter, EditorRequired] public ImageRecord Image { get; set; } = new();
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ClearOnRepeat { get; set; } = true;
    [Parameter] public EventCallback<int> Rate { get; set; }
}
