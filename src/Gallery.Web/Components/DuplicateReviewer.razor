@implements IAsyncDisposable
@inject GalleryService Gallery
@inject IJSRuntime JS
@inject ILogger<DuplicateReviewer> Logger

<section class="fullscreen-viewer fixed inset-0 z-50 flex flex-col bg-background outline-none duplicate-reviewer" role="dialog" aria-modal="true" aria-label="Duplicate review" tabindex="-1" @ref="element" data-review="false" data-keys="arrowup arrowdown k a s">
    <header class="flex shrink-0 flex-wrap items-center justify-between gap-3 border-b border-border px-4 py-3 [&_strong]:break-all">
        <div>
            <strong>Duplicate group @(groupIndex + 1) / @Groups.Count</strong>
            <span class="text-muted-foreground"> &middot; copy @(imageIndex + 1) / @members.Count &middot; @Current.Name &middot; @Current.Width &times; @Current.Height &middot; @GalleryService.FormatBytes(Current.OriginalBytes)</span>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Disabled="@(busy || imageIndex == 0)" OnClick="() => ShowImageAsync(imageIndex - 1)" title="Left arrow: previous copy"><ChevronLeftIcon aria-hidden="true" />Previous copy</Button>
            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Disabled="@(busy || imageIndex + 1 >= members.Count)" OnClick="() => ShowImageAsync(imageIndex + 1)" title="Right arrow: next copy">Next copy<ChevronRightIcon aria-hidden="true" /></Button>
            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Disabled="@(busy || groupIndex == 0)" OnClick="() => OpenGroupAsync(groupIndex - 1)" title="Up arrow: previous group"><ChevronUpIcon aria-hidden="true" />Previous group</Button>
            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Disabled="@(busy || groupIndex + 1 >= Groups.Count)" OnClick="() => OpenGroupAsync(groupIndex + 1)" title="Down arrow: next group"><ChevronDownIcon aria-hidden="true" />Next group</Button>
            <Button Variant="@(originalSize ? ButtonVariant.Secondary : ButtonVariant.Outline)" Size="ButtonSize.Sm" Disabled="@busy" OnClick="() => SetSizeAsync(true)" aria-pressed="@(originalSize ? "true" : "false")"><ScanIcon aria-hidden="true" />Original size (O)</Button>
            <Button Variant="@(!originalSize ? ButtonVariant.Secondary : ButtonVariant.Outline)" Size="ButtonSize.Sm" Disabled="@busy" OnClick="() => SetSizeAsync(false)" aria-pressed="@(originalSize ? "false" : "true")"><MaximizeIcon aria-hidden="true" />Fit window (P)</Button>
            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Disabled="@(busy && !loading)" OnClick="CloseAsync" aria-label="Close duplicate review"><XIcon aria-hidden="true" />Close (Esc)</Button>
        </div>
    </header>
    <div class="max-h-[35vh] shrink-0 space-y-3 overflow-auto border-b border-border bg-primary/5 px-4 py-3 text-sm flex flex-wrap items-center justify-between gap-4">
        <div>
            <strong>@(applied.Contains(groupIndex) ? "Saved. Change your picks and apply again, or move on." : Keep.Count == 0 ? "Keep at least one copy." : "Choose one or more copies to keep.")</strong>
            <p class="text-muted-foreground">Keeping @Keep.Count of @members.Count. Applying marks the other @(members.Count - Keep.Count) for deletion and clears marks on kept copies. @(Group.IsExact ? "Exact copies." : $"Similar media (difference {Group.MaxDistance}/64).") Nothing is deleted until you use Trash.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <Button Variant="@(Keep.Contains(Current.Id) ? ButtonVariant.Secondary : ButtonVariant.Outline)" Disabled="@busy" aria-pressed="@(Keep.Contains(Current.Id) ? "true" : "false")" OnClick="() => ToggleKeep(Current.Id)"><CheckIcon aria-hidden="true" />@(Keep.Contains(Current.Id) ? "Keeping this copy" : "Keep this copy") (K)</Button>
            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@busy" OnClick="KeepOnlyCurrent">Keep only this</Button>
            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@busy" OnClick="KeepAll">Keep all</Button>
            <Button Variant="ButtonVariant.Default" Size="ButtonSize.Default" Disabled="@(busy || Keep.Count == 0)" OnClick="ApplyAsync">@(groupIndex + 1 < Groups.Count ? "Apply & next group" : "Apply") (A)</Button>
            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@(busy || groupIndex + 1 >= Groups.Count)" OnClick="() => OpenGroupAsync(groupIndex + 1)">Skip group (S)</Button>
        </div>
    </div>
    <div class="viewer-image-area relative min-h-0 flex-1 overflow-auto [&>p]:absolute [&>p]:top-3 [&>p]:left-4 [&>p]:text-primary @(originalSize ? "original-size" : "fit-window")">
        @if (busy) { <p role="status">Loading...</p> }
        @if (imageData.Length > 0) { <img @key="Current.Id" src="@imageData" alt="@Current.Name" draggable="false" /> }
        <span class="duplicate-verdict pointer-events-none absolute top-3 right-4 rounded-full px-3 py-1 text-xs font-semibold @(Keep.Contains(Current.Id) ? "keep" : "drop")">@(Keep.Contains(Current.Id) ? "Keep" : "Will be marked for deletion")</span>
    </div>
    <div class="flex shrink-0 gap-3 overflow-x-auto border-t border-border bg-background px-4 py-3" role="group" aria-label="Copies in this group">
        @for (var position = 0; position < members.Count; position++)
        {
            var index = position;
            var member = members[index];
            var kept = Keep.Contains(member.Id);
            <div class="strip-item flex w-32 shrink-0 flex-col overflow-hidden rounded-lg border border-border bg-card sm:w-40 @(index == imageIndex ? "current" : "") @(kept ? "kept" : "dropped")" @key="member.Id">
                <button type="button" class="flex flex-col gap-1 text-left outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-50 [&_img]:h-20 [&_img]:w-full [&_img]:bg-background [&_img]:object-contain" disabled="@busy" aria-current="@(index == imageIndex ? "true" : null)" title="@($"View {member.Name}")" @onclick="() => ShowImageAsync(index)">
                    @if (thumbs.TryGetValue(member.Id, out var thumbnail)) { <img src="@thumbnail" alt="" draggable="false" /> }
                    else { <span class="grid h-full place-items-center text-xs text-muted-foreground">Preview</span> }
                    <span class="truncate px-2 text-xs font-semibold">@member.Name</span>
                    <span class="px-2 text-xs text-muted-foreground">@member.Width &times; @member.Height &middot; @GalleryService.FormatBytes(member.OriginalBytes)@(member.Rating > 0 ? $" · {member.Rating}★" : "")@(member.IsFavorite ? " · Favorite" : "")</span>
                    @if (member.Id == recommendedId) { <span class="px-2 text-xs text-muted-foreground text-primary">Recommended</span> }
                </button>
                <Button Variant="@(kept ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="mx-2 my-2" Disabled="@busy" aria-pressed="@(kept ? "true" : "false")" aria-label="@($"Keep {member.Name}")" OnClick="() => ToggleKeep(member.Id)"><CheckIcon aria-hidden="true" />Keep</Button>
            </div>
        }
    </div>
    <footer class="flex shrink-0 flex-wrap items-center justify-between gap-2 border-t border-border px-4 py-3 text-xs text-muted-foreground">
        <span>@status</span>
        <span>Left/Right: copies / Up/Down: groups / K: toggle keep / A: apply / S: skip / O: 100% / P: fit / Esc: close</span>
    </footer>
    @if (error.Length > 0) { <Alert Variant="AlertVariant.Destructive" Class="absolute right-4 bottom-16 left-4">@error</Alert> }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<DuplicateGroup> Groups { get; set; } = [];
    [Parameter, EditorRequired] public Func<string, ImageRecord?> Lookup { get; set; } = _ => null;
    [Parameter] public int InitialGroup { get; set; }
    [Parameter] public EventCallback<string> OnClose { get; set; }
    private ElementReference element;
    private DotNetObjectReference<DuplicateReviewer>? reference;
    private int groupIndex, imageIndex, appliedMarks, generation;
    private List<ImageRecord> members = [];
    private string recommendedId = "";
    private readonly Dictionary<int, HashSet<string>> keepByGroup = [];
    private readonly HashSet<int> applied = [];
    private readonly Dictionary<string, string> thumbs = [];
    private readonly Dictionary<(string Id, bool Full), string> urls = [];
    private readonly SemaphoreSlim gate = new(1);
    private bool busy, loading, originalSize, disposed, closed;
    private string imageData = "", error = "", status = "";
    private Task? preload;
    private DuplicateGroup Group => Groups[groupIndex];
    private ImageRecord Current => members[imageIndex];
    private HashSet<string> Keep => keepByGroup[groupIndex];

    protected override void OnInitialized()
    {
        groupIndex = Math.Clamp(InitialGroup, 0, Groups.Count - 1);
        PrepareGroup();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        reference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("galleryViewer.attach", element, reference);
        loading = true;
        try { await RunAsync(LoadGroupAsync); }
        finally { loading = false; }
        if (!disposed) StateHasChanged();
    }

    private void PrepareGroup()
    {
        var records = Group.ImageIds.Select(Lookup).OfType<ImageRecord>().ToList();
        recommendedId = Gallery.PickDuplicateKeeper(records).Id;
        members = records.OrderByDescending(record => record.Id == recommendedId).ToList();
        imageIndex = 0;
        imageData = "";
        if (!keepByGroup.ContainsKey(groupIndex)) keepByGroup[groupIndex] = Gallery.InitialDuplicateKeepers(records);
    }

    private async Task LoadGroupAsync()
    {
        var forGeneration = generation;
        var currentId = Current.Id;
        imageData = await LoadImageAsync(currentId, originalSize, forGeneration);
        if (disposed || forGeneration != generation) return;
        await InvokeAsync(StateHasChanged);
        foreach (var member in members)
        {
            if (disposed || forGeneration != generation) return;
            if (thumbs.ContainsKey(member.Id)) continue;
            var thumbnail = await Gallery.ThumbnailAsync(member.Id);
            if (disposed || forGeneration != generation) return;
            thumbs[member.Id] = thumbnail;
        }
        preload = PreloadAsync(forGeneration);
    }

    private async Task<string> LoadImageAsync(string id, bool full, int forGeneration)
    {
        await gate.WaitAsync();
        try
        {
            if (disposed || forGeneration != generation) return "";
            if (urls.TryGetValue((id, full), out var cached)) return cached;
        }
        finally { gate.Release(); }

        var data = await Gallery.ViewerImageAsync(id, full ? ImageResolution.Original : ImageResolution.Fit);
        if (disposed || forGeneration != generation) return "";

        await gate.WaitAsync();
        try
        {
            if (disposed || forGeneration != generation) return "";
            if (urls.TryGetValue((id, full), out var cached)) return cached;
            if (full)
            {
                // Full-resolution copies can be large; keep only the one being inspected.
                var stale = urls.Where(entry => entry.Key.Full).ToList();
                if (stale.Count > 0) await JS.InvokeVoidAsync("galleryViewer.releaseImageUrls", (object)stale.Select(entry => entry.Value).ToArray());
                foreach (var entry in stale) urls.Remove(entry.Key);
            }
            var url = await JS.InvokeAsync<string>("galleryViewer.createImageUrl", data);
            if (disposed || forGeneration != generation)
            {
                await JS.InvokeVoidAsync("galleryViewer.releaseImageUrls", (object)new[] { url });
                return "";
            }
            urls[(id, full)] = url;
            return url;
        }
        finally { gate.Release(); }
    }

    private async Task ReleaseUrlsAsync()
    {
        await gate.WaitAsync();
        try
        {
            if (urls.Count > 0) await JS.InvokeVoidAsync("galleryViewer.releaseImageUrls", (object)urls.Values.ToArray());
            urls.Clear();
        }
        finally { gate.Release(); }
    }

    private async Task PreloadAsync(int forGeneration)
    {
        // Sequential warm-up of this group's copies so flipping between them is instant.
        foreach (var member in members.ToList())
        {
            if (disposed || forGeneration != generation) return;
            try { await LoadImageAsync(member.Id, false, forGeneration); }
            catch (Exception exception) when (exception is not JSDisconnectedException)
            {
                if (disposed) return;
                Logger.LogError(exception, "Duplicate review preloading failed for {ImageId}", member.Id);
            }
            catch (JSDisconnectedException) { return; }
        }
    }

    private async Task RunAsync(Func<Task> action)
    {
        if (busy) return;
        busy = true;
        error = "";
        try { await action(); }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Duplicate review operation failed");
            error = exception is System.Security.Cryptography.CryptographicException
                ? "Media preview failed its encryption integrity check."
                : exception is IOException or InvalidOperationException ? exception.Message
                : "Duplicate review operation failed. Check the application console for details.";
        }
        finally { busy = false; }
    }

    private Task ShowImageAsync(int next) => RunAsync(async () =>
    {
        if (next < 0 || next >= members.Count) return;
        var forGeneration = generation;
        var data = await LoadImageAsync(members[next].Id, originalSize, forGeneration);
        if (disposed || forGeneration != generation) return;
        imageIndex = next;
        imageData = data;
    });

    private Task SetSizeAsync(bool original) => RunAsync(async () =>
    {
        var forGeneration = generation;
        var currentId = Current.Id;
        var data = await LoadImageAsync(currentId, original, forGeneration);
        if (disposed || forGeneration != generation) return;
        originalSize = original;
        imageData = data;
    });

    private Task OpenGroupAsync(int next) => RunAsync(() => MoveToGroupAsync(next));

    private async Task MoveToGroupAsync(int next)
    {
        if (next < 0 || next >= Groups.Count || next == groupIndex) return;
        loading = true;
        try
        {
            var forGeneration = ++generation;
            imageData = "";
            if (preload is not null) await preload;
            if (disposed || forGeneration != generation) return;
            await ReleaseUrlsAsync();
            if (disposed || forGeneration != generation) return;
            groupIndex = next;
            PrepareGroup();
            await LoadGroupAsync();
        }
        finally { loading = false; }
    }

    private void ToggleKeep(string id)
    {
        if (busy) return;
        if (!Keep.Remove(id)) Keep.Add(id);
        applied.Remove(groupIndex);
    }

    private void KeepOnlyCurrent()
    {
        if (busy) return;
        Keep.Clear();
        Keep.Add(Current.Id);
        applied.Remove(groupIndex);
    }

    private void KeepAll()
    {
        if (busy) return;
        Keep.UnionWith(members.Select(member => member.Id));
        applied.Remove(groupIndex);
    }

    private Task ApplyAsync() => RunAsync(async () =>
    {
        if (Keep.Count == 0) throw new InvalidOperationException("Keep at least one copy in the group.");
        var ids = members.Select(member => member.Id).ToList();
        members = await Gallery.ApplyDuplicateDecisionAsync(ids, Keep);
        var marked = ids.Count - Keep.Count;
        appliedMarks += marked;
        applied.Add(groupIndex);
        var last = groupIndex + 1 >= Groups.Count;
        status = $"Group {groupIndex + 1}: kept {Keep.Count}, marked {marked} for deletion." + (last ? " That was the last group; press Esc to close." : "");
        if (!last) await MoveToGroupAsync(groupIndex + 1);
    });

    private async Task CloseAsync()
    {
        if (closed) return;
        closed = disposed = true;
        generation++;
        await JS.InvokeVoidAsync("galleryViewer.detach", element);
        await ReleaseUrlsAsync();
        await OnClose.InvokeAsync(applied.Count == 0 ? "" :
            $"Duplicate review: {applied.Count} group(s) applied, {appliedMarks} cop{(appliedMarks == 1 ? "y" : "ies")} marked for deletion. Remove them from Trash.");
    }

    [JSInvokable]
    public async Task HandleKey(string key)
    {
        if (key == "escape" && (!busy || loading))
        {
            await CloseAsync();
            return;
        }
        if (busy) return;
        switch (key)
        {
            case "arrowleft": await ShowImageAsync(imageIndex - 1); break;
            case "arrowright": await ShowImageAsync(imageIndex + 1); break;
            case "arrowup": await OpenGroupAsync(groupIndex - 1); break;
            case "arrowdown": await OpenGroupAsync(groupIndex + 1); break;
            case "k": ToggleKeep(Current.Id); break;
            case "a": if (Keep.Count > 0) await ApplyAsync(); break;
            case "s": await OpenGroupAsync(groupIndex + 1); break;
            case "o": await SetSizeAsync(true); break;
            case "p": await SetSizeAsync(false); break;
        }
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        generation++;
        imageData = "";
        try
        {
            if (urls.Count > 0) await JS.InvokeVoidAsync("galleryViewer.releaseImageUrls", (object)urls.Values.ToArray());
            await JS.InvokeVoidAsync("galleryViewer.detach", element);
        }
        catch (JSDisconnectedException) { }
        finally { urls.Clear(); reference?.Dispose(); }
    }
}
