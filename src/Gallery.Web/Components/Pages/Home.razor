            <div class="mb-4 flex items-center gap-3">
                <button id="review-random-order" type="button" role="switch" class="review-random-toggle" aria-checked="@(reviewRandomOrder ? "true" : "false")"
                        aria-labelledby="review-random-order-label" disabled="@busy" @onclick="() => reviewRandomOrder = !reviewRandomOrder"><span></span></button>
                <Label id="review-random-order-label" For="review-random-order">Random order</Label>
