        finally { System.Security.Cryptography.CryptographicOperations.ZeroMemory(contentBytes); }
    }

    private async Task DownloadAsync(Stream content, string fileName, string contentType)
    {
        using var reference = new DotNetStreamReference(content);
        await JS.InvokeVoidAsync("galleryMedia.download", reference, fileName, contentType);
    }

    private Task ExportAsync(ImageRecord image) => RunAsync(image.IsVideo ? "Decrypting video copy..." : "Preparing image copy...", async () =>
    {
        var file = await Gallery.ExportAsync(image.Id);
        try { await DownloadAsync(file); }
        finally { GalleryService.ClearExportContent(file); }
        message = $"Saved a decrypted copy as {file.FileName}. It is no longer protected by the gallery.";
    });

    private Task ExportSelectedAsync() => RunAsync($"Packing {librarySelection.Count} decrypted copies...", async () =>
    {
        var file = await Gallery.ExportZipAsync(librarySelection.ToList());
        try { await DownloadAsync(file); }
        finally { GalleryService.ClearExportContent(file); }
        message = $"Saved {librarySelection.Count} decrypted copies as {file.FileName}. They are no longer protected by the gallery.";
    });

    private void OpenViewer(string? initialId = null)
    {
        reviewMode = false;
        viewerImages = (detailViewerImages ?? PageImages).Select(image => image with { }).ToList();
        if (initialId is not null && !viewerImages.Any(image => image.Id == initialId) && selected is not null)
            viewerImages.Add(selected with { });
        viewerInitialId = initialId ?? viewerImages.FirstOrDefault()?.Id ?? "";
        viewerInitialPreview = selected?.Id == viewerInitialId && !selected.IsVideo ? preview : "";
        CloseDetail();
    }

    private void StartReview()
    {
        var pool = ReviewPool.ToArray();
        if (reviewRandomOrder) Random.Shared.Shuffle(pool);
        viewerImages = pool.Take(ReviewGoal).Select(image => image with { }).ToList();
        viewerInitialId = viewerImages.FirstOrDefault()?.Id ?? "";
        viewerInitialPreview = "";
        reviewMode = true;
        CloseDetail();
    }

    private Task CloseViewerAsync()
    {
        viewerImages.Clear();
        viewerInitialId = "";
        viewerInitialPreview = "";
        return RunAsync("Refreshing gallery...", ReloadAsync);
    }

    private Task SaveNotesAsync() => RunAsync("Saving notes...", SaveDetailNotesCoreAsync);

    private Task ExportWorkflowAsync(ImageRecord image) => RunAsync("Exporting workflow...", async () =>
    {
        var file = await Gallery.WorkflowAsync(image.Id)
            ?? throw new InvalidOperationException("No ComfyUI workflow was found in this file.");
        try { await DownloadAsync(file); }
        finally { GalleryService.ClearExportContent(file); }
        message = $"Saved the ComfyUI workflow as {file.FileName}.";
    });

    private Task AnalyzeAsync() => RunAsync("Analyzing with your local vision model...", async () =>
    {
        EnsureNoLibraryJob();
        if (selected is null || workbench is null) return;
        await workbench.AnalyzeDetailAsync(selected);
        if (Gallery.IsUnlocked) message = "Review available suggestions in the AI toolbox. Unfinished analysis can be resumed there.";
    });

    private Task MoveAsync() => RunAsync("Moving encrypted media...", async () =>
    {
        EnsureNoLibraryJob();
        if (selected is null) return;
        try { await Gallery.MoveAsync(selected.Id, destination, rename); }
        finally { await ReloadAsync(); }
        message = "Encrypted media moved and renamed.";
    });

    private Task ChangePassphraseAsync() => RunAsync("Updating passphrase...", async () =>
    {
        EnsureNoLibraryJob();
        try
        {
            await Gallery.ChangePassphraseAsync(newPassphrase, newConfirm);
            message = "Passphrase updated. Your recovery words are unchanged.";
        }
        finally { newPassphrase = newConfirm = ""; }
    });

    private void EnsureNoLibraryJob()
    {
        if (libraryJob.IsRunning) throw new InvalidOperationException("Wait for the running LLM job to finish, or stop it after the current media item, before changing files or gallery settings.");
    }

    private async Task UpdateAutoLockMinutesAsync(string? value)
    {
        if (busy) return;
        if (int.TryParse(value, out var minutes))
        {
            minutes = Math.Clamp(minutes, 0, 1440);
            await RunAsync("Saving auto-lock timer...", () => SavePreferencesAsync(minutes));
            if (error.Length > 0)
            {
                error = "Auto-lock timer could not be saved. The previous timer is still active.";
                return;
            }
            autoLockMinutes = minutes;
            Gallery.ConfigureAutoLock(autoLockMinutes);
            try { await JS.InvokeVoidAsync("gallerySecurity.configureAutoLock", autoLockMinutes); }
            catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
        }
    }

    [JSInvokable]
    public async Task TriggerPanicLock()
    {
        await InvokeAsync(PanicAsync);
    }

    [JSInvokable]
    public async Task TriggerAutoLock()
    {
        await InvokeAsync(() =>
        {
            if (!Gallery.IsUnlocked) return;
            Lock();
            message = "Gallery locked after inactivity. Its checkout was released.";
            StateHasChanged();
        });
    }

    private async Task PanicAsync()
    {
        try { await JS.InvokeVoidAsync("gallerySecurity.purgeAllMedia"); }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
        Gallery.Panic();
        Lock();
        message = "Gallery locked and memory purged. Its checkout was released.";
        StateHasChanged();
    }

    private void Lock()
    {
        quickFilters = [];
        CloseQuickFilterDialog();
        workbench?.Dispose();
        OrganizationHistory.Clear();
        collectionWorking = false;
        CancelCatalogLoad();
        catalogPartial = false;
        catalogLoadError = "";
        try { _ = JS.InvokeVoidAsync("gallerySecurity.purgeAllMedia"); }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
        Gallery.LockVault();
        images.Clear();
        collectionCatalog = CollectionCatalog.Empty;
        collectionLocation = new();
        collectionNavigationOpen = false;
        browsingProjection = GalleryBrowsingProjection.Empty;
        browsingSource = null;
        StopThumbnailLoad();
        thumbnailTask = null;
        thumbnails.Clear();
        staleThumbnails.Clear();
        thumbnailFailures.Clear();
        CloseDetail();
        secret = confirm = recoveryPhrase = newPassphrase = newConfirm = error = message = importPath = "";
        ClearIngestionScan();
        if (!importRunning)
        {
            importFailures.Clear();
            importProgress = null;
            timingReport = null;
        }
        settings = new();
        catalogTags = [];
        filter = new();
        page = 0;
        useRecovery = recoverySaved = false;
        workflow = "gallery";
        activeTool = "";
        toolboxVisible = true;
        (toolboxX, toolboxY) = ((double?)null, (double?)null);
        aiSuggestions = new Dictionary<string, OrganizationSuggestion>();
        DismissProgressToast();
        settingsTab = "overview";
        pendingSettingsAction = null;
        llmEndpointSettings = null;
        storageOverview = null;
        backupOptions = null;
        backupDestinationType = "local";
        backupLocalDirectory = backupAzureContainer = backupAzurePrefix = backupAzureConnectionString = "";
        restoreCredential = restoreSasUrl = purgeConfirmation = "";
        browsingFilter = null;
        libraryJob = new(false, "", "", 0, false);
        deleteSources = false;
        removalSelection.Clear();
        removalPlan.Clear();
        removalResults.Clear();
        confirmRemoval = false;
        restoreFolder = "";
        librarySelection.Clear();
        viewerImages.Clear();
        viewerInitialId = "";
        viewerInitialPreview = "";
        imagesById = [];
        density = UiPreferences.DetailDensity;
        selectionAnchor = null;
        duplicateScan = null;
        duplicateThumbnails.Clear();
        VisibleDuplicateGroups = [];
        reviewGroups = [];
        DuplicateGroupsShown = 20;
    }

    public void Dispose()
    {
        ClearIngestionScan();
        disposed = true;
        OrganizationHistory.Changed -= HandleOrganizationHistoryChanged;
        Gallery.OnAutoLocked -= HandleAutoLocked;
        Gallery.DriveQueueChanged -= HandleDriveQueueChanged;
        Lock();
        gridReference?.Dispose();
        securityReference?.Dispose();
    }
}
