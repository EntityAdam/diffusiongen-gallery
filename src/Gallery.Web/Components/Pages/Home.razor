        message = "The file index is being rebuilt in the background. Refresh the overview when it finishes.";
    });

    private void HandleAutoLocked()
    {
        _ = InvokeAsync(() =>
        {
            if (disposed) return;
            Lock();
            message = "Gallery locked after inactivity. Its checkout was released.";
            StateHasChanged();
        });
    }

    private Task UnlockAsync() => RunAsync("Unlocking gallery...", async () =>
    {
        try
        {
            if (Gallery.VaultExists)
            {
                if (useRecovery) await Gallery.UnlockWithRecoveryPhraseAsync(secret);
                else await Gallery.UnlockWithPassphraseAsync(secret);
                workflow = importRunning ? "ingest" : "library";
                settingsTab = "overview";
                var preferences = await Gallery.LoadPreferencesAsync();
                density = preferences.GridDensity;
                autoLockMinutes = preferences.AutoLockMinutes;
                Gallery.ConfigureAutoLock(autoLockMinutes);
                try { await JS.InvokeVoidAsync("gallerySecurity.configureAutoLock", autoLockMinutes); }
                catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
                await ReloadAsync();
            }
            else throw new InvalidOperationException("No gallery is selected. Choose Switch gallery to open or create one.");
        }
        catch
        {
            Lock();
            throw;
        }
        finally { secret = confirm = ""; }
    }, allowDuringImport: true);

    private Task FinishSetupAsync() => RunAsync("Opening gallery...", async () =>
    {
        if (!recoverySaved) throw new InvalidOperationException("Save your recovery words first.");
        var preferences = await Gallery.LoadPreferencesAsync();
        density = preferences.GridDensity;
        autoLockMinutes = preferences.AutoLockMinutes;
        Gallery.ConfigureAutoLock(autoLockMinutes);
        try { await JS.InvokeVoidAsync("gallerySecurity.configureAutoLock", autoLockMinutes); }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
        await ReloadAsync();
        recoveryPhrase = "";
    });

    private async Task ReloadAsync()
    {
        images = await Gallery.LoadAsync();
        browsingSource = null;
        mediaDirectory = (await Gallery.LoadMediaStorageOptionsAsync()).MediaDirectory;
        catalogDirectory = "";
        ApplyIngestionProfile(await Gallery.LoadIngestionOptionsAsync());
        imagesById = images.ToDictionary(image => image.Id);
        UpdateDuplicateGroups();
        if (workflow == "duplicates") await LoadDuplicateThumbnailsAsync();
        settings = await Gallery.SettingsAsync();
        storageOverview = await Gallery.CachedStorageOverviewAsync();
        selected = selected is null ? null : images.SingleOrDefault(image => image.Id == selected.Id);
        if (selected is null) { preview = ""; _ = ReleaseVideoAsync(); }
        removalSelection.IntersectWith(images.Where(image => image.IsMarkedForDeletion).Select(image => image.Id));
        librarySelection.IntersectWith(images.Select(image => image.Id));
        page = Math.Min(page, PageCount - 1);
        await LoadThumbnailsAsync();
    }

    // Thumbnails decrypt in the background so the grid renders immediately with placeholders.
    // Existing previews stay visible while they are refreshed, which avoids flicker after edits.
    private Task LoadThumbnailsAsync()
    {
        var pageIds = PageImages.Select(image => image.Id).ToHashSet();
        foreach (var id in thumbnails.Keys.Where(id => !pageIds.Contains(id)).ToList()) thumbnails.Remove(id);
        staleThumbnails.Clear();
        staleThumbnails.UnionWith(pageIds);
        thumbnailFailures.Clear();
        StartThumbnailLoad();
        return Task.CompletedTask;
    }

    private Task LoadMissingThumbnailsAsync()
    {
        StartThumbnailLoad();
        return Task.CompletedTask;
    }

    private void StartThumbnailLoad()
    {
        StopThumbnailLoad();
        var ids = PendingThumbnailIds();
        if (ids.Count == 0) return;
        thumbnailLoad = new CancellationTokenSource();
        thumbnailTask = LoadThumbnailsInBackgroundAsync(ids, thumbnailLoad.Token);
    }

    private List<string> PendingThumbnailIds() => PageImages.Select(image => image.Id)
        .Where(id => (!thumbnails.ContainsKey(id) || staleThumbnails.Contains(id)) && !thumbnailFailures.Contains(id))
        .ToList();

    private void StopThumbnailLoad()
    {
        thumbnailLoad?.Cancel();
        thumbnailLoad?.Dispose();
        thumbnailLoad = null;
    }

    private async Task PauseThumbnailLoadAsync()
    {
        var running = thumbnailTask;
        StopThumbnailLoad();
        thumbnailTask = null;
        if (running is not null) await running;
    }

    private void ResumeThumbnailLoad()
    {
        if (disposed || !Gallery.IsUnlocked || thumbnailTask is { IsCompleted: false }) return;
        StartThumbnailLoad();
    }

    private async Task LoadThumbnailsInBackgroundAsync(List<string> ids, CancellationToken token)
    {
        await Task.Yield();
        var lastRender = System.Diagnostics.Stopwatch.GetTimestamp();
        var changed = false;
        foreach (var id in ids)
        {
            if (token.IsCancellationRequested || disposed || !Gallery.IsUnlocked) break;
            try
            {
                var thumbnail = await Gallery.ThumbnailAsync(id);
                if (token.IsCancellationRequested) break;
                thumbnails[id] = thumbnail;
                staleThumbnails.Remove(id);
                changed = true;
            }
            catch (Exception exception)
            {
                if (token.IsCancellationRequested || !Gallery.IsUnlocked) break;
                Logger.LogWarning(exception, "Thumbnail could not be loaded");
                thumbnailFailures.Add(id);
                staleThumbnails.Remove(id);
            }
            if (changed && System.Diagnostics.Stopwatch.GetElapsedTime(lastRender).TotalMilliseconds >= 100)
            {
                StateHasChanged();
                lastRender = System.Diagnostics.Stopwatch.GetTimestamp();
                changed = false;
            }
        }
        if (changed && !disposed) StateHasChanged();
    }

