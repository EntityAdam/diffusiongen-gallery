@implements IDisposable
@inject GalleryService Gallery
@inject ILogger<Home> Logger
@inject IJSRuntime JS
@inject OrganizationHistory OrganizationHistory
@inject ISonnerService Toasts
@using Gallery.Web.Components.Workspace
@using Gallery.Web.Components.Access

<PageTitle>DiffusionGen Gallery</PageTitle>

@if (!Gallery.IsUnlocked || !ready)
{
    <WorkspaceFeedback Activity="activity" />
    <GalleryAccess @key="accessRevision" Busy="activity.Busy" Error="@activity.Error" Message="@activity.Message"
                   ImportRunning="activity.Ingestion.IsRunning" ImportProgress="activity.Ingestion.Progress" StartWithCreate="startWithCreate"
                   RunOperation="RunAccessAsync" Unlock="UnlockAsync" Created="GalleryCreated" Restored="GalleryRestored"
                   ClearFeedback="ClearFeedback" />
}
else if (recoveryPhrase.Length > 0)
{
    <WorkspaceFeedback Activity="activity" />
    <RecoveryWords Phrase="@recoveryPhrase" Busy="activity.Busy" OnContinue="FinishSetupAsync" />
}
else if (session is { IsInitialized: true })
{
    <GalleryWorkspace @key="accessRevision" Session="session" Route="@Route" Router="Router"
                      Locked="Lock" Purged="GalleryPurged" Panic="PanicAsync" />
}
else
{
    <WorkspaceFeedback Activity="activity" />
}
