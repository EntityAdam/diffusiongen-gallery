    [JSInvokable]
    public async Task HandleGridKey(string key, string id, bool shift)
    {
        if (!Gallery.IsUnlocked || busy || !ShowsGallery || selected is not null || removalPlan.Count > 0 || viewerImages.Count > 0 || reviewGroups.Count > 0) return;
        if (key == "escape") { ClearSelection(); selectionAnchor = null; StateHasChanged(); return; }
        if (!imagesById.TryGetValue(id, out var image)) return;
        if (key == "x")
        {
            SelectCard(id, shift);
            StateHasChanged();
            return;
        }
        Func<ImageRecordEdit, ImageRecordEdit>? update = key switch
        {
            "0" or "1" or "2" or "3" or "4" or "5" => current => Gallery.SetCuration(current, key[0] - '0', null),
            "f" when !image.IsFavorite => current => current with { IsFavorite = true },
            "f" => current => current with { IsFavorite = false },
            "d" when !image.IsMarkedForDeletion => current => Gallery.SetDeletionMark(current, true),
            "d" => current => Gallery.SetDeletionMark(current, false),
            _ => null
        };
        if (update is null) return;
        var done = key switch
        {
            "f" => image.IsFavorite ? "Removed from favorites." : "Added to favorites.",
            "d" => image.IsMarkedForDeletion ? "Deletion mark cleared." : "Marked for deletion.",
            "0" => "Rating cleared.",
            _ => $"Rated {key} stars."
        };
        await RunAsync("Saving...", () => CurateAsync([id], update, $"{image.Name}: {done}"));
        StateHasChanged();
    }

