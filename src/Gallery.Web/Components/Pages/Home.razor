@page "/"
@using System.Collections.Immutable
@implements IDisposable
@inject GalleryService Gallery
@inject ILogger<Home> Logger
@inject IJSRuntime JS
@inject ISonnerService Toasts
@inject OrganizationHistory OrganizationHistory

<PageTitle>DiffusionGen Gallery</PageTitle>

@if (Gallery.IsUnlocked && error.Length > 0 && !UsesToasts)
{
    <Alert Variant="AlertVariant.Destructive" Class="mb-6 flex items-center justify-between gap-3">@error <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" OnClick="() => error = string.Empty" aria-label="Dismiss error"><XIcon aria-hidden="true" /></Button></Alert>
}
@if (Gallery.IsUnlocked && message.Length > 0 && !UsesToasts)
{
    <div class="my-4 flex items-center justify-between gap-3 rounded-lg border border-primary/25 bg-primary/5 p-4 text-sm break-words" role="status">@message</div>
}

@if (!Gallery.IsUnlocked)
{
    var knownGalleries = Gallery.KnownGalleries;
    <section class="gallery-entry @(galleryScreen == "switch" ? "gallery-entry-actions" : "gallery-entry-welcome")" aria-label="Gallery access">
        <header class="gallery-entry-brand"><SparkleIcon Size="26" ClassName="brand-mark" aria-hidden="true" /> <span>DiffusionGen Gallery</span></header>
        <div class="gallery-entry-heading">
            <h1>@(galleryScreen == "switch" ? galleryTab switch { "create" => "Create a private gallery", "open" => "Open a gallery", _ => "Restore a gallery" } : Gallery.VaultExists ? "Welcome back." : "Your private gallery.")</h1>
            <p>@(galleryScreen == "switch" ? "Encrypted media storage and backup." : "A safe space for your media.")</p>
        </div>
        @if (error.Length > 0 && !UsesToasts)
        {
            <Alert Variant="AlertVariant.Destructive" role="alert">@error</Alert>
        }
        @if (message.Length > 0 && !UsesToasts)
        {
            <p class="gallery-entry-status" role="status">@message</p>
        }
        @if (galleryScreen == "switch")
        {
            <Tabs Value="@galleryTab" ValueChanged="SetGalleryTab">
                <TabsList Class="gallery-entry-tabs" aria-label="Switch gallery actions">
                    @foreach (var tab in GalleryTabs)
                    {
                        <TabsTrigger Value="@tab.Id" disabled="@busy">@tab.Name</TabsTrigger>
                    }
                </TabsList>
            </Tabs>
            @if (galleryTab == "create")
            {
                <form class="gallery-create-form" @onsubmit="CreateGalleryAsync" @onsubmit:preventDefault>
                    <div class="gallery-entry-field">
                        <Label For="new-gallery-name">Gallery name</Label>
                        <Input id="new-gallery-name" Placeholder="Personal Gallery" @bind-Value="newGalleryName" maxlength="80" required Disabled="@busy" />
                    </div>
                    <div class="gallery-entry-field gallery-passphrase-field">
                        <Label For="secret">Passphrase</Label>
                        <Input id="secret" Type="password" @bind-Value="secret" Placeholder="Choose a passphrase" autocomplete="new-password" minlength="14" required Disabled="@busy" aria-describedby="passphrase-hint" />
                        <p id="passphrase-hint">Use at least 14 characters.</p>
                    </div>
                    <div class="gallery-entry-field">
                        <Label For="confirm">Confirm passphrase</Label>
                        <Input id="confirm" Type="password" @bind-Value="confirm" Placeholder="Enter your passphrase again" autocomplete="new-password" minlength="14" required Disabled="@busy" />
                    </div>
                    <details class="gallery-storage-options">
                        <summary><FolderIcon Size="16" ClassName="text-muted-foreground" aria-hidden="true" /><span>Storage options</span><ChevronDownIcon Size="16" ClassName="gallery-storage-chevron text-muted-foreground" aria-hidden="true" /></summary>
                        <div class="gallery-storage-fields">
                            <DirectoryPathInput Label="Gallery folder" LocalOnly="true" ShowHint="false" Placeholder="@newGalleryDirectory" @bind-Value="createGalleryDirectory" Disabled="@busy" />
                            <div class="gallery-split-storage">
                                <Switch id="split-gallery-storage" Checked="@splitGalleryStorage" CheckedChanged="SetSplitGalleryStorage" Disabled="@busy" />
                                <Label For="split-gallery-storage">Split catalog and media folder</Label>
                                <Tooltip DelayDuration="0">
                                    <TooltipTrigger><InfoIcon Size="16" ClassName="text-muted-foreground" role="img" aria-label="About split storage" /></TooltipTrigger>
                                    <TooltipContent Class="gallery-storage-tooltip">Enable the switch to specify an alternate media location. The database must be on a solid state drive, but encrypted media can be stored on another drive or NAS.</TooltipContent>
                                </Tooltip>
                            </div>
                            @if (splitGalleryStorage)
                            {
                                <DirectoryPathInput Label="Media folder" ShowHint="false" @bind-Value="newMediaDirectory" Disabled="@busy" />
                            }
                        </div>
                    </details>
                    <Button Class="gallery-entry-primary" Disabled="@busy" Type="submit">@(busy ? "Deriving encryption key..." : "Create gallery")</Button>
                </form>
            }
            else if (galleryTab == "open")
            {
                <form class="gallery-open-form" @onsubmit="UseExistingGalleryAsync" @onsubmit:preventDefault>
                    <DirectoryPathInput Label="Gallery directory" @bind-Value="existingGalleryDirectory" Disabled="@busy" />
                    <p class="text-muted-foreground">Choose an existing gallery folder containing vault.json and gallery.db.</p>
                    <Button Class="gallery-entry-primary" Disabled="@busy" Type="submit">@(busy ? "Selecting gallery..." : "Open gallery")</Button>
                </form>
            }
            else
            {
                <form class="gallery-restore-form" @onsubmit="RestoreGalleryAsync" @onsubmit:preventDefault>
                    <fieldset class="gallery-restore-section">
                        <legend>Backup</legend>
                        <Tabs Value="@restoreSourceType" ValueChanged="SetRestoreSource">
                            <TabsList Class="gallery-entry-tabs" aria-label="Backup location">
                                <TabsTrigger Value="local" disabled="@busy"><FolderIcon Size="16" ClassName="mr-2" aria-hidden="true" />Local backup</TabsTrigger>
                                <TabsTrigger Value="sas" disabled="@busy"><CloudIcon Size="16" ClassName="mr-2" aria-hidden="true" />Cloud backup</TabsTrigger>
                            </TabsList>
                        </Tabs>
                        @if (restoreSourceType == "local")
                        {
                            <DirectoryPathInput Label="Backup folder" ShowHint="false" @bind-Value="restoreSourceDirectory" @bind-Value:after="ResetRestoreBackups" Disabled="@busy" />
                        }
                        else
                        {
                            <div class="gallery-entry-field">
                                <Label For="restore-sas">Backup URL</Label>
                                <Input id="restore-sas" Type="password" @bind-Value="restoreSasUrl" @bind-Value:after="ResetRestoreBackups" autocomplete="off"
                                       Placeholder="https://account.blob.core.windows.net/container?..."
                                       pattern="https://[^/?#]+/[^/?#]+\?[^#]+" required Disabled="@busy" aria-describedby="restore-sas-hint" />
                                <p id="restore-sas-hint">Use a container SAS URL with read and list access.</p>
                            </div>
                            <details class="gallery-storage-options">
                                <summary><Settings2Icon Size="16" aria-hidden="true" /><span>Cloud options</span><ChevronDownIcon Size="16" ClassName="gallery-storage-chevron" aria-hidden="true" /></summary>
                                <div class="gallery-storage-fields">
                                    <div class="gallery-entry-field">
                                        <Label For="restore-prefix">Backup prefix (optional)</Label>
                                        <Input id="restore-prefix" @bind-Value="restoreAzurePrefix" @bind-Value:after="ResetRestoreBackups" Placeholder="nightly/gallery" Disabled="@busy" aria-describedby="restore-prefix-hint" />
                                        <p id="restore-prefix-hint">Use the prefix from your backup settings, or leave blank for the container root.</p>
                                    </div>
                                </div>
                            </details>
                        }
                        <Button Variant="ButtonVariant.Outline" Class="w-full" Type="button" Disabled="@(busy || string.IsNullOrWhiteSpace(restoreSourceType == "sas" ? restoreSasUrl : restoreSourceDirectory))" OnClick="ListRestoreBackupsAsync">Find backups</Button>
                        @if (restoreArchives.Count > 0)
                        {
                            <div class="gallery-entry-field">
                                <Label For="restore-archive">Backup archive</Label>
                                <Select id="restore-archive" @bind-Value="restoreArchive" Disabled="@busy" aria-describedby="restore-archive-hint">
                                    <option value="">Choose a backup</option>
                                    @foreach (var archive in restoreArchives) { <option value="@archive">@archive</option> }
                                </Select>
                                <p id="restore-archive-hint">Choose a full backup or the final incremental backup in its chain.</p>
                            </div>
                        }
                        else if (restoreBackupsSearched)
                        {
                            <p class="gallery-entry-status" role="status">No backups found. Check the location and try again.</p>
                        }
                    </fieldset>
                    @if (!string.IsNullOrWhiteSpace(restoreArchive))
                    {
                        <fieldset class="gallery-restore-section">
                            <legend>New gallery</legend>
                            <div class="gallery-entry-field">
                                <Label For="restored-gallery-name">Gallery name (optional)</Label>
                                <Input id="restored-gallery-name" @bind-Value="newGalleryName" Placeholder="Keep the original gallery name" maxlength="80" Disabled="@busy" />
                            </div>
                            <details class="gallery-storage-options">
                                <summary><FolderIcon Size="16" aria-hidden="true" /><span>Storage options</span><ChevronDownIcon Size="16" ClassName="gallery-storage-chevron" aria-hidden="true" /></summary>
                                <div class="gallery-storage-fields">
                                    <DirectoryPathInput Label="Gallery folder" LocalOnly="true" ShowHint="false" Placeholder="@newGalleryDirectory" @bind-Value="restoreGalleryDirectory" Disabled="@busy" />
                                    <p class="gallery-restore-hint">Use a new or empty folder on this computer’s SSD.</p>
                                </div>
                            </details>
                        </fieldset>
                        <fieldset class="gallery-restore-section">
                            <legend>Unlock backup</legend>
                            <GalleryCredentialInput Compact="true" @bind-Value="restoreCredential" @bind-UseRecovery="restoreUseRecovery" Disabled="@busy" />
                        </fieldset>
                        <Button Class="gallery-entry-primary" Type="submit" Disabled="@(busy || string.IsNullOrWhiteSpace(restoreCredential))">@(busy ? "Restoring gallery..." : "Restore gallery")</Button>
                        <p class="gallery-restore-hint">Restores into a new gallery. Your backup stays unchanged.</p>
                    }
                </form>
            }
            <button class="gallery-entry-back" type="button" disabled="@busy" @onclick="ReturnToWelcome">← Back to welcome</button>
        }
        else
        {
            @if (Gallery.VaultExists)
            {
                <Card Class="gallery-unlock-card">
                    <div class="gallery-switcher">
                        <AdvancedSelect Id="gallery-switcher" Label="Galleries" ItemLabel="gallery"
                                        Options="@knownGalleries.Select(location => location.Directory)"
                                        OptionLabels="@knownGalleries.ToDictionary(location => location.Directory, location => location.Name)"
                                        Value="@Gallery.VaultRoot" ValueChanged="SelectKnownGalleryAsync"
                                        AllowCreate="false" AllowClear="false" Disabled="@busy">
                            <LeadingIcon><FolderIcon Size="18" ClassName="text-primary" aria-hidden="true" /></LeadingIcon>
                        </AdvancedSelect>
                    </div>
                    <form class="gallery-unlock-form" @onsubmit="UnlockAsync" @onsubmit:preventDefault>
                        @if (importRunning && importProgress is not null)
                        {
                            <p class="gallery-entry-status" role="status">Ingestion is still running: @importProgress.Completed@(importProgress.Total is int lockedTotal ? $" / {lockedTotal}" : "") files processed. Unlock to follow its progress.</p>
                        }
                        <div class="gallery-entry-field">
                            <Label For="unlock-credential">@(useRecovery ? "32 recovery words" : "Passphrase")</Label>
                            @if (useRecovery)
                            {
                                <Textarea id="unlock-credential" @bind-Value="secret" Rows="4" autocomplete="off" spellcheck="false" required Disabled="@(busy && !importRunning)" />
                            }
                            else
                            {
                                <Input id="unlock-credential" autofocus Type="password" @bind-Value="secret" Placeholder="passphrase" autocomplete="current-password" minlength="14" required Disabled="@(busy && !importRunning)" />
                            }
                        </div>
                        <Button Class="gallery-entry-primary" Disabled="@(busy && !importRunning)" Type="submit">@(busy && !importRunning ? "Unlocking gallery..." : "Unlock gallery")</Button>
                        <button class="gallery-entry-link gallery-recovery-link" type="button" disabled="@(busy && !importRunning)" @onclick="ToggleWelcomeRecovery">@(useRecovery ? "Use passphrase" : "Use recovery words")</button>
                    </form>
                </Card>
            }
            else
            {
                <Card Class="gallery-unlock-card gallery-empty-card">
                    @if (Gallery.KnownGalleries.Count > 0)
                    {
                        <Label For="remembered-gallery">Choose a remembered gallery</Label>
                        <Select id="remembered-gallery" Value="" ValueChanged="SelectKnownGalleryAsync" Disabled="@busy">
                            <option value="" disabled>Select a gallery</option>
                            @foreach (var location in Gallery.KnownGalleries)
                            {
                                <option value="@location.Directory" title="@location.Directory">@location.Name</option>
                            }
                        </Select>
                    }
                    <p>Create your first gallery, open an existing library, or restore a backup.</p>
                    <Button Class="gallery-entry-primary" Disabled="@busy" OnClick="OpenGallerySwitcher">Create a gallery</Button>
                </Card>
            }
            <div class="gallery-other-libraries"><span>Looking for another library?</span><button class="gallery-entry-link" type="button" disabled="@busy" @onclick="OpenOtherGallery">Switch gallery</button></div>
            <div class="gallery-recovery-reminder">
                <p class="gallery-privacy"><LockIcon Size="15" aria-hidden="true" />Designed from the ground up with privacy in mind.</p>
                <p>Keep your recovery words safe. Without them or your passphrase, your media cannot be recovered.</p>
                <p>DiffusionGen Gallery encrypts stored media, thumbnails, catalog content, and settings to help protect your library while locked. Encryption does not protect an unlocked session or a compromised computer.</p>
            </div>
        }
    </section>
}
else if (recoveryPhrase.Length > 0)
{
    <Card Class="mb-6 p-5 md:p-6 mx-auto max-w-4xl">
        <span class="eyebrow">SAVE THIS BEFORE CONTINUING</span>
        <h2>Your recovery words.</h2>
        <p>Write these 32 words down, in order, and keep them offline in a safe place. Anyone with these words can unlock your gallery. They are shown only now.</p>
        <div class="my-6 grid grid-cols-2 gap-2 md:grid-cols-4 [&>div]:rounded-md [&>div]:border [&>div]:border-border [&>div]:bg-background [&>div]:p-3 [&>div]:font-mono [&>div]:text-xs [&_small]:text-muted-foreground">
            @foreach (var (word, index) in recoveryPhrase.Split(' ').Select((word, index) => (word, index)))
            {
                <div><small>@(index + 1).</small> @word</div>
            }
        </div>
        <div class="mt-4 flex items-start gap-3"><Checkbox id="check-recoverysaved" Class="mt-0.5" @bind-Checked="recoverySaved"  /><Label For="check-recoverysaved" Class="text-sm leading-relaxed">I saved all 32 words securely and understand there is no other recovery method.</Label></div>
        <Button Variant="ButtonVariant.Default" Size="ButtonSize.Default" Disabled="@(!recoverySaved || busy)" OnClick="FinishSetupAsync">Open my gallery <ArrowRightIcon aria-hidden="true" /></Button>
    </Card>
}
else
{
    <AppLayout Class="@($"workspace-layout {(collectionNavigationOpen ? "collection-nav-open" : "")}")" @onkeydown="HandleCollectionNavigationKey">
    <Sidebar Collapsible="true" @bind-Collapsed="sidebarCollapsed" ExpandedWidth="250px" CollapsedWidth="64px" Class="@($"workspace-sidebar {(sidebarCollapsed ? "is-collapsed" : "")}")" aria-label="Gallery workflows">
        <div class="workspace-sidebar-heading">
            <SidebarTrigger aria-expanded="@(sidebarCollapsed ? "false" : "true")" aria-label="@(sidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")" />
        </div>
        <nav class="workspace-navigation" aria-label="Gallery workflows">
        @foreach (var item in SidebarItems)
        {
            <Button Variant="@(SidebarItemActive(item.Id) ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Disabled="@SidebarItemDisabled(item.Id)" Class="workspace-nav-button" aria-label="@item.Name" title="@item.Name" aria-current="@(SidebarItemActive(item.Id) ? "page" : null)" OnClick="() => NavigateSidebarAsync(item.Id)"><LucideIcon Name="@WorkflowIcon(item.Id)" Size="16" aria-hidden="true" /><span class="sidebar-label">@item.Name</span></Button>
            @if (item.Id is "filters" or "tags" or "intelligence")
            {
                <Separator Class="my-2" Decorative="false" />
            }
        }
        </nav>
        @if (workflow is "collections" or "unorganized" && !sidebarCollapsed)
        {
            <nav class="collection-hierarchy" aria-label="Collection hierarchy"><small>COLLECTIONS</small>
            @foreach (var collection in collectionCatalog.Collections.OrderBy(item => item.Name))
            {
                <button disabled="@WorkspaceBusy" class="@(collectionLocation.CollectionId == collection.Id ? "is-current" : "")" title="@collection.Name" aria-current="@(collectionLocation.CollectionId == collection.Id && collectionLocation.SetId is null ? "page" : null)" @onclick="() => NavigateCollectionsAsync(new(collection.Id))"><span>@collection.Name</span><small>@images.Count(image => !image.IsMarkedForDeletion && collectionCatalog.Sets.Any(set => set.CollectionId == collection.Id && set.Id == image.SetId))</small></button>
                @if (collectionLocation.CollectionId == collection.Id)
                { @foreach (var set in collectionCatalog.Sets.Where(item => item.CollectionId == collection.Id).OrderBy(item => item.Order))
                  { <button disabled="@WorkspaceBusy" class="collection-hierarchy-set @(collectionLocation.SetId == set.Id ? "is-current" : "")" title="@set.Name" aria-current="@(collectionLocation.SetId == set.Id ? "page" : null)" @onclick="() => NavigateCollectionsAsync(new(collection.Id, set.Id))"><span>@set.Name</span><small>@images.Count(image => !image.IsMarkedForDeletion && image.SetId == set.Id)</small></button> } }
            }
            </nav>
        }
        <div class="workspace-sidebar-details" hidden="@sidebarCollapsed">
        @if (libraryJob.IsRunning || libraryJob.Suggestions > 0 || libraryJob.Message.Length > 0)
        {
            <div class="space-y-3 rounded-lg border border-primary/20 bg-primary/5 p-3 text-xs break-words" role="status">
                <strong>@(libraryJob.IsRunning ? "Library job running" : "Library job")</strong>
                <p>@libraryJob.Message</p>
                @if (libraryJob.Suggestions > 0) { <p>@libraryJob.Suggestions suggestions await approval</p> }
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@busy" OnClick="OpenLibraryJobAsync">Open job</Button>
                @if (libraryJob.CanStop)
                {
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" OnClick="StopLibraryJobAsync">Stop after current media item</Button>
                }
                @if (!libraryJob.IsRunning && libraryJob.Suggestions == 0)
                {
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" OnClick="DismissLibraryJob">Dismiss job status</Button>
                }
            </div>
        }
        @if (driveQueue.HasWork || driveQueue.State == DriveQueueState.Paused)
        {
            <div class="space-y-3 rounded-lg border border-primary/20 bg-primary/5 p-3 text-xs break-words" role="status" aria-live="polite" data-testid="drive-queue">
                <strong>Background file operations</strong>
                @if (driveQueue.Pending > 0 && driveQueue.State is DriveQueueState.Running or DriveQueueState.Waiting)
                {
                    <Progress Value="@DriveQueuePercent" aria-label="Background file operation progress" />
                }
                <p>@DriveQueueSummary</p>
                @if (driveQueue.Activity.Length > 0) { <p class="text-muted-foreground">@driveQueue.Activity</p> }
                @if (driveQueue.Failed > 0) { <p class="text-destructive">@driveQueue.Failed operation(s) failed. Files were left unchanged.</p> }
                <div class="flex flex-wrap gap-2">
                    @if (driveQueue.State is DriveQueueState.Paused or DriveQueueState.Faulted)
                    {
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" OnClick="ResumeDriveOperations">Resume</Button>
                    }
                    else if (driveQueue.Pending > 0)
                    {
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" OnClick="PauseDriveOperationsAsync">Pause</Button>
                    }
                    @if (driveQueue.Failed > 0)
                    {
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" OnClick="RetryDriveOperationsAsync">Retry failed</Button>
                    }
                    @if (driveQueue.Pending > 0 || driveQueue.Failed > 0)
                    {
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Default" title="Discard queued work. Files it would have changed stay on disk." OnClick="CancelDriveOperationsAsync">Cancel</Button>
                    }
                </div>
            </div>
        }
        </div>
        <div class="workspace-sidebar-actions">
            <Button Variant="@(workflow == "settings" ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Disabled="@(WorkspaceBusy || libraryJob.IsRunning)" Class="workspace-nav-button" aria-label="Settings" title="Settings" aria-current="@(workflow == "settings" ? "page" : null)" OnClick='() => SwitchWorkflowAsync("settings")'><SettingsIcon Size="16" aria-hidden="true" /><span class="sidebar-label">Settings</span></Button>
            <Button Variant="ButtonVariant.Destructive" Size="ButtonSize.Default" Type="button" Class="workspace-panic" aria-label="Panic lock gallery (Ctrl+Shift+L)" title="Panic: immediately lock gallery, release checkout, purge memory and wipe media (Ctrl+Shift+L)" OnClick="PanicAsync">
                <ShieldAlertIcon Size="16" aria-hidden="true" /><span class="sidebar-label">Panic <kbd>Ctrl+Shift+L</kbd></span>
            </Button>
        </div>
        <WorkspaceSidebarFooter />
    </Sidebar>
    <AppLayoutMain Class="workspace-main">
    <AppLayoutBody Class="workspace-body">
    @if (OrganizationHistory.Current is not null)
    {
        <div class="mb-4 flex flex-wrap items-center gap-2" aria-label="Organization actions">
            <Button Variant="ButtonVariant.Outline" Disabled="@(WorkspaceBusy || libraryJob.IsRunning || catalogPartial)" OnClick="UndoOrganizationAsync">Undo organization change</Button>
        </div>
    }
    @if (workflow is not ("gallery" or "collections" or "unorganized"))
    {
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <div><span class="eyebrow">THE COLLECTION</span><div class="mt-2 flex items-center gap-2"><h2 class="mb-0">@Workflows.Single(item => item.Id == workflow).Name</h2></div></div>
    </div>
    }

    @if (workflow == "ingest")
    {
        <Card Class="mb-6 p-5 md:p-6">
            <p class="text-muted-foreground">Load media into your secure library. It is encrypted with your passphrase, and you can optionally delete the originals.</p>
            <section class="mt-4 space-y-3" aria-labelledby="supported-media-heading">
                <h3 id="supported-media-heading">Supported Media</h3>
                <div class="flex flex-wrap items-center gap-2"><span>Images</span><Badge Variant="BadgeVariant.Secondary">PNG</Badge><Badge Variant="BadgeVariant.Secondary">JPEG</Badge><Badge Variant="BadgeVariant.Secondary">WEBP</Badge><span>Up to 50MB</span></div>
                <div class="flex flex-wrap items-center gap-2"><span>Videos</span><Badge Variant="BadgeVariant.Secondary">MP4</Badge><span>Up to 256MB</span></div>
            </section>
            <section class="mt-6 space-y-3" aria-labelledby="third-party-heading">
                <h3 id="third-party-heading">3rd party</h3>
                <p class="text-muted-foreground">3rd Party tools are required for certain features and are not bundled with the application. You will need to install them separately.</p>
                <h4>Video encoding</h4>
                <div class="flex items-center gap-2"><strong>FFMPEG</strong><Badge Class="@(Gallery.VideoToolsAvailable ? "ingest-tool-available" : "ingest-tool-unavailable")">@(Gallery.VideoToolsAvailable ? "available" : "not available")</Badge></div>
            </section>
            <h3 class="mt-6">Ingest</h3>
                <form @onsubmit="ScanImportFolderAsync" @onsubmit:preventDefault>
                    <Label For="source" Class="mt-4 mb-2 block">Ingest Media From</Label>
                    <Input id="source" @bind-Value="importPath" @bind-Value:after="ClearIngestionScan" Placeholder="C:\Pictures\Diffusion" required Disabled="@busy" />
                    <div class="mt-4 flex items-center gap-3"><button id="check-recursive" type="button" role="switch" class="review-random-toggle" aria-checked="@(recursive ? "true" : "false")" aria-labelledby="recursive-label" disabled="@busy" @onclick="ToggleImportRecursion"><span></span></button><Label id="recursive-label" For="check-recursive">Include subfolders</Label></div>
                    <div class="mt-4 flex items-center gap-3"><button id="check-recordtimings" type="button" role="switch" class="review-random-toggle" aria-checked="@(recordTimings ? "true" : "false")" aria-labelledby="record-timings-label" disabled="@busy" @onclick="() => recordTimings = !recordTimings"><span></span></button><Label id="record-timings-label" For="check-recordtimings">Save performance information</Label></div>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Class="mt-4" Disabled="@(busy || string.IsNullOrWhiteSpace(importPath))" Type="submit">Scan</Button>
                </form>
                @if (ingestionScan is not null)
                {
                    <section class="mt-4 space-y-3" aria-labelledby="ingestion-scan-heading" aria-live="polite">
                    <h4 id="ingestion-scan-heading">Scan results</h4>
                    <p>@ingestionScan.ImageCount images &middot; @ingestionScan.VideoCount videos &middot; Source file size total: @FormatIngestionBytes(ingestionScan.SourceBytes)</p>
                    <div class="flex items-center gap-3"><button id="include-images" type="button" role="switch" class="review-random-toggle" aria-checked="@(includeImages ? "true" : "false")" aria-labelledby="include-images-label" disabled="@busy" @onclick="ToggleIncludeImagesAsync"><span></span></button><Label id="include-images-label" For="include-images">Include Images</Label></div>
                    <div class="flex items-center gap-3"><button id="include-videos" type="button" role="switch" class="review-random-toggle" aria-checked="@(includeVideos ? "true" : "false")" aria-labelledby="include-videos-label" disabled="@(busy || !Gallery.VideoToolsAvailable)" @onclick="ToggleIncludeVideosAsync"><span></span></button><Label id="include-videos-label" For="include-videos">Include Videos</Label></div>
                    @if (!Gallery.VideoToolsAvailable && ingestionScan.VideoCount > 0)
                    {
                        <p class="text-muted-foreground">Install ffmpeg and ffprobe to include videos.</p>
                    }
                    <div class="flex items-center gap-3"><button id="check-deletesources" type="button" role="switch" class="review-random-toggle" aria-checked="@(deleteSources ? "true" : "false")" aria-labelledby="delete-sources-label" disabled="@busy" @onclick="ToggleSourceDeletion"><span></span></button><Label id="delete-sources-label" For="check-deletesources">Delete original media</Label></div>
                    @if (deleteSources)
                    {
                        <Alert Variant="AlertVariant.Destructive"><LucideIcon Name="triangle-alert" Size="16" aria-hidden="true" /><span>Originals will be <strong>permanently</strong> deleted after the import is verified.</span></Alert>
                    }
                    @if (ingestionSpace is not null)
                    {
                        <p>@ingestionSpace.FileCount files selected &middot; @FormatIngestionBytes(ingestionSpace.SelectedSourceBytes) source media</p>
                        <p>Available disk space: @FormatIngestionBytes(ingestionSpace.MediaAvailableBytes)</p>
                        <p>Estimated change: @FormatIngestionBytes(EstimatedIngestionChangeBytes)</p>
                        <p class="text-muted-foreground" title="Uses the encryption envelope size plus an allowance of 128 KiB per thumbnail and 4 KiB per catalog entry. Actual growth varies; duplicates may reduce it. The free-space safety check uses a separate, larger allowance before deleting originals.">Includes an <strong>estimate</strong> for encryption and thumbnails.</p>
                        @if (ingestionSpace.FileCount == 0)
                        {
                            <p role="status">No files selected. Enable a media type with scanned files, or scan another folder.</p>
                        }
                        else if (!ingestionSpace.HasEnoughSpace)
                        {
                            <Alert Variant="AlertVariant.Destructive">Not enough available disk space for the selected media and catalog growth.</Alert>
                        }
                    }
                    @if (IngestionSettingsDirty) { <p role="status">Save your changes under Advanced before ingesting media.</p> }
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@(!CanIngestScan)" OnClick="ImportFolderAsync">Ingest <ArrowRightIcon aria-hidden="true" /></Button>
                    </section>
                }
            <details class="mt-6">
                <summary>Advanced</summary>
                <div class="mt-4 space-y-3">
                    <h3>Ingestion performance</h3>
                    <Label Class="block">Performance profile</Label>
                    <div class="flex flex-wrap gap-2" role="group" aria-label="Performance profile">
                        <Button Variant="@(ingestionProfile == "hdd" ? ButtonVariant.Secondary : ButtonVariant.Outline)" aria-pressed="@(ingestionProfile == "hdd" ? "true" : "false")" Disabled="@busy" OnClick='() => ApplyIngestionProfile(IngestionOptions.Hdd, "hdd")'>HDD</Button>
                        <Button Variant="@(ingestionProfile == "ssd" ? ButtonVariant.Secondary : ButtonVariant.Outline)" aria-pressed="@(ingestionProfile == "ssd" ? "true" : "false")" Disabled="@busy" OnClick='() => ApplyIngestionProfile(IngestionOptions.Ssd, "ssd")'>SSD</Button>
                        <Button Variant="@(ingestionProfile == "custom" ? ButtonVariant.Secondary : ButtonVariant.Outline)" aria-pressed="@(ingestionProfile == "custom" ? "true" : "false")" Disabled="@busy" OnClick='() => ingestionProfile = "custom"'>Custom</Button>
                    </div>
                    <p class="text-muted-foreground">Performance settings: @ingestionWorkers workers, batch size @ingestionBatchSize.</p>
                    @if (ingestionProfile == "custom")
                    {
                        <div class="space-y-3">
                            <Label For="ingestion-workers">Workers</Label>
                            <input id="ingestion-workers" type="number" min="1" max="32" @bind="ingestionWorkers" disabled="@busy" class="h-10 rounded-md border border-input bg-background px-3" />
                            <Label For="ingestion-batch">Batch Size</Label>
                            <input id="ingestion-batch" type="number" min="1" max="64" @bind="ingestionBatchSize" disabled="@busy" class="h-10 rounded-md border border-input bg-background px-3" />
                            <p class="text-muted-foreground">Use 1-32 workers and a batch size of 1-64, at least as large as the worker count. More workers use more memory.</p>
                        </div>
                    }
                    <p class="text-muted-foreground" role="status">@(IngestionSettingsDirty ? "Unsaved changes. Save ingestion settings before ingesting media." : "Ingestion settings are saved. Changes require Save ingestion settings.")</p>
                    <Button Variant="ButtonVariant.Outline" Disabled="@(busy || !IngestionSettingsDirty)" OnClick="SaveIngestionOptionsAsync">Save ingestion settings</Button>
                </div>
            </details>
            @if (importProgress is not null)
            {
                <div class="mt-5 space-y-2" aria-busy="@(busy ? "true" : "false")">
                    <Label For="ingestion-progress" Class="mt-4 mb-2 block">Media ingestion</Label>
                    @if (importProgress.Total is int progressTotal)
                    {
                        <Progress id="ingestion-progress" Value="@(Math.Clamp((int)(100L * importProgress.Completed / Math.Max(1, progressTotal)), 0, 100))" aria-label="Media ingestion progress" />
                    }
                    else
                    {
                        <div id="ingestion-progress" class="flex items-center gap-2 text-primary" role="status"><LoaderCircleIcon Size="16" ClassName="animate-spin" aria-hidden="true" />Discovering files...</div>
                    }
                    <p class="text-muted-foreground">
                        @if (importProgress.Total is int total)
                        {
                            <span>@importProgress.Completed / @total files processed &middot; @importProgress.Imported imported &middot; @importProgress.Failed reported issues</span>
                        }
                    </p>
                    <p role="status">@importProgress.Status</p>
                </div>
            }
            @if (importFailures.Count > 0)
            {
                <details open class="text-destructive"><summary>@importFailures.Count file(s) reported issues</summary>
                    @foreach (var failure in importFailures) { <p>@failure</p> }
                </details>
            }
            @if (timingReport is not null)
            {
                <details open class="mt-4"><summary>Performance timings</summary>
                    <p class="text-sm text-muted-foreground">Also written to the application log. Contains no file or folder names.</p>
                    <pre class="mt-2 overflow-x-auto rounded-md bg-muted p-3 text-xs">@timingReport</pre>
                </details>
            }
        </Card>
    }
    @if (workflow == "settings")
    {
        <Tabs Value="@settingsTab" ValueChanged="SwitchSettingsTabAsync" Class="mb-4">
            <TabsList Class="h-auto max-w-full flex-wrap justify-start gap-1" aria-label="Settings sections">
                @foreach (var tab in SettingsTabs)
                {
                    <TabsTrigger Value="@tab.Id" disabled="@busy">@tab.Name</TabsTrigger>
                }
            </TabsList>
        </Tabs>
    }
    @if (workflow == "settings" && settingsTab == "overview")
    {
        <Card Class="mb-6 p-5 md:p-6 storage-overview" aria-labelledby="storage-overview-title" aria-busy="@(refreshingStorageOverview ? "true" : "false")">
            <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
                <h3 id="storage-overview-title">Gallery overview</h3>
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="button" Disabled="@(busy || catalogPartial)" OnClick="RefreshStorageOverviewAsync">
                    @if (refreshingStorageOverview) { <LoaderCircleIcon Size="16" ClassName="animate-spin" aria-hidden="true" /> }
                    @(refreshingStorageOverview ? "Refreshing..." : "Refresh")
                </Button>
            </div>
            @if (refreshingStorageOverview)
            {
                <p class="text-muted-foreground" role="status">Refreshing gallery overview...</p>
            }
            @if (storageOverview is null)
            {
                <p class="text-muted-foreground">Storage has not been measured yet. Select Refresh to calculate it.</p>
            }
            else
            {
                <dl class="my-4 grid grid-cols-1 gap-3 lg:grid-cols-3 [&>div]:min-w-0 [&>div]:rounded-lg [&>div]:border [&>div]:border-border [&>div]:p-4 [&_dt]:text-xs [&_dt]:uppercase [&_dt]:text-muted-foreground [&_dd]:my-2 [&_dd]:text-2xl [&_dd]:text-primary [&_dd]:break-all [&_span]:text-xs">
                    <div><dt>Database size</dt><dd data-testid="database-size">@GalleryService.FormatBytes(storageOverview.DatabaseBytes)</dd><span class="text-muted-foreground">gallery.db with WAL files, including thumbnails</span></div>
                    <div><dt>Total file count</dt><dd data-testid="file-count">@storageOverview.TotalFileCount.ToString("N0")</dd><span class="text-muted-foreground">@storageOverview.ImageFileCount.ToString("N0") encrypted media files + @storageOverview.VaultFileCount gallery files</span></div>
                    <div><dt>Total size on disk</dt><dd data-testid="total-size">@GalleryService.FormatBytes(storageOverview.TotalBytes)</dd><span class="text-muted-foreground">@GalleryService.FormatBytes(storageOverview.ImageBytes) of encrypted media</span></div>
                </dl>
                @if (storageOverview.MissingImageFiles > 0)
                {
                    <Alert Variant="AlertVariant.Destructive">@storageOverview.MissingImageFiles catalogued media file(s) were not found on disk and are not counted.</Alert>
                }
                @if (storageOverview.IsIndexPending)
                {
                    <p class="text-muted-foreground" data-testid="index-pending">The file index is still being built in the background; some sizes were measured directly. Refresh once background file operations finish.</p>
                }
                <StorageOverviewStatus Overview="@storageOverview" />
            }
            <p class="text-muted-foreground flex flex-wrap items-center gap-2">
                <span>Sizes come from a cached file index. Rebuild it if files were changed outside the gallery.</span>
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Default" Type="button" Class="h-auto px-0" Disabled="@(busy || catalogPartial)" OnClick="RebuildStorageIndexAsync">Rebuild file index</Button>
            </p>
            <p class="text-muted-foreground flex flex-wrap items-center gap-2">
                @if (duplicateScan is null) { <span>Duplicates have not been scanned yet.</span> }
                else { <span>Last duplicate scan found @VisibleDuplicateGroups.Sum(group => group.ImageIds.Length - 1).ToString("N0") likely duplicate(s), about @GalleryService.FormatBytes(VisibleDuplicateGroups.Sum(group => group.ReclaimableBytes)) reclaimable.</span> }
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Default" Type="button" Class="h-auto px-0" Disabled="@busy" OnClick='() => SwitchWorkflowAsync("duplicates")'>Find duplicates <ArrowRightIcon aria-hidden="true" /></Button>
            </p>
        </Card>
    }
    @if (workflow == "settings" && settingsTab == "gallery")
    {
        <Card Class="mb-6 p-5 md:p-6 space-y-4">
            <h3>Manage gallery</h3>
            <p><strong>@Gallery.VaultName</strong></p><p class="break-all text-muted-foreground">@Gallery.VaultRoot</p>
            @if (Gallery.CatalogIsOnNetworkDrive)
            {
                <Alert Variant="AlertVariant.Destructive">This legacy catalog is on network storage and uses rollback journaling, not WAL. Relocate it to a local directory below; media can stay on the NAS.</Alert>
            }
            <DirectoryPathInput Label="Local catalog directory (new or empty)" LocalOnly="true" @bind-Value="catalogDirectory" Disabled="@busy" />
            <p class="text-muted-foreground">Relocates only gallery.db and vault.json. Existing encrypted media stays at its current paths. Sign in again after relocating; new imports keep using the current media directory.</p>
            <Button Variant="ButtonVariant.Outline" Disabled="@(busy || libraryJob.IsRunning || string.IsNullOrWhiteSpace(catalogDirectory))" OnClick="RelocateCatalogAsync">Relocate catalog only</Button>
            <DirectoryPathInput Label="Encrypted media directory for future imports (optional, local or NAS/SMB)" @bind-Value="mediaDirectory" Disabled="@busy" />
            <p class="text-muted-foreground">Leave blank to use the local catalog directory. Choose an existing folder otherwise. Changing this does not move existing files; backups still include them.</p>
            <Button Variant="ButtonVariant.Outline" Disabled="@busy" OnClick="SaveMediaStorageAsync">Save media location</Button>
            <Label For="rename-gallery" Class="mt-4 mb-2 block">Gallery name</Label>
            <Input id="rename-gallery" @bind-Value="galleryRename" maxlength="80" Disabled="@busy" />
            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="button" Disabled="@busy" OnClick="RenameGalleryAsync">Rename</Button>
            <DirectoryPathInput Label="Move whole gallery to a new or empty local folder" LocalOnly="true" @bind-Value="moveGalleryDirectory" Disabled="@busy" />
            <p class="text-muted-foreground">Moves the catalog and all encrypted media, including media stored outside the gallery. The destination is verified before source files are removed. Sign in again after moving.</p>
            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="button" Disabled="@(busy || libraryJob.IsRunning)" OnClick="MoveGalleryAsync">Move gallery</Button>
            <Alert Variant="AlertVariant.Destructive">Purge permanently destroys all media and gallery data, including encrypted media stored outside this folder. Original source files and backups are not deleted. This is not secure disk erasure.</Alert>
            <Label For="purge-gallery" Class="mt-4 mb-2 block">Type PURGE to confirm</Label>
            <Input id="purge-gallery" @bind-Value="purgeConfirmation" autocomplete="off" Disabled="@busy" />
            <Button Variant="ButtonVariant.Destructive" Size="ButtonSize.Default" Type="button" Disabled="@(busy || libraryJob.IsRunning || purgeConfirmation != "PURGE")" OnClick="PurgeGalleryAsync">Purge gallery</Button>
        </Card>
    }
    @if (workflow == "duplicates")
    {
        <Card Class="mb-6 p-5 md:p-6 duplicates" aria-labelledby="duplicates-title">
            <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
                <h3 id="duplicates-title">Duplicate finder</h3>
                <Button Variant="ButtonVariant.Default" Size="ButtonSize.Default" Type="button" Disabled="@busy" OnClick="ScanDuplicatesAsync">@(duplicateScan is null ? "Scan for duplicates" : "Scan again")</Button>
            </div>
            <p class="text-muted-foreground">Compares a perceptual fingerprint of each encrypted thumbnail, so resized or re-encoded copies are found too. Fingerprints stay encrypted in the gallery and only changed media are re-hashed. Nothing is deleted here: extra copies are marked for deletion and removed from <em>Trash</em>.</p>
            @if (busy && progress.StartsWith("Scanning")) { <p class="flex items-center gap-2 pb-4 text-primary" role="status"><span class="status-dot"></span> @progress</p> }
            @if (duplicateScan is not null)
            {
                var groups = VisibleDuplicateGroups;
                var pendingMarks = groups.Sum(group => group.ImageIds.Count(id => id != KeeperOf(group).Id && !ImageById(id)!.IsMarkedForDeletion));
                <div class="my-4 flex flex-col gap-2">
                    <span><strong>@groups.Count</strong> group(s) &middot; <strong>@groups.Sum(group => group.ImageIds.Length - 1)</strong> extra copies &middot; <strong>@GalleryService.FormatBytes(groups.Sum(group => group.ReclaimableBytes))</strong> reclaimable</span>
                    <span class="text-muted-foreground">Scanned @duplicateScan.ScannedCount.ToString("N0") media items <time datetime="@duplicateScan.ScannedAt.ToString("O")">@duplicateScan.ScannedAt.ToLocalTime().ToString("g")</time></span>
                    <div class="flex flex-wrap items-center gap-2">
                        <Button Variant="ButtonVariant.Default" Size="ButtonSize.Default" Type="button" Disabled="@(busy || groups.Count == 0)" OnClick="() => OpenDuplicateReview(groups, 0)">Review in full screen</Button>
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="button" Disabled="@(busy || pendingMarks == 0)" OnClick="() => MarkDuplicatesAsync(groups)">Mark all extra copies (@pendingMarks)</Button>
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="button" Disabled="@busy" OnClick="OpenTrashAsync">Go to Trash</Button>
                    </div>
                </div>
                @if (groups.Count == 0) { <p class="text-muted-foreground">No likely duplicates found.</p> }
                @foreach (var (group, groupNumber) in groups.Take(DuplicateGroupsShown).Select((group, index) => (group, index)))
                {
                    var keeper = KeeperOf(group);
                    var groupMarks = group.ImageIds.Count(id => id != keeper.Id && !ImageById(id)!.IsMarkedForDeletion);
                    <article class="mt-4 rounded-xl border border-border p-4 [&>header]:mb-3 [&>header]:flex [&>header]:flex-wrap [&>header]:items-center [&>header]:justify-between [&>header]:gap-3 [&>header]:text-sm" @key="group.ImageIds[0]">
                        <header>
                            <span>@(group.IsExact ? "Exact copies" : $"Similar media (difference {group.MaxDistance}/64)") &middot; @GalleryService.FormatBytes(group.ReclaimableBytes) reclaimable</span>
                            <div class="flex flex-wrap items-center gap-2">
                                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="button" Disabled="@busy" OnClick="() => OpenDuplicateReview(groups, groupNumber)">Review &amp; choose keepers</Button>
                                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="button" Disabled="@(busy || groupMarks == 0)" OnClick="() => MarkDuplicatesAsync([group])">@(groupMarks == 0 ? "Extra copies marked" : $"Mark {groupMarks} other(s) for deletion")</Button>
                            </div>
                        </header>
                        <div class="duplicate-items grid grid-cols-[repeat(auto-fill,minmax(150px,1fr))] gap-3 [&_figure]:min-w-0 [&_figure]:overflow-hidden [&_figure]:rounded-lg [&_figure]:border [&_figure]:border-border [&_figure]:bg-background [&_img]:aspect-square [&_img]:w-full [&_img]:object-contain [&_figcaption]:flex [&_figcaption]:flex-col [&_figcaption]:gap-1 [&_figcaption]:p-3 [&_figcaption]:text-xs [&_strong]:truncate [&_figcaption>span]:text-muted-foreground">
                            @foreach (var id in group.ImageIds.OrderByDescending(id => id == keeper.Id))
                            {
                                var image = ImageById(id)!;
                                <figure class="@(id == keeper.Id ? "keep" : "") @(image.IsMarkedForDeletion ? "marked" : "")">
                                    @if (duplicateThumbnails.TryGetValue(id, out var thumbnail)) { <img src="@thumbnail" alt="@image.Name" draggable="false" /> }
                                    else { <div class="grid h-full place-items-center text-xs text-muted-foreground">Preview</div> }
                                    <figcaption>
                                        <strong title="@image.Name">@image.Name</strong>
                                        <span>@image.Width &times; @image.Height &middot; @GalleryService.FormatBytes(image.OriginalBytes)@(image.Rating > 0 ? $" · {image.Rating}★" : "")@(image.IsFavorite ? " · Favorite" : "")</span>
                                        @if (id == keeper.Id) { <Badge Variant="BadgeVariant.Secondary" Class="self-start">Keep</Badge> }
                                        else if (image.IsMarkedForDeletion) { <Badge Variant="BadgeVariant.Destructive" Class="self-start">Marked</Badge> }
                                    </figcaption>
                                </figure>
                            }
                        </div>
                    </article>
                }
                @if (groups.Count > DuplicateGroupsShown)
                {
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="button" Disabled="@busy" OnClick="ShowMoreDuplicatesAsync">Show more groups (@(groups.Count - DuplicateGroupsShown) remaining)</Button>
                }
            }
        </Card>
    }
    @if (workflow == "settings" && settingsTab == "endpoints")
    {
        <LlmEndpointSettings @ref="llmEndpointSettings" KnownTags="AllTags" SavedSettings="settings" Saved="value => settings = value" />
    }
    @if (workflow == "tags")
    {
        <TagManagement Changed="TagsManagedAsync" View="ViewTagAsync" ViewDisabled="@(WorkspaceBusy || catalogPartial)" />
    }
    @if (workflow == "settings" && settingsTab == "tags")
    {
        <TagCsvSettings Changed="ReloadAsync" />
    }
    @if (workflow == "settings" && settingsTab == "backups")
    {
        <Card Class="mb-6 p-5 md:p-6 space-y-4" aria-labelledby="backup-settings-title">
            <div class="mb-4 flex flex-wrap items-center justify-between gap-3"><h3 id="backup-settings-title">Gallery backups</h3></div>
            <p class="text-muted-foreground">Backups contain the gallery header, a consistent database snapshot, and encrypted media. Incremental backups include a fresh database snapshot and only changed media; keep the full backup and every later incremental archive in the chain.</p>
            <BackupLocation @bind-Type="backupDestinationType" @bind-LocalDirectory="backupLocalDirectory"
                @bind-Container="backupAzureContainer" @bind-Prefix="backupAzurePrefix"
                @bind-ConnectionString="backupAzureConnectionString" HasSavedCredentials="@(backupOptions?.HasAzureCredentials == true)" Disabled="@busy" />
            <p class="text-muted-foreground" role="status">@(BackupSettingsDirty ? "Unsaved changes. Save destination to apply them." : "Destination settings are saved. Changes require Save destination.")</p>
            <div class="flex flex-wrap items-center gap-2">
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="button" Disabled="@busy" OnClick="SaveBackupOptionsAsync">Save destination</Button>
                <Button Variant="ButtonVariant.Default" Size="ButtonSize.Default" Type="button" Disabled="@(busy || !BackupDestinationReady)" OnClick="CreateFullBackupAsync">Create full backup</Button>
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="button" Disabled="@(busy || !BackupDestinationReady || backupOptions?.LastBackupName is null)" OnClick="CreateIncrementalBackupAsync">Create incremental backup</Button>
            </div>
            @if (backupOptions?.LastBackupName is { } lastBackup)
            {
                <p class="text-muted-foreground">Last successful @backupOptions.LastBackupType backup: <code>@lastBackup</code></p>
            }
            <p class="text-muted-foreground">A full backup starts a new chain. Incremental backups require the previous archive to remain in the same destination. No backup is deleted automatically.</p>
        </Card>
    }
    @if (workflow == "settings" && settingsTab == "security")
    {
        <Card Class="mb-6 p-5 md:p-6 space-y-4">
            <h3>Gallery security</h3>
            <div class="space-y-4 rounded-lg border border-border bg-background p-4">
                <h4>Inactivity auto-lock</h4>
                <p class="text-muted-foreground">Saves automatically when you choose a timer.</p>
                <p class="text-muted-foreground">Automatically drop encryption keys from memory and lock the gallery when no mouse, keyboard or touch activity is detected. Locking also releases the gallery checkout after active work finishes.</p>
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
                    <Label For="auto-lock" Class="mt-4 mb-2 block">Auto-lock timer</Label>
                    <Select id="auto-lock" Value="@autoLockMinutes.ToString()" ValueChanged="UpdateAutoLockMinutesAsync" Disabled="@busy" Class="min-w-0 flex-1">
                        <option value="0">Disabled (never lock automatically)</option>
                        <option value="5">5 minutes</option>
                        <option value="15">15 minutes (default)</option>
                        <option value="30">30 minutes</option>
                        <option value="60">60 minutes (1 hour)</option>
                    </Select>
                </div>
                <p class="text-muted-foreground">
                    @(autoLockMinutes == 0
                        ? "Auto-lock is currently disabled. The gallery remains unlocked until manually locked or closed."
                        : $"The gallery will automatically lock after {autoLockMinutes} minutes of inactivity.")
                </p>
            </div>

            <div class="space-y-4 rounded-lg border border-border bg-background p-4">
                <h4>Panic / Emergency quick-lock</h4>
                <p class="text-muted-foreground">Press <kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>L</kbd> (or <kbd>Alt</kbd>+<kbd>Shift</kbd>+<kbd>L</kbd>, or <kbd>Shift</kbd>+<kbd>Esc</kbd>) anywhere in the application to instantly lock the gallery, release its checkout after active work finishes, zero-out keys in RAM, revoke media blob URLs, and clear browser caches.</p>
                <Button Variant="ButtonVariant.Destructive" Size="ButtonSize.Default" Type="button" Disabled="@busy" OnClick="PanicAsync">Trigger panic lock now</Button>
            </div>

            <div class="space-y-4 rounded-lg border border-border bg-background p-4">
                <h4>Passphrase</h4>
                <form @onsubmit="ChangePassphraseAsync" @onsubmit:preventDefault>
                    <Label For="new-passphrase" Class="mt-4 mb-2 block">New passphrase</Label>
                    <Input id="new-passphrase" Type="password" @bind-Value="newPassphrase" minlength="14" autocomplete="off" required />
                    <Label For="new-confirm" Class="mt-4 mb-2 block">Confirm new passphrase</Label>
                    <Input id="new-confirm" Type="password" @bind-Value="newConfirm" minlength="14" autocomplete="off" required />
                    <p class="text-muted-foreground">Use this after unlocking with recovery words. Your recovery words remain unchanged. Back up the gallery header, database, and all encrypted media together.</p>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@busy" Type="submit">Change passphrase</Button>
                </form>
            </div>
        </Card>
    }

    @if (workflow is "collections" or "unorganized")
    {
        @if (catalogPartial) { <div class="collection-empty" role="status"><p>Loading the full collection library…</p>@if (catalogLoadError.Length > 0) { <p role="alert">@catalogLoadError</p><Button OnClick="RetryCatalogLoadAsync">Retry</Button> }</div> }
        else {
            <Button Variant="ButtonVariant.Outline" Class="collection-navigation-toggle" aria-label="Show collection navigation" aria-expanded="@(collectionNavigationOpen ? "true" : "false")" OnClick="ToggleCollectionNavigation">Collections navigation</Button>
            @if (collectionNavigationOpen) { <button class="collection-nav-backdrop" aria-label="Close collection navigation" @onclick="CloseCollectionNavigation"></button> }
            <CollectionsWorkspace Disabled="@busy" @ref="collectionsWorkspace" Catalog="collectionCatalog" Images="images" KnownTags="AllTags" Location="collectionLocation" LocationChanged="CollectionLocationChangedAsync" Reload="ReloadCollectionsAsync" ImageChanged="ViewerImageChanged" BusyChanged="value => collectionWorking = value" Open="OpenCollectionDetailsAsync" BackToGallery='() => SwitchWorkflowAsync("gallery")' /> }
    }
    @if (workflow == "gallery")
    {
    <div class="gallery-layout grid min-w-0 grid-cols-1" data-has-selection="@((librarySelection.Count > 0 || removalSelection.Count > 0) ? "true" : "false")">
        <section aria-label="@(TrashActive ? "Trash" : "Gallery")">
            @if (catalogPartial)
            {
                <div class="mb-4 flex flex-wrap items-center gap-2 text-sm text-muted-foreground" role="status" data-testid="catalog-loading">
                    @if (catalogLoading) { <LoaderCircleIcon Size="16" ClassName="animate-spin" aria-hidden="true" /> }
                    <span>Showing the initial page. Full-library search, filters and counts are @(catalogLoading ? "loading in the background" : "not ready yet").</span>
                    @if (catalogLoadError.Length > 0)
                    {
                        <span>@catalogLoadError</span>
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="RetryCatalogLoadAsync">Retry loading library</Button>
                    }
                </div>
            }
            @if (Filtered.Count > 0)
            {
                <div class="image-grid density-@density">
                    @{ PromptGroup? previousGroup = null; DiffusionModelGroup? previousModelGroup = null; var firstOnPage = true; }
                    @foreach (var image in PageImages)
                    {
                        var isSelected = (TrashActive ? removalSelection : librarySelection).Contains(image.Id);
                        if (grouping == "prompt" && promptGroupOf.TryGetValue(image.Id, out var group) && !ReferenceEquals(group, previousGroup))
                        {
                            var continued = firstOnPage && group.Images[0].Id != image.Id;
                            previousGroup = group;
                            <div class="col-span-full rounded-md border-l-2 border-primary bg-primary/5 px-4 py-3" @key="@("group-" + image.Id)">
                                @if (group.Kind == PromptGroup.Shared)
                                {
                                    var sample = group.Images[0].Generation;
                                    <div class="flex flex-wrap items-center gap-3 text-sm">
                                        <strong>@group.Images.Length share this prompt@(continued ? " (continued)" : "")</strong>
                                        @if (sample is not null) { <span class="text-muted-foreground">@GenerationSummary(sample)</span> }
                                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Default" Type="button" Class="h-auto px-0" Disabled="@busy" OnClick="() => ShowPromptAsync(group.Prompt)">Show only these</Button>
                                    </div>
                                    <p class="max-h-40 overflow-auto text-sm whitespace-pre-wrap break-words" title="@group.Prompt">@group.Prompt</p>
                                }
                                else
                                {
                                    <div class="flex flex-wrap items-center gap-3 text-sm"><strong>@(group.Kind == PromptGroup.Unique ? "Unique prompts" : "No ComfyUI prompt found") (@group.Images.Length)@(continued ? " (continued)" : "")</strong></div>
                                }
                            </div>
                        }
                        else if (grouping == "model" && diffusionModelGroupOf.TryGetValue(image.Id, out var modelGroup) && !ReferenceEquals(modelGroup, previousModelGroup))
                        {
                            var continued = firstOnPage && modelGroup.Images[0].Id != image.Id;
                            previousModelGroup = modelGroup;
                            <div class="col-span-full rounded-md border-l-2 border-primary bg-primary/5 px-4 py-3" @key="@("model-group-" + image.Id)">
                                <strong>@(modelGroup.Model.Length == 0 ? "No diffusion model recorded" : modelGroup.Model) (@modelGroup.Images.Length)@(continued ? " (continued)" : "")</strong>
                            </div>
                        }
                        firstOnPage = false;
                        <GalleryImageCard @key="image.Id" Image="image" Thumbnail="@thumbnails.GetValueOrDefault(image.Id)" ThumbnailFailed="@thumbnailFailures.Contains(image.Id)"
                                          Busy="busy" Selected="isSelected" ShowSelection="true"
                                          Select="args => SelectCard(image.Id, args.ShiftKey)" Open="() => OpenAsync(image)"
                                          Rate="value => RateImageAsync(image, value)" Favorite="() => FavoriteAsync(image)"
                                          Mark="() => MarkAsync(image)"
                                          HasSuggestion="@aiSuggestions.ContainsKey(image.Id)" ReviewSuggestion="() => OpenViewer(image.Id)" />
                    }
                </div>
                <div class="mt-6 flex items-center justify-between gap-3 text-sm text-muted-foreground">
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@(page == 0 || busy)" OnClick="PreviousAsync"><ChevronLeftIcon aria-hidden="true" />Previous</Button>
                    <span>@if (catalogPartial) { <text>Initial page · library loading</text> } else { <text>Page @(page + 1) of @PageCount</text> }</span>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@(catalogPartial || page + 1 >= PageCount || busy)" OnClick="NextAsync">Next <ArrowRightIcon aria-hidden="true" /></Button>
                </div>
            }
        </section>
    </div>
    }
    </AppLayoutBody>
    </AppLayoutMain>
    </AppLayout>

    <GalleryToolbox @ref="toolbox" Visible="@(toolboxVisible && workflow == "gallery" && selected is null && removalPlan.Count == 0)" ActiveTool="@activeTool" ActiveToolChanged="SetActiveToolAsync"
                    CatalogLoading="catalogPartial" Close="ToggleToolboxAsync" Moved="ToolboxMovedAsync" X="toolboxX" Y="toolboxY" Badge="ToolBadge">
        @if (activeTool == "views")
        {
            <div class="space-y-4">
                <div class="space-y-2">
                    <Label>Thumbnail size</Label>
                    <Tabs Value="@density" ValueChanged="SetDensityAsync">
                        <TabsList aria-label="Thumbnail size">
                            @foreach (var option in UiPreferences.Densities)
                            {
                                <TabsTrigger Value="@option" disabled="@busy">@(char.ToUpperInvariant(option[0]) + option[1..])</TabsTrigger>
                            }
                        </TabsList>
                    </Tabs>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-2">
                        <Label For="view-grouping">Grouping</Label>
                        <Select id="view-grouping" Disabled="@(busy || catalogPartial)" Class="w-full" @bind-Value="grouping" @bind-Value:after="FilterChangedAsync">
                            <option value="none">No grouping</option><option value="prompt">Same prompt</option><option value="model">Diffusion model</option>
                        </Select>
                    </div>
                    <div class="space-y-2">
                        <Label For="view-sorting">Sorting</Label>
                        <Select id="view-sorting" Disabled="@(busy || catalogPartial)" Class="w-full" @bind-Value:get="filter.Sort" @bind-Value:set="SetSort">
                            <option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="name">Name A-Z</option><option value="size">Largest first</option><option value="rating">Highest rated</option>
                        </Select>
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Disabled="@(busy || !PageImages.Any())" OnClick="() => OpenViewer()"><MaximizeIcon aria-hidden="true" />Full screen view</Button>
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" OnClick="ResetToolboxPositionAsync" title="Move the toolbox back to its default place (Shift+`)"><LocateFixedIcon aria-hidden="true" />Reset toolbox position</Button>
                </div>
            </div>
        }
        @if (catalogPartial && activeTool is "review" or "organize" or "intelligence")
        {
            <p class="text-muted-foreground" role="status">This tool will be available when the full library finishes loading.</p>
        }
        @if (activeTool == "review" && !catalogPartial)
        {
            <div class="review-intro space-y-4">
                <p class="text-muted-foreground text-sm">Review media one item at a time. Mark your favorites, rate your media, or send your junk to the heap. Set your goal and start the review, keep it fresh with random mode.</p>
                <div class="flex items-center gap-3">
                    <button id="review-random-order" type="button" role="switch" class="review-random-toggle" aria-checked="@(reviewRandomOrder ? "true" : "false")"
                            aria-labelledby="review-random-order-label" disabled="@busy" @onclick="() => reviewRandomOrder = !reviewRandomOrder"><span></span></button>
                    <Label id="review-random-order-label" For="review-random-order">Random order</Label>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    <Label For="review-goal">Goal:</Label>
                    <input id="review-goal" type="number" min="@(ReviewPoolCount > 0 ? 1 : 0)" max="@ReviewPoolCount" step="1"
                           class="review-goal-input" disabled="@(busy || ReviewPoolCount == 0)" @bind="ReviewGoal" />
                    <Button Variant="ButtonVariant.Default" Size="ButtonSize.Sm" Disabled="@(busy || ReviewPoolCount == 0)" OnClick="StartReview">Start Review</Button>
                </div>
                <p class="text-muted-foreground text-sm">@ReviewPoolCount of the filtered media items await review.</p>
            </div>
        }
        @if (activeTool == "trash")
        {
            <div class="space-y-3">
                <p class="text-muted-foreground text-sm">Showing media marked for deletion. Select with X or the check mark, then delete forever or restore.</p>
                <div class="flex flex-wrap items-center justify-between gap-2 text-sm">
                    <strong>@removalSelection.Count selected</strong>
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Disabled="@(busy || removalSelection.Count == 0)" OnClick="ClearSelection">Clear selection <kbd>Esc</kbd></Button>
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <Button Variant="ButtonVariant.Destructive" Size="ButtonSize.Sm" Disabled="@(busy || removalSelection.Count == 0)" OnClick="PrepareBulkRemovalAsync"><TrashIcon aria-hidden="true" />Delete Forever</Button>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Disabled="@(busy || removalSelection.Count == 0)" OnClick="() => MarkRemovalSelectionAsync(false)"><RotateCcwIcon aria-hidden="true" />Restore</Button>
                </div>
                @if (removalResults.Count > 0)
                {
                    <details open><summary>Removal results: @removalResults.Count(result => result.WasRemoved) removed, @removalResults.Count(result => result.Error is not null) reported issues</summary>
                        @foreach (var result in removalResults)
                        {
                            <p class="break-all text-muted-foreground">@result.Id: @(result.WasRemoved ? "Removed" : "Retained"). @result.Error @(result.RestoredPath is null ? "" : $"Restored copy to {result.RestoredPath}")</p>
                        }
                    </details>
                }
            </div>
        }
        <LibraryWorkbench KnownTags="AllTags" @ref="workbench" Visible="@(!catalogPartial && activeTool is "organize" or "intelligence")" Workflow="@activeTool" Images="images" SelectedIds="librarySelection"
                          Filter="filter" Changed="ReloadAsync" ClearSelection="ClearSelection" JobChanged="LibraryJobChanged"
                          SuggestionsChanged="SuggestionsChanged" />
    </GalleryToolbox>

    @if (activeTool == "filters" && workflow == "gallery" && selected is null && removalPlan.Count == 0)
    {
        <aside id="@GalleryToolbox.FilterDrawerId" class="gallery-filter-drawer" aria-labelledby="gallery-filter-drawer-title">
            <div class="gallery-filter-drawer-header">
                <h2 id="gallery-filter-drawer-title" class="sr-only">Filters</h2>
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Disabled="busy" OnClick='() => SetActiveToolAsync("")' aria-label="Close filters"><XIcon aria-hidden="true" /></Button>
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" OnClick="ResetFilters" Disabled="@(busy || catalogPartial)">Reset filters</Button>
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="BeginSaveQuickFilter" Disabled="@(busy || catalogPartial || GalleryFilterPanel.CountChanged(filter) == 0)"><BookmarkPlusIcon Size="16" aria-hidden="true" />Save quick filter</Button>
            </div>
            @if (catalogPartial)
            {
                <p class="p-4 text-muted-foreground" role="status">Filters will be available when the full library finishes loading.</p>
            }
            else
            {
                <GalleryFilterPanel KnownTags="AllTags" Filter="filter" Images="images" ResultCount="Filtered.Count" Changed="ApplyFilterPanelAsync" QuickFilters="quickFilters" Disabled="busy" ResetVersion="filterInputRevision" />
            }
        </aside>
    }

    @if (quickFilterSnapshot is not null)
    {
        <ModalDialog LabelledBy="save-quick-filter-title" Busy="@busy" Close="CloseQuickFilterDialog">
            <Card Class="mx-auto w-full max-w-lg p-5">
                <h2 id="save-quick-filter-title">Save quick filter</h2>
                <form @onsubmit="SaveQuickFilterAsync" @onsubmit:preventDefault>
                    <Label For="quick-filter-name" Class="mb-2 block">Name</Label>
                    <Input id="quick-filter-name" @bind-Value="quickFilterName" Placeholder="My favorite portraits" maxlength="80" required autofocus Disabled="@busy" />
                    @if (ReplacesQuickFilter) { <p class="mt-3 text-sm text-muted-foreground">This replaces the existing quick filter with the same name.</p> }
                    <div class="mt-4 flex justify-end gap-2">
                        <Button Variant="ButtonVariant.Outline" Type="button" Disabled="@busy" OnClick="CloseQuickFilterDialog">Cancel</Button>
                        <Button Type="submit" Disabled="@(busy || string.IsNullOrWhiteSpace(quickFilterName))">@(ReplacesQuickFilter ? "Replace quick filter" : "Save quick filter")</Button>
                    </div>
                </form>
            </Card>
        </ModalDialog>
    }

    @if (selected is not null)
    {
        <ModalDialog Class="image-detail-overlay" LabelledBy="detail-title" Busy="@busy" Close="RequestCloseDetailAsync">
            <Card Class="image-detail-dialog mx-auto w-full max-w-6xl shadow-2xl mb-6 p-5 md:p-6">
                <div class="mb-4 flex flex-wrap items-center justify-between gap-3"><h2 id="detail-title" class="min-w-0 flex-1 break-words">@selected.Name</h2><Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Disabled="@busy" OnClick="RequestCloseDetailAsync" aria-label="Close media details"><XIcon aria-hidden="true" /></Button></div>
                <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1.2fr_1fr]">
                    <ImageDetailPreview Image="selected" Preview="@preview" VideoUrl="@videoUrl" Busy="busy"
                                        Download="() => ExportAsync(selected)" Fullscreen="RequestDetailViewerAsync"
                                        Rate="value => RateImageAsync(selected, value)" Favorite="() => FavoriteAsync(selected)"
                                        Mark="() => MarkAsync(selected)" />
                    <div class="min-w-0 space-y-4">
                        <ImageDetailFields @key="selected.Id" Image="selected" Busy="busy" CatalogLoading="catalogPartial" @bind-Description="editDescription" @bind-UserDescription="editUserDescription"
                                           Save="SaveNotesAsync" Analyze="AnalyzeAsync" Dirty="NotesDirty" Discard="DiscardNotes"
                                           Suggestion="@aiSuggestions.GetValueOrDefault(selected.Id)" Approve="ApproveDetailSuggestionAsync" Dismiss="DismissDetailSuggestionAsync" DownloadWorkflow="() => ExportWorkflowAsync(selected)"
                                           ShowPrompt="RequestDetailPromptAsync" Remove="RequestDetailRemovalAsync" />
                        @if (busy) { <p class="my-4 flex items-center justify-between gap-3 rounded-lg border border-primary/25 bg-primary/5 p-4 text-sm break-words" role="status">@progress</p> }
                        @if (error.Length > 0) { <Alert Variant="AlertVariant.Destructive">@error</Alert> }
                    </div>
                </div>
            </Card>
        </ModalDialog>
    }
    @if (pendingSettingsAction is not null)
    {
        <ModalDialog LabelledBy="unsaved-settings-title" Busy="@(busy || llmEndpointSettings?.IsBusy == true)" Close="KeepEditingSettings">
            <Card Class="mx-auto max-w-lg space-y-4 p-5">
                <h2 id="unsaved-settings-title">Save your settings?</h2>
                <p>These settings have unsaved changes.</p>
                <div class="flex flex-wrap gap-2">
                    <Button Variant="ButtonVariant.Outline" Disabled="@(busy || llmEndpointSettings?.IsBusy == true)" OnClick="KeepEditingSettings" autofocus>Keep editing</Button>
                    <Button Variant="ButtonVariant.Outline" Disabled="@(busy || llmEndpointSettings?.IsBusy == true)" OnClick="DiscardSettingsAndContinueAsync">Discard changes</Button>
                    <Button Disabled="@(busy || llmEndpointSettings?.IsBusy == true)" OnClick="SaveSettingsAndContinueAsync">Save changes</Button>
                </div>
                @if (error.Length > 0) { <Alert Variant="AlertVariant.Destructive">@error</Alert> }
            </Card>
        </ModalDialog>
    }
    @if (pendingDetailAction is not null)
    {
        <ModalDialog LabelledBy="unsaved-notes-title" Busy="@busy" Close="KeepEditingNotes">
            <Card Class="mx-auto max-w-lg space-y-4 p-5">
                <h2 id="unsaved-notes-title">Save your notes?</h2>
                <p>Your notes have unsaved changes.</p>
                <div class="flex flex-wrap gap-2">
                    <Button Variant="ButtonVariant.Outline" Disabled="@busy" OnClick="KeepEditingNotes" autofocus>Keep editing</Button>
                    <Button Variant="ButtonVariant.Outline" Disabled="@busy" OnClick="DiscardNotesAndContinueAsync">Discard changes</Button>
                    <Button Disabled="@busy" OnClick="SaveNotesAndContinueAsync">Save changes</Button>
                </div>
                @if (error.Length > 0) { <Alert Variant="AlertVariant.Destructive">@error</Alert> }
            </Card>
        </ModalDialog>
    }
    @if (removalPlan.Count > 0)
    {
        <ModalDialog LabelledBy="removal-title" Busy="@busy" Close="CancelRemoval">
            <Card Class="mb-6 p-5 md:p-6 mx-auto max-w-lg space-y-4">
                <div class="mb-4 flex flex-wrap items-center justify-between gap-3"><h2 id="removal-title" class="min-w-0 flex-1 break-words">Remove @removalPlan.Count marked media item(s)</h2><Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Disabled="@busy" OnClick="CancelRemoval" aria-label="Cancel removal" autofocus><XIcon aria-hidden="true" /></Button></div>
                <p>This removes gallery records, thumbnails and encrypted files. Each media item is checked again before removal. Unmarked media cannot be removed.</p>
                <details><summary>Review affected media</summary>
                    @foreach (var item in removalPlan)
                    {
                        <p class="break-all text-muted-foreground">@item.Name: @(item.OriginalExists ? $"Original exists: {item.OriginalPath}" : "No accessible original (missing or browser upload)")</p>
                    }
                </details>
                @if (removalPlan.Any(item => item.OriginalExists))
                {
                    <Label For="existing-action" Class="mt-4 mb-2 block">Original exists (@removalPlan.Count(item => item.OriginalExists))</Label>
                    <Select id="existing-action" @bind-Value:get="existingOriginalAction.ToString()" @bind-Value:set="value => existingOriginalAction = Enum.Parse<ExistingOriginalAction>(value)" Disabled="@busy" Class="w-full min-w-0">
                        <option value="@ExistingOriginalAction.Retain">Remove from gallery, retain original</option>
                        <option value="@ExistingOriginalAction.Delete">Remove from gallery AND delete original</option>
                    </Select>
                }
                @if (removalPlan.Any(item => !item.OriginalExists))
                {
                    <Label For="missing-action" Class="mt-4 mb-2 block">No accessible original (@removalPlan.Count(item => !item.OriginalExists))</Label>
                    <Select id="missing-action" @bind-Value:get="missingOriginalAction.ToString()" @bind-Value:set="value => missingOriginalAction = Enum.Parse<MissingOriginalAction>(value)" Disabled="@busy" Class="w-full min-w-0">
                        <option value="@MissingOriginalAction.RestorePng">Restore the stored copy, then remove from gallery</option>
                        <option value="@MissingOriginalAction.Discard">Remove from gallery without restoration (lost forever)</option>
                    </Select>
                    @if (missingOriginalAction == MissingOriginalAction.RestorePng)
                    {
                        <Label For="restore-folder" Class="mt-4 mb-2 block">Existing folder for restored files</Label>
                        <Input id="restore-folder" @bind-Value="restoreFolder" Disabled="@busy" />
                        <p class="text-muted-foreground">Restores the stored file in its stored format, named by media ID; never overwrites. Media imported by this version restore as their exact original bytes; image files imported by earlier versions restore as the PNG they were converted to. Browser uploads may still have originals the app cannot access.</p>
                    }
                }
                <Alert Variant="AlertVariant.Destructive">Removal bypasses the Recycle Bin. Without a retained or restored copy, media are lost from this gallery. Backups may still contain them. This is not secure SSD/NVMe erasure.</Alert>
                <div class="mt-4 flex items-start gap-3"><Checkbox id="check-confirmremoval" Class="mt-0.5" @bind-Checked="confirmRemoval" Disabled="@busy"  /><Label For="check-confirmremoval" Class="text-sm leading-relaxed">I reviewed these media items and actions and confirm permanent removal.</Label></div>
                <Button Variant="ButtonVariant.Default" Size="ButtonSize.Default" Class="mt-6 w-full justify-between" Disabled="@(busy || !confirmRemoval)" OnClick="ExecuteRemovalAsync">Confirm removal of @removalPlan.Count media item(s)</Button>
                @if (error.Length > 0) { <Alert Variant="AlertVariant.Destructive">@error</Alert> }
                @if (busy) { <p role="status">@progress</p> }
            </Card>
        </ModalDialog>
    }
}

@if (Gallery.IsUnlocked && viewerImages.Count > 0)
{
    <FullscreenViewer KnownTags="AllTags" Images="viewerImages" InitialId="@viewerInitialId" InitialPreview="@viewerInitialPreview" ReviewMode="reviewMode" OnClose="CloseViewerAsync" OnImageChanged="ViewerImageChanged"
                      Suggestions="aiSuggestions" ApproveSuggestion="ApproveSuggestionAsync" DismissSuggestion="DismissSuggestionAsync" />
}
@if (Gallery.IsUnlocked && reviewGroups.Count > 0)
{
    <DuplicateReviewer Groups="reviewGroups" Lookup="@(id => ImageById(id))" InitialGroup="reviewStartGroup" OnClose="CloseDuplicateReviewAsync" />
}

@code {
    private string galleryScreen = "welcome", galleryTab = "create";
    private string? focusedWelcomeCredential;
    private string existingGalleryDirectory = "", newGalleryName = "", newGalleryDirectory = "";
    private string createGalleryDirectory = "";
    private bool splitGalleryStorage;
    private string newMediaDirectory = "", mediaDirectory = "", catalogDirectory = "";
    private IngestionOptions savedIngestionOptions = IngestionOptions.Hdd;
    private bool IngestionSettingsDirty => ingestionWorkers != savedIngestionOptions.Workers || ingestionBatchSize != savedIngestionOptions.CatalogBatchSize;
    private int ingestionWorkers = IngestionOptions.Hdd.Workers, ingestionBatchSize = IngestionOptions.Hdd.CatalogBatchSize;
    private string ingestionProfile = "hdd";
    private string galleryRename = "", moveGalleryDirectory = "", purgeConfirmation = "";
    private string restoreSourceType = "local", restoreSourceDirectory = "", restoreSasUrl = "";
    private string restoreAzurePrefix = "";
    private string restoreArchive = "", restoreCredential = "", restoreGalleryDirectory = "";
    private bool restoreBackupsSearched;
    private bool restoreUseRecovery;
    private IReadOnlyList<string> restoreArchives = [];
    private static readonly (string Id, string Name)[] GalleryTabs =
    [
        ("create", "Create"), ("open", "Open"), ("restore", "Restore")
    ];

    private void OpenGallerySwitcher()
    {
        secret = confirm = "";
        useRecovery = false;
        galleryScreen = "switch";
        error = message = "";
    }

    private void OpenOtherGallery()
    {
        SetGalleryTab("open");
        OpenGallerySwitcher();
    }

    private void ToggleWelcomeRecovery()
    {
        secret = "";
        useRecovery = !useRecovery;
    }

    private Task SelectKnownGalleryAsync(string directory)
    {
        secret = confirm = "";
        useRecovery = false;
        existingGalleryDirectory = directory;
        return UseExistingGalleryAsync();
    }

    private void ReturnToWelcome()
    {
        galleryScreen = "welcome";
        error = message = "";
        secret = confirm = restoreCredential = restoreSasUrl = "";
        useRecovery = restoreUseRecovery = false;
    }

    private void SetGalleryTab(string tab)
    {
        galleryTab = tab;
        error = message = "";
        secret = confirm = restoreCredential = restoreSasUrl = "";
        ResetRestoreBackups();
        useRecovery = restoreUseRecovery = false;
    }

    private void SetRestoreSource(string source)
    {
        restoreSourceType = source;
        ResetRestoreBackups();
        restoreSasUrl = restoreAzurePrefix = "";
        restoreCredential = "";
        restoreUseRecovery = false;
    }

    private Task UseExistingGalleryAsync() => RunAsync("Selecting gallery...", async () =>
    {
        await Gallery.OpenExistingVaultAsync(existingGalleryDirectory);
        await Gallery.CloseVaultAsync();
        galleryRename = Gallery.VaultName;
        ReturnToWelcome();
    });

    private void SetSplitGalleryStorage(bool enabled)
    {
        splitGalleryStorage = enabled;
        if (!enabled) newMediaDirectory = "";
    }

    private Task CreateGalleryAsync() => RunAsync("Creating gallery...", async () =>
    {
        if (secret != confirm) throw new InvalidOperationException("Passphrases do not match.");
        await Gallery.SelectNewVaultAsync(string.IsNullOrWhiteSpace(createGalleryDirectory) ? newGalleryDirectory : createGalleryDirectory);
        recoveryPhrase = await Gallery.CreateVaultAsync(secret, confirm, newGalleryName,
            new MediaStorageOptions { MediaDirectory = splitGalleryStorage ? newMediaDirectory : "" });
        secret = confirm = newMediaDirectory = newGalleryName = createGalleryDirectory = "";
        splitGalleryStorage = false;
        newGalleryDirectory = GalleryService.DefaultVaultDirectory();
    });

    private Task RenameGalleryAsync() => RunAsync("Renaming gallery...", async () =>
    {
        await Gallery.RenameVaultAsync(galleryRename);
        message = "Gallery renamed.";
    });

    private void ApplyIngestionProfile(IngestionOptions options, string? profile = null)
    {
