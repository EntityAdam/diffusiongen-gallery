                    @{ var activeFilterCount = ActiveFilters.CountActive(filter); }
                    <Button id="filter-toggle" Variant="@(filtersOpen ? ButtonVariant.Secondary : ButtonVariant.Outline)" Size="ButtonSize.Default" Type="button" OnClick="() => SetFiltersOpenAsync(!filtersOpen)"
                            aria-controls="@GalleryFilterPanel.PanelId" aria-expanded="@(filtersOpen ? "true" : "false")" aria-haspopup="dialog"
