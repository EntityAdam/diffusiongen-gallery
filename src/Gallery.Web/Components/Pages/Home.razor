@page "/"
@using System.Collections.Immutable
@implements IDisposable
@inject GalleryService Gallery
@inject ILogger<Home> Logger
@inject IJSRuntime JS

<PageTitle>DiffusionGen Gallery</PageTitle>

@if (!Gallery.IsUnlocked)
{
<section class="hero">
    <div>
        <div class="eyebrow"><span></span> YOUR IMAGINATION, KEPT SAFE</div>
        <h1>A home for<br />every <span>what if.</span></h1>
        <p>Your private creative library. Organize with intent. Discover with local intelligence.</p>
    </div>
    <div class="hero-art" aria-hidden="true"><div class="orbit"></div><div class="orbit second"></div><AsteriskIcon Size="74" ClassName="brand-mark" /><div class="art-caption">CREATE. COLLECT. KEEP.</div></div>
</section>
}

@if (error.Length > 0)
{
    <Alert Variant="AlertVariant.Destructive" Class="mb-6 flex items-center justify-between gap-3">@error <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" OnClick="() => error = string.Empty" aria-label="Dismiss error"><XIcon aria-hidden="true" /></Button></Alert>
}
@if (message.Length > 0)
{
    <div class="my-4 flex items-center justify-between gap-3 rounded-lg border border-primary/25 bg-primary/5 p-4 text-sm break-words" role="status">@message</div>
}

@if (!Gallery.IsUnlocked)
{
    <Card Class="mb-6 p-5 md:p-6 mx-auto max-w-lg space-y-4">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3"><span class="eyebrow">ENCRYPTED GALLERY</span><Badge Variant="BadgeVariant.Secondary" Class="border-primary/20 bg-primary/10 text-primary">AES-256-GCM</Badge></div>
        @if (galleryScreen == "switch")
        {
            <h2>Switch gallery</h2>
            <Tabs Value="@galleryTab" ValueChanged="SetGalleryTab">
                <TabsList Class="w-full" aria-label="Switch gallery actions">
                    @foreach (var tab in GalleryTabs)
                    {
                        <TabsTrigger Value="@tab.Id" Class="flex-1" disabled="@busy">@tab.Name</TabsTrigger>
                    }
                </TabsList>
            </Tabs>
            @if (galleryTab == "create")
            {
                <h3>Create a gallery</h3>
                <Label For="new-gallery-name" Class="mt-4 mb-2 block">Gallery name</Label>
                <Input id="new-gallery-name" @bind-Value="newGalleryName" maxlength="80" Disabled="@busy" />
                <DirectoryPathInput Label="Local catalog directory (database and encryption header)" LocalOnly="true" @bind-Value="newGalleryDirectory" Disabled="@busy" />
                <p class="text-muted-foreground">Choose a new or empty folder on this host's SSD/NVMe. SQLite's database must not use NAS/SMB storage.</p>
                <DirectoryPathInput Label="Encrypted media directory (optional, local or NAS/SMB)" @bind-Value="newMediaDirectory" Disabled="@busy" />
                <p class="text-muted-foreground">Leave blank to store media beside the catalog. Otherwise choose an existing folder; original media stays encrypted.</p>
                <form @onsubmit="CreateGalleryAsync" @onsubmit:preventDefault>
                    <Label For="secret" Class="mt-4 mb-2 block">Passphrase</Label>
                    <Input id="secret" Type="password" @bind-Value="secret" autocomplete="off" minlength="14" required Disabled="@busy" />
                    <Label For="confirm" Class="mt-4 mb-2 block">Confirm passphrase</Label>
                    <Input id="confirm" Type="password" @bind-Value="confirm" autocomplete="off" minlength="14" required Disabled="@busy" />
                    <Button Variant="ButtonVariant.Default" Size="ButtonSize.Default" Class="mt-6 w-full justify-between" Disabled="@busy" Type="submit">@(busy ? "Deriving encryption key..." : "Create gallery") <ArrowRightIcon aria-hidden="true" /></Button>
                </form>
            }
            else if (galleryTab == "open")
            {
                <h3>Open an existing gallery</h3>
                <DirectoryPathInput Label="Local folder or SMB path" @bind-Value="existingGalleryDirectory" Disabled="@busy" />
                <Button Variant="ButtonVariant.Default" Size="ButtonSize.Default" Type="button" Class="mt-6 w-full justify-between" Disabled="@busy" OnClick="UseExistingGalleryAsync">Use this gallery <ArrowRightIcon aria-hidden="true" /></Button>
            }
            else
            {
                <h3>Restore gallery</h3>
                <p class="text-muted-foreground">Restore a full backup or the last incremental backup in its chain. The destination must be a new or empty folder.</p>
                <Tabs Value="@restoreSourceType" ValueChanged="SetRestoreSource">
                    <TabsList Class="w-full" aria-label="Backup location">
                        <TabsTrigger Value="local" Class="flex-1" disabled="@busy"><FolderIcon Size="16" ClassName="mr-2" aria-hidden="true" />Local backup</TabsTrigger>
                        <TabsTrigger Value="sas" Class="flex-1" disabled="@busy"><CloudIcon Size="16" ClassName="mr-2" aria-hidden="true" />Cloud backup</TabsTrigger>
                    </TabsList>
                </Tabs>
                @if (restoreSourceType == "local")
                {
                    <DirectoryPathInput Label="Local folder or SMB path" @bind-Value="restoreSourceDirectory" Disabled="@busy" />
                }
                else
                {
                    <Label For="restore-sas" Class="mt-4 mb-2 block">Container-level Azure Blob SAS URL</Label>
                    <Input id="restore-sas" Type="password" @bind-Value="restoreSasUrl" autocomplete="off"
                           Placeholder="https://account.blob.core.windows.net/container?sv=...&amp;sr=c&amp;sp=rl&amp;sig=..."
                           pattern="https://[^/?#]+/[^/?#]+\?[^#]+" required Disabled="@busy" />
                    <p class="text-muted-foreground">Use an HTTPS container SAS with read and list permissions. The SAS URL is used only for this restore and is not saved.</p>
                }
                <div class="flex flex-wrap items-center gap-2">
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="button" Disabled="@busy" OnClick="ListRestoreBackupsAsync">Find backups</Button>
                </div>
                <Label For="restore-archive" Class="mt-4 mb-2 block">Backup archive</Label>
                <Select id="restore-archive" @bind-Value="restoreArchive" Disabled="@(busy || restoreArchives.Count == 0)">
                    <option value="">Select a full or final incremental backup</option>
                    @foreach (var archive in restoreArchives) { <option value="@archive">@archive</option> }
                </Select>
                <Label For="restored-gallery-name" Class="mt-4 mb-2 block">Gallery name</Label>
                <Input id="restored-gallery-name" @bind-Value="newGalleryName" maxlength="80" Disabled="@busy" />
                <DirectoryPathInput Label="New local catalog directory" LocalOnly="true" @bind-Value="newGalleryDirectory" Disabled="@busy" />
                <GalleryCredentialInput @bind-Value="restoreCredential" @bind-UseRecovery="restoreUseRecovery" Disabled="@busy" />
                <Button Variant="ButtonVariant.Default" Size="ButtonSize.Default" Type="button" Class="mt-6 w-full justify-between" Disabled="@(busy || string.IsNullOrWhiteSpace(restoreArchive))" OnClick="RestoreGalleryAsync">Restore gallery <ArrowRightIcon aria-hidden="true" /></Button>
            }
            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="button" Disabled="@busy" OnClick="ReturnToWelcome">Back to welcome</Button>
        }
        else
        {
        <h2>@(Gallery.VaultExists ? "Welcome back." : "Choose a gallery.")</h2>
        @if (Gallery.VaultExists)
        {
            <p><strong>@Gallery.VaultName</strong></p>
            <p class="text-muted-foreground">Unlock your gallery with your passphrase or recovery words.</p>
            <form @onsubmit="UnlockAsync" @onsubmit:preventDefault>
                @if (importRunning && importProgress is not null)
                {
                    <p class="mt-4 text-sm text-muted-foreground" role="status">Ingestion is still running: @importProgress.Completed@(importProgress.Total is int lockedTotal ? $" / {lockedTotal}" : "") files processed. Unlock to follow its progress.</p>
                }
                <GalleryCredentialInput @bind-Value="secret" @bind-UseRecovery="useRecovery" Disabled="@(busy && !importRunning)" />
                <Button Variant="ButtonVariant.Default" Size="ButtonSize.Default" Class="mt-6 w-full justify-between" Disabled="@(busy && !importRunning)" Type="submit">@(busy && !importRunning ? "Unlocking gallery..." : "Unlock gallery") <ArrowRightIcon aria-hidden="true" /></Button>
            </form>
        }
        else
        {
            <p class="text-muted-foreground">Open, create, or restore a gallery to continue.</p>
        }
        <Button Variant="ButtonVariant.Default" Size="ButtonSize.Default" Type="button" Class="mt-6 w-full justify-between" Disabled="@busy" OnClick="OpenGallerySwitcher">Switch gallery <ArrowRightIcon aria-hidden="true" /></Button>
        <div class="mt-6 space-y-2 border-t border-border pt-4 text-xs leading-relaxed text-muted-foreground [&>strong]:block [&>strong]:text-foreground"><strong>No reset link. No backdoor.</strong> If you lose both your passphrase and recovery words, your encrypted images cannot be recovered.</div>
        }
    </Card>
}
else if (recoveryPhrase.Length > 0)
{
    <Card Class="mb-6 p-5 md:p-6 mx-auto max-w-4xl">
        <span class="eyebrow">SAVE THIS BEFORE CONTINUING</span>
        <h2>Your recovery words.</h2>
        <p>Write these 32 words down, in order, and keep them offline in a safe place. Anyone with these words can unlock your gallery. They are shown only now.</p>
        <div class="my-6 grid grid-cols-2 gap-2 md:grid-cols-4 [&>div]:rounded-md [&>div]:border [&>div]:border-border [&>div]:bg-background [&>div]:p-3 [&>div]:font-mono [&>div]:text-xs [&_small]:text-muted-foreground">
            @foreach (var (word, index) in recoveryPhrase.Split(' ').Select((word, index) => (word, index)))
            {
                <div><small>@(index + 1).</small> @word</div>
            }
        </div>
        <div class="mt-4 flex items-start gap-3"><Checkbox id="check-recoverysaved" Class="mt-0.5" @bind-Checked="recoverySaved"  /><Label For="check-recoverysaved" Class="text-sm leading-relaxed">I saved all 32 words securely and understand there is no other recovery method.</Label></div>
        <Button Variant="ButtonVariant.Default" Size="ButtonSize.Default" Disabled="@(!recoverySaved || busy)" OnClick="FinishSetupAsync">Open my gallery <ArrowRightIcon aria-hidden="true" /></Button>
    </Card>
}
else
{
    <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-[210px_minmax(0,1fr)]">
    <Card Class="mb-6 flex flex-wrap gap-2 p-4 md:sticky md:top-5 md:flex-col" aria-label="Gallery workflows" role="navigation">
        <span class="eyebrow">YOUR WORKSPACE</span>
        @foreach (var item in Workflows)
        {
            <Button Variant="@(workflow == item.Id ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Disabled="@(busy || libraryJob.IsRunning && item.Id is "remove" or "ingest" or "settings")" Class="h-auto min-h-10 justify-start px-3 py-2 text-left text-sm whitespace-normal" aria-current="@(workflow == item.Id ? "page" : null)" OnClick="() => SwitchWorkflowAsync(item.Id)"><LucideIcon Name="@WorkflowIcon(item.Id)" Size="16" aria-hidden="true" />@item.Name</Button>
        }
        <div class="mt-6 space-y-2 border-t border-border pt-4 text-xs leading-relaxed text-muted-foreground [&>strong]:block [&>strong]:text-foreground"><strong>@images.Count images</strong><span data-testid="pending-count">@PendingReviewCount awaiting review</span></div>
        @if (libraryJob.IsRunning || libraryJob.Suggestions > 0 || libraryJob.Message.Length > 0)
        {
            <div class="space-y-3 rounded-lg border border-primary/20 bg-primary/5 p-3 text-xs break-words" role="status">
                <strong>@(libraryJob.IsRunning ? "Library job running" : "Library job")</strong>
                <p>@libraryJob.Message</p>
                @if (libraryJob.Suggestions > 0) { <p>@libraryJob.Suggestions suggestions await approval</p> }
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@busy" OnClick="OpenLibraryJobAsync">Open job</Button>
                @if (libraryJob.CanStop)
                {
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" OnClick="StopLibraryJobAsync">Stop after current image</Button>
                }
                @if (!libraryJob.IsRunning && libraryJob.Suggestions == 0)
                {
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" OnClick="DismissLibraryJob">Dismiss job status</Button>
                }
            </div>
        }
        @if (driveQueue.HasWork || driveQueue.State == DriveQueueState.Paused)
        {
            <div class="space-y-3 rounded-lg border border-primary/20 bg-primary/5 p-3 text-xs break-words" role="status" aria-live="polite" data-testid="drive-queue">
                <strong>Background file operations</strong>
                @if (driveQueue.Pending > 0 && driveQueue.State is DriveQueueState.Running or DriveQueueState.Waiting)
                {
                    <Progress Value="@DriveQueuePercent" aria-label="Background file operation progress" />
                }
                <p>@DriveQueueSummary</p>
                @if (driveQueue.Activity.Length > 0) { <p class="text-muted-foreground">@driveQueue.Activity</p> }
                @if (driveQueue.Failed > 0) { <p class="text-destructive">@driveQueue.Failed operation(s) failed. Files were left unchanged.</p> }
                <div class="flex flex-wrap gap-2">
                    @if (driveQueue.State is DriveQueueState.Paused or DriveQueueState.Faulted)
                    {
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" OnClick="ResumeDriveOperations">Resume</Button>
                    }
                    else if (driveQueue.Pending > 0)
                    {
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" OnClick="PauseDriveOperationsAsync">Pause</Button>
                    }
                    @if (driveQueue.Failed > 0)
                    {
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" OnClick="RetryDriveOperationsAsync">Retry failed</Button>
                    }
                    @if (driveQueue.Pending > 0 || driveQueue.Failed > 0)
                    {
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Default" title="Discard queued work. Files it would have changed stay on disk." OnClick="CancelDriveOperationsAsync">Cancel</Button>
                    }
                </div>
            </div>
        }
        <Button Variant="ButtonVariant.Destructive" Size="ButtonSize.Default" Type="button" Class="w-full justify-between" Disabled="@busy" title="Panic: immediately lock gallery, release checkout, purge memory and wipe media (Ctrl+Shift+L)" OnClick="PanicAsync">
            <span class="inline-flex items-center gap-2"><ShieldAlertIcon Size="16" aria-hidden="true" /> Panic</span> <kbd>Ctrl+Shift+L</kbd>
        </Button>
    </Card>
    <div class="min-w-0">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <div><span class="eyebrow">THE COLLECTION</span><div class="mt-2 flex items-center gap-2"><h2 class="mb-0">@Workflows.Single(item => item.Id == workflow).Name</h2></div></div>
        <div class="flex flex-wrap items-center gap-2">
            @if (ShowsGallery)
            {
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@(busy || !PageImages.Any())" OnClick="() => OpenViewer()"><MaximizeIcon aria-hidden="true" />Full screen view</Button>
            }
        </div>
    </div>

    @if (workflow == "ingest")
    {
        <Card Class="mb-6 p-5 md:p-6">
            <div class="mb-4 flex flex-wrap items-center justify-between gap-3"><h3>Bring your images home.</h3><Badge Variant="BadgeVariant.Secondary" Class="border-primary/20 bg-primary/10 text-primary">PNG / JPEG / WEBP / MP4</Badge></div>
            <p class="text-muted-foreground">Images (PNG, JPEG, WebP) are encrypted unchanged as .dpng; MP4 videos are encrypted unchanged as .dmp4 (requires ffmpeg). Sources are retained by default. Duplicate files are reported, not reimported or deleted. Maximum 50 MiB / 40 MP per image, 256 MiB per video.</p>
            <div class="mt-4 space-y-3">
                <Label Class="block">Ingestion performance</Label>
                <div class="flex flex-wrap gap-2">
                    <Button Variant="ButtonVariant.Outline" Disabled="@busy" OnClick="() => ApplyIngestionProfile(IngestionOptions.Hdd)">HDD / NAS: 4 workers</Button>
                    <Button Variant="ButtonVariant.Outline" Disabled="@busy" OnClick="() => ApplyIngestionProfile(IngestionOptions.Ssd)">SSD / NVMe: @IngestionOptions.Ssd.Workers workers</Button>
                </div>
                <Label For="ingestion-workers">Parallel workers (1-32)</Label>
                <input id="ingestion-workers" type="number" min="1" max="32" @bind="ingestionWorkers" disabled="@busy" class="h-10 rounded-md border border-input bg-background px-3" />
                <Label For="ingestion-batch">Files per catalog commit (1-64)</Label>
                <input id="ingestion-batch" type="number" min="1" max="64" @bind="ingestionBatchSize" disabled="@busy" class="h-10 rounded-md border border-input bg-background px-3" />
                <p class="text-muted-foreground">Both suggested profiles commit 16 files at a time. Increase workers cautiously for large images or videos: decoding uses memory per worker. Sources are never deleted until their batch is committed and verified. Use a batch size at least as large as the worker count.</p>
                <Button Variant="ButtonVariant.Outline" Disabled="@busy" OnClick="SaveIngestionOptionsAsync">Save performance settings</Button>
            </div>
                <form @onsubmit="ImportFolderAsync" @onsubmit:preventDefault>
                    <Label For="source" Class="mt-4 mb-2 block">Local folder path</Label>
                    <Input id="source" @bind-Value="importPath" Placeholder="C:\Pictures\Diffusion" required Disabled="@busy" />
                    <div class="mt-4 flex items-start gap-3"><Checkbox id="check-recursive" Class="mt-0.5" @bind-Checked="recursive" Disabled="@busy"  /><Label For="check-recursive" Class="text-sm leading-relaxed">Include subfolders</Label></div>
                    <div class="mt-4 flex items-start gap-3"><Checkbox id="check-recordtimings" Class="mt-0.5" @bind-Checked="recordTimings" Disabled="@busy"  /><Label For="check-recordtimings" Class="text-sm leading-relaxed">Record performance timings (logged without file or folder names)</Label></div>
                    <div class="mt-4 flex items-start gap-3"><Checkbox id="check-deletesources" Class="mt-0.5" @bind-Checked="deleteSources" Disabled="@busy"  /><Label For="check-deletesources" Class="text-sm leading-relaxed">Delete originals after verified import</Label></div>
                    @if (deleteSources)
                    {
                        <Alert Variant="AlertVariant.Destructive">Originals will be deleted without the Recycle Bin after the saved image, catalog and thumbnail are verified. This is not secure shredding: SSD/NVMe remnants, backups and snapshots may remain recoverable.</Alert>
                        <div class="mt-4 flex items-start gap-3"><Checkbox id="check-confirmsourcedeletion" Class="mt-0.5" @bind-Checked="confirmSourceDeletion" Disabled="@busy"  /><Label For="check-confirmsourcedeletion" Class="text-sm leading-relaxed">I understand this permanently removes successfully imported source files, not their forensic remnants.</Label></div>
                    }
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@busy" Type="submit">Ingest this folder <ArrowRightIcon aria-hidden="true" /></Button>
                </form>
            @if (importProgress is not null)
            {
                <div class="mt-5 space-y-2" aria-busy="@(busy ? "true" : "false")">
                    <Label For="ingestion-progress" Class="mt-4 mb-2 block">Image ingestion</Label>
                    @if (importProgress.Total is int progressTotal)
                    {
                        <Progress id="ingestion-progress" Value="@(Math.Clamp((int)(100L * importProgress.Completed / Math.Max(1, progressTotal)), 0, 100))" aria-label="Image ingestion progress" />
                    }
                    else
                    {
                        <div id="ingestion-progress" class="flex items-center gap-2 text-primary" role="status"><LoaderCircleIcon Size="16" ClassName="animate-spin" aria-hidden="true" />Discovering files...</div>
                    }
                    <p class="text-muted-foreground">
                        @if (importProgress.Total is int total)
                        {
                            <span>@importProgress.Completed / @total files processed &middot; @importProgress.Imported imported &middot; @importProgress.Failed reported issues</span>
                        }
                    </p>
                    <p role="status">@importProgress.Status</p>
                </div>
            }
            @if (importFailures.Count > 0)
            {
                <details open class="text-destructive"><summary>@importFailures.Count file(s) reported issues</summary>
                    @foreach (var failure in importFailures) { <p>@failure</p> }
                </details>
            }
            @if (timingReport is not null)
            {
                <details open class="mt-4"><summary>Performance timings</summary>
                    <p class="text-sm text-muted-foreground">Also written to the application log. Contains no file or folder names.</p>
                    <pre class="mt-2 overflow-x-auto rounded-md bg-muted p-3 text-xs">@timingReport</pre>
                </details>
            }
        </Card>
    }
    @if (workflow == "settings")
    {
        <Tabs Value="@settingsTab" ValueChanged="SwitchSettingsTabAsync" Class="mb-4">
            <TabsList Class="h-auto max-w-full flex-wrap justify-start gap-1" aria-label="Settings sections">
                @foreach (var tab in SettingsTabs)
                {
                    <TabsTrigger Value="@tab.Id" disabled="@busy">@tab.Name</TabsTrigger>
                }
            </TabsList>
        </Tabs>
    }
    @if (workflow == "settings" && settingsTab == "overview")
    {
        <Card Class="mb-6 p-5 md:p-6 storage-overview" aria-labelledby="storage-overview-title">
            <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
                <h3 id="storage-overview-title">Gallery overview</h3>
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="button" Disabled="@busy" OnClick="RefreshStorageOverviewAsync">@(busy && progress.StartsWith("Measuring") ? "Refreshing..." : "Refresh")</Button>
            </div>
            @if (storageOverview is null)
            {
                <p class="text-muted-foreground">Storage has not been measured yet. Select Refresh to calculate it.</p>
            }
            else
            {
                <dl class="my-4 grid grid-cols-1 gap-3 lg:grid-cols-3 [&>div]:min-w-0 [&>div]:rounded-lg [&>div]:border [&>div]:border-border [&>div]:p-4 [&_dt]:text-xs [&_dt]:uppercase [&_dt]:text-muted-foreground [&_dd]:my-2 [&_dd]:text-2xl [&_dd]:text-primary [&_dd]:break-all [&_span]:text-xs">
                    <div><dt>Database size</dt><dd data-testid="database-size">@GalleryService.FormatBytes(storageOverview.DatabaseBytes)</dd><span class="text-muted-foreground">gallery.db with WAL files, including thumbnails</span></div>
                    <div><dt>Total file count</dt><dd data-testid="file-count">@storageOverview.TotalFileCount.ToString("N0")</dd><span class="text-muted-foreground">@storageOverview.ImageFileCount.ToString("N0") encrypted images + @storageOverview.VaultFileCount gallery files</span></div>
                    <div><dt>Total size on disk</dt><dd data-testid="total-size">@GalleryService.FormatBytes(storageOverview.TotalBytes)</dd><span class="text-muted-foreground">@GalleryService.FormatBytes(storageOverview.ImageBytes) of encrypted images</span></div>
                </dl>
                @if (storageOverview.MissingImageFiles > 0)
                {
                    <Alert Variant="AlertVariant.Destructive">@storageOverview.MissingImageFiles catalogued image file(s) were not found on disk and are not counted.</Alert>
                }
                @if (storageOverview.IsIndexPending)
                {
                    <p class="text-muted-foreground" data-testid="index-pending">The file index is still being built in the background; some sizes were measured directly. Refresh once background file operations finish.</p>
                }
                <StorageOverviewStatus Overview="@storageOverview" />
            }
            <p class="text-muted-foreground flex flex-wrap items-center gap-2">
                <span>Sizes come from a cached file index. Rebuild it if files were changed outside the gallery.</span>
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Default" Type="button" Class="h-auto px-0" Disabled="@busy" OnClick="RebuildStorageIndexAsync">Rebuild file index</Button>
            </p>
            <p class="text-muted-foreground flex flex-wrap items-center gap-2">
                @if (duplicateScan is null) { <span>Duplicates have not been scanned yet.</span> }
                else { <span>Last duplicate scan found @VisibleDuplicateGroups.Sum(group => group.ImageIds.Length - 1).ToString("N0") likely duplicate(s), about @GalleryService.FormatBytes(VisibleDuplicateGroups.Sum(group => group.ReclaimableBytes)) reclaimable.</span> }
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Default" Type="button" Class="h-auto px-0" Disabled="@busy" OnClick='() => SwitchWorkflowAsync("duplicates")'>Find duplicates <ArrowRightIcon aria-hidden="true" /></Button>
            </p>
        </Card>
    }
    @if (workflow == "settings" && settingsTab == "gallery")
    {
        <Card Class="mb-6 p-5 md:p-6 space-y-4">
            <h3>Manage gallery</h3>
            <p><strong>@Gallery.VaultName</strong></p><p class="break-all text-muted-foreground">@Gallery.VaultRoot</p>
            @if (Gallery.CatalogIsOnNetworkDrive)
            {
                <Alert Variant="AlertVariant.Destructive">This legacy catalog is on network storage and uses rollback journaling, not WAL. Relocate it to a local directory below; media can stay on the NAS.</Alert>
            }
            <DirectoryPathInput Label="Local catalog directory (new or empty)" LocalOnly="true" @bind-Value="catalogDirectory" Disabled="@busy" />
            <p class="text-muted-foreground">Relocates only gallery.db and vault.json. Existing encrypted media stays at its current paths. Sign in again after relocating; new imports keep using the current media directory.</p>
            <Button Variant="ButtonVariant.Outline" Disabled="@(busy || libraryJob.IsRunning || string.IsNullOrWhiteSpace(catalogDirectory))" OnClick="RelocateCatalogAsync">Relocate catalog only</Button>
            <DirectoryPathInput Label="Encrypted media directory for future imports (optional, local or NAS/SMB)" @bind-Value="mediaDirectory" Disabled="@busy" />
            <p class="text-muted-foreground">Leave blank to use the local catalog directory. Choose an existing folder otherwise. Changing this does not move existing files; backups still include them.</p>
            <Button Variant="ButtonVariant.Outline" Disabled="@busy" OnClick="SaveMediaStorageAsync">Save media location</Button>
            <Label For="rename-gallery" Class="mt-4 mb-2 block">Gallery name</Label>
            <Input id="rename-gallery" @bind-Value="galleryRename" maxlength="80" Disabled="@busy" />
            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="button" Disabled="@busy" OnClick="RenameGalleryAsync">Rename</Button>
            <DirectoryPathInput Label="Move whole gallery to a new or empty local folder" LocalOnly="true" @bind-Value="moveGalleryDirectory" Disabled="@busy" />
            <p class="text-muted-foreground">Moves the catalog and all encrypted media, including media stored outside the gallery. The destination is verified before source files are removed. Sign in again after moving.</p>
            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="button" Disabled="@(busy || libraryJob.IsRunning)" OnClick="MoveGalleryAsync">Move gallery</Button>
            <Alert Variant="AlertVariant.Destructive">Purge permanently destroys all media and gallery data, including encrypted media stored outside this folder. Original source files and backups are not deleted. This is not secure disk erasure.</Alert>
            <Label For="purge-gallery" Class="mt-4 mb-2 block">Type PURGE to confirm</Label>
            <Input id="purge-gallery" @bind-Value="purgeConfirmation" autocomplete="off" Disabled="@busy" />
            <Button Variant="ButtonVariant.Destructive" Size="ButtonSize.Default" Type="button" Disabled="@(busy || libraryJob.IsRunning || purgeConfirmation != "PURGE")" OnClick="PurgeGalleryAsync">Purge gallery</Button>
        </Card>
