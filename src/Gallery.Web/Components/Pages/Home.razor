    @if (workflow == "settings" && settingsTab == "backups")
    {
        <Card Class="mb-6 p-5 md:p-6 space-y-4" aria-labelledby="backup-settings-title">
            <div class="mb-4 flex flex-wrap items-center justify-between gap-3"><h3 id="backup-settings-title">Gallery backups</h3></div>
            <p class="text-muted-foreground">Backups contain the gallery header, a consistent database snapshot, and encrypted media. Incremental backups include a fresh database snapshot and only changed media; keep the full backup and every later incremental archive in the chain.</p>
            <BackupLocation @bind-Type="backupDestinationType" @bind-LocalDirectory="backupLocalDirectory"
                @bind-Container="backupAzureContainer" @bind-Prefix="backupAzurePrefix"
                @bind-ConnectionString="backupAzureConnectionString" HasSavedCredentials="@(backupOptions?.HasAzureCredentials == true)" Disabled="@busy" />
            <div class="flex flex-wrap items-center gap-2">
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="button" Disabled="@busy" OnClick="SaveBackupOptionsAsync">Save destination</Button>
                <Button Variant="ButtonVariant.Default" Size="ButtonSize.Default" Type="button" Disabled="@(busy || !BackupDestinationReady)" OnClick="CreateFullBackupAsync">Create full backup</Button>
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="button" Disabled="@(busy || !BackupDestinationReady || backupOptions?.LastBackupName is null)" OnClick="CreateIncrementalBackupAsync">Create incremental backup</Button>
            </div>
            @if (backupOptions?.LastBackupName is { } lastBackup)
            {
                <p class="text-muted-foreground">Last successful @backupOptions.LastBackupType backup: <code>@lastBackup</code></p>
            }
            <p class="text-muted-foreground">A full backup starts a new chain. Incremental backups require the previous archive to remain in the same destination. No backup is deleted automatically.</p>
        </Card>
