    <LibraryWorkbench @ref="workbench" Visible="@(workflow is "organize" or "explore" or "ai")" Workflow="@workflow" Images="images" SelectedIds="librarySelection" Filter="filter" FilterChanged="ApplyLibraryFilterAsync" Changed="ReloadAsync" JobChanged="LibraryJobChanged" />
    @if (ShowsGallery)
    {
    <GalleryFilterPanel Filter="filter" Images="images" ResultCount="Filtered.Count" Open="filtersOpen" OpenChanged="SetFiltersOpenAsync" Changed="ApplyLibraryFilterAsync" Reset="ResetFilters" Disabled="busy" />
    <div class="gallery-layout grid min-w-0 grid-cols-1" data-has-selection="@((librarySelection.Count > 0 || removalSelection.Count > 0) ? "true" : "false")">
        <section>
            <ActiveFilters Filter="filter" Changed="ApplyLibraryFilterAsync" Reset="ResetFilters" Disabled="busy" />
            <div class="mb-5 flex flex-wrap items-center gap-4 text-sm">
