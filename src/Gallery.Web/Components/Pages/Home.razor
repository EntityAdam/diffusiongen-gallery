    @if (workflow == "settings" && settingsTab == "security")
    {
        <Card Class="mb-6 p-5 md:p-6 space-y-4">
            <h3>Gallery security</h3>
            <div class="space-y-4 rounded-lg border border-border bg-background p-4">
                <h4>Inactivity auto-lock</h4>
                <p class="text-muted-foreground">Automatically drop encryption keys from memory and lock the gallery when no mouse, keyboard or touch activity is detected. Locking also releases the gallery checkout after active work finishes.</p>
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
                    <Label For="auto-lock" Class="mt-4 mb-2 block">Auto-lock timer</Label>
                    <Select id="auto-lock" Value="@autoLockMinutes.ToString()" ValueChanged="UpdateAutoLockMinutesAsync" Disabled="@busy" Class="min-w-0 flex-1">
                        <option value="0">Disabled (never lock automatically)</option>
                        <option value="5">5 minutes</option>
                        <option value="15">15 minutes (default)</option>
                        <option value="30">30 minutes</option>
                        <option value="60">60 minutes (1 hour)</option>
                    </Select>
                </div>
                <p class="text-muted-foreground">
                    @(autoLockMinutes == 0
                        ? "Auto-lock is currently disabled. The gallery remains unlocked until manually locked or closed."
                        : $"The gallery will automatically lock after {autoLockMinutes} minutes of inactivity.")
                </p>
            </div>

            <div class="space-y-4 rounded-lg border border-border bg-background p-4">
                <h4>Panic / Emergency quick-lock</h4>
                <p class="text-muted-foreground">Press <kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>L</kbd> (or <kbd>Alt</kbd>+<kbd>Shift</kbd>+<kbd>L</kbd>, or <kbd>Shift</kbd>+<kbd>Esc</kbd>) anywhere in the application to instantly lock the gallery, release its checkout after active work finishes, zero-out keys in RAM, revoke media blob URLs, and clear browser caches.</p>
                <Button Variant="ButtonVariant.Destructive" Size="ButtonSize.Default" Type="button" Disabled="@busy" OnClick="PanicAsync">Trigger panic lock now</Button>
            </div>

            <div class="space-y-4 rounded-lg border border-border bg-background p-4">
                <h4>Passphrase</h4>
                <form @onsubmit="ChangePassphraseAsync" @onsubmit:preventDefault>
                    <Label For="new-passphrase" Class="mt-4 mb-2 block">New passphrase</Label>
                    <Input id="new-passphrase" Type="password" @bind-Value="newPassphrase" minlength="14" autocomplete="off" required />
                    <Label For="new-confirm" Class="mt-4 mb-2 block">Confirm new passphrase</Label>
                    <Input id="new-confirm" Type="password" @bind-Value="newConfirm" minlength="14" autocomplete="off" required />
                    <p class="text-muted-foreground">Use this after unlocking with recovery words. Your recovery words remain unchanged. Back up the gallery header, database, and all encrypted media together.</p>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@busy" Type="submit">Change passphrase</Button>
                </form>
            </div>
        </Card>
    }

    @if (workflow is "library" or "review")
    {
    <div class="mb-6 grid grid-cols-2 gap-3 lg:grid-cols-4 [&>button]:h-auto [&>button]:flex-col [&>button]:items-start [&>button]:p-5 [&_strong]:text-3xl [&_strong]:text-primary [&_span]:text-xs [&_span]:text-muted-foreground">
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@busy" OnClick='() => SetQueueAsync("all")'><strong>@images.Count</strong><span>In your library</span></Button>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@busy" OnClick='() => SetQueueAsync("favorites")'><strong>@images.Count(image => image.IsFavorite && !image.IsMarkedForDeletion)</strong><span>Favorites</span></Button>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@busy" OnClick='() => SetQueueAsync("pending")'><strong>@images.Count(image => !image.IsReviewed && !image.IsMarkedForDeletion)</strong><span>Awaiting review</span></Button>
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@busy" OnClick='() => SetQueueAsync("unorganized")'><strong>@images.Count(image => image.Collections.IsEmpty && !image.IsMarkedForDeletion)</strong><span>Without a collection</span></Button>
