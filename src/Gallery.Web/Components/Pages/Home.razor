    @if (workflow == "duplicates")
    {
        <Card Class="mb-6 p-5 md:p-6 duplicates" aria-labelledby="duplicates-title">
            <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
                <h3 id="duplicates-title">Duplicate finder</h3>
                <Button Variant="ButtonVariant.Default" Size="ButtonSize.Default" Type="button" Disabled="@busy" OnClick="ScanDuplicatesAsync">@(duplicateScan is null ? "Scan for duplicates" : "Scan again")</Button>
            </div>
            <p class="text-muted-foreground">Compares a perceptual fingerprint of each encrypted thumbnail, so resized or re-encoded copies are found too. Fingerprints stay encrypted in the gallery and only changed images are re-hashed. Nothing is deleted here: extra copies are marked for deletion and removed from <em>Trash</em>.</p>
            @if (busy && progress.StartsWith("Scanning")) { <p class="flex items-center gap-2 pb-4 text-primary" role="status"><span class="status-dot"></span> @progress</p> }
            @if (duplicateScan is not null)
            {
                var groups = VisibleDuplicateGroups;
                var pendingMarks = groups.Sum(group => group.ImageIds.Count(id => id != KeeperOf(group).Id && !ImageById(id)!.IsMarkedForDeletion));
                <div class="my-4 flex flex-col gap-2">
                    <span><strong>@groups.Count</strong> group(s) &middot; <strong>@groups.Sum(group => group.ImageIds.Length - 1)</strong> extra copies &middot; <strong>@GalleryService.FormatBytes(groups.Sum(group => group.ReclaimableBytes))</strong> reclaimable</span>
                    <span class="text-muted-foreground">Scanned @duplicateScan.ScannedCount.ToString("N0") images <time datetime="@duplicateScan.ScannedAt.ToString("O")">@duplicateScan.ScannedAt.ToLocalTime().ToString("g")</time></span>
                    <div class="flex flex-wrap items-center gap-2">
                        <Button Variant="ButtonVariant.Default" Size="ButtonSize.Default" Type="button" Disabled="@(busy || groups.Count == 0)" OnClick="() => OpenDuplicateReview(groups, 0)">Review in full screen</Button>
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="button" Disabled="@(busy || pendingMarks == 0)" OnClick="() => MarkDuplicatesAsync(groups)">Mark all extra copies (@pendingMarks)</Button>
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="button" Disabled="@busy" OnClick='() => SwitchWorkflowAsync("remove")'>Go to Trash</Button>
                    </div>
                </div>
                @if (groups.Count == 0) { <p class="text-muted-foreground">No likely duplicates found.</p> }
                @foreach (var (group, groupNumber) in groups.Take(DuplicateGroupsShown).Select((group, index) => (group, index)))
                {
                    var keeper = KeeperOf(group);
                    var groupMarks = group.ImageIds.Count(id => id != keeper.Id && !ImageById(id)!.IsMarkedForDeletion);
                    <article class="mt-4 rounded-xl border border-border p-4 [&>header]:mb-3 [&>header]:flex [&>header]:flex-wrap [&>header]:items-center [&>header]:justify-between [&>header]:gap-3 [&>header]:text-sm" @key="group.ImageIds[0]">
                        <header>
                            <span>@(group.IsExact ? "Exact copies" : $"Similar images (difference {group.MaxDistance}/64)") &middot; @GalleryService.FormatBytes(group.ReclaimableBytes) reclaimable</span>
                            <div class="flex flex-wrap items-center gap-2">
                                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="button" Disabled="@busy" OnClick="() => OpenDuplicateReview(groups, groupNumber)">Review &amp; choose keepers</Button>
                                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="button" Disabled="@(busy || groupMarks == 0)" OnClick="() => MarkDuplicatesAsync([group])">@(groupMarks == 0 ? "Extra copies marked" : $"Mark {groupMarks} other(s) for deletion")</Button>
                            </div>
                        </header>
                        <div class="duplicate-items grid grid-cols-[repeat(auto-fill,minmax(150px,1fr))] gap-3 [&_figure]:min-w-0 [&_figure]:overflow-hidden [&_figure]:rounded-lg [&_figure]:border [&_figure]:border-border [&_figure]:bg-background [&_img]:aspect-square [&_img]:w-full [&_img]:object-contain [&_figcaption]:flex [&_figcaption]:flex-col [&_figcaption]:gap-1 [&_figcaption]:p-3 [&_figcaption]:text-xs [&_strong]:truncate [&_figcaption>span]:text-muted-foreground">
                            @foreach (var id in group.ImageIds.OrderByDescending(id => id == keeper.Id))
                            {
                                var image = ImageById(id)!;
                                <figure class="@(id == keeper.Id ? "keep" : "") @(image.IsMarkedForDeletion ? "marked" : "")">
                                    @if (duplicateThumbnails.TryGetValue(id, out var thumbnail)) { <img src="@thumbnail" alt="@image.Name" draggable="false" /> }
                                    else { <div class="grid h-full place-items-center text-xs text-muted-foreground">Preview</div> }
                                    <figcaption>
                                        <strong title="@image.Name">@image.Name</strong>
                                        <span>@image.Width &times; @image.Height &middot; @GalleryService.FormatBytes(image.OriginalBytes)@(image.Rating > 0 ? $" · {image.Rating}★" : "")@(image.IsFavorite ? " · Favorite" : "")</span>
                                        @if (id == keeper.Id) { <Badge Variant="BadgeVariant.Secondary" Class="self-start">Keep</Badge> }
                                        else if (image.IsMarkedForDeletion) { <Badge Variant="BadgeVariant.Destructive" Class="self-start">Marked</Badge> }
                                    </figcaption>
                                </figure>
                            }
                        </div>
                    </article>
                }
                @if (groups.Count > DuplicateGroupsShown)
                {
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="button" Disabled="@busy" OnClick="ShowMoreDuplicatesAsync">Show more groups (@(groups.Count - DuplicateGroupsShown) remaining)</Button>
                }
            }
        </Card>
    }
    @if (workflow == "settings" && settingsTab == "endpoints")
    {
        <LlmEndpointSettings SavedSettings="settings" Saved="value => settings = value" />
