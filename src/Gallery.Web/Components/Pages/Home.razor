                            <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-2 [&_dt]:text-muted-foreground [&_dd]:min-w-0 [&_dd]:break-words">
                                @if (generation.Prompt.Length > 0) { <dt>Prompt</dt><dd class="max-h-40 overflow-auto text-sm whitespace-pre-wrap break-words">@generation.Prompt</dd> }
                                @if (generation.NegativePrompt.Length > 0) { <dt>Negative prompt</dt><dd class="max-h-40 overflow-auto text-sm whitespace-pre-wrap break-words">@generation.NegativePrompt</dd> }
                                @if (generation.Model.Length > 0) { <dt>@(generation.ModelKind.Length > 0 ? generation.ModelKind : "Model")</dt><dd>@generation.Model</dd> }
                                @if (generation.Steps is int steps) { <dt>Steps</dt><dd>@steps</dd> }
                                @if (generation.Cfg is double cfg) { <dt>CFG</dt><dd>@cfg.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)</dd> }
                            </dl>
                            @if (!generation.HasApiPrompt) { <p class="text-muted-foreground">Only a UI workflow was embedded; download a copy to inspect the graph in ComfyUI.</p> }
                            @if (generation.Prompt.Length > 0)
                            {
                                var count = images.Count(image => image.Prompt == generation.Prompt);
                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Default" Class="h-auto px-0" Disabled="@busy" OnClick="() => ShowPromptAsync(generation.Prompt)">Show all @count with this exact prompt</Button>
                            }
                        }
                        <h3>Vision notes</h3>
                        <Label For="description" Class="mt-4 mb-2 block">Description</Label><Textarea id="description" Rows="4" @bind-Value="editDescription"></Textarea>
                        <Label For="edit-tags" Class="mt-4 mb-2 block">Tags, comma-separated</Label><Input id="edit-tags" @bind-Value="editTags" Placeholder="landscape, sunset, cinematic" />
                        <div class="flex flex-wrap items-center gap-2"><Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@busy" OnClick="SaveNotesAsync">Save notes</Button><Button Variant="ButtonVariant.Default" Size="ButtonSize.Default" Disabled="@busy" OnClick="AnalyzeAsync">Analyze locally</Button></div>
                        @if (selected.AnalysisModel.Length > 0) { <small class="text-muted-foreground">Analyzed by @selected.AnalysisModel</small> }
                        <h3>Move &amp; rename</h3>
                        <form @onsubmit="MoveAsync" @onsubmit:preventDefault>
                            <Label For="destination" Class="mt-4 mb-2 block">Existing destination folder</Label><Input id="destination" @bind-Value="destination" required />
                            <Label For="rename" Class="mt-4 mb-2 block">Filename</Label><div class="flex min-w-0 items-center gap-2 [&>span]:text-muted-foreground"><Input id="rename" @bind-Value="rename" required /><span>@(selected.IsVideo ? ".dmp4" : ".dpng")</span></div>
                            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Type="submit" Disabled="@busy">Move encrypted image <ArrowRightIcon aria-hidden="true" /></Button>
                        </form>
                        <small class="text-muted-foreground">No overwrite. The file remains encrypted. Deletion marks are reversible; permanent removal requires a separate confirmation.</small>
                        <details><summary>Embedded generation metadata</summary><pre>@selected.Metadata</pre></details>
                        <details><summary>File locations</summary><p class="break-all text-muted-foreground">@selected.StoredPath</p><p class="break-all text-muted-foreground">Source: @selected.SourceFolder</p></details>
                        @if (busy) { <p class="my-4 flex items-center justify-between gap-3 rounded-lg border border-primary/25 bg-primary/5 p-4 text-sm break-words" role="status">@progress</p> }
                        @if (error.Length > 0) { <Alert Variant="AlertVariant.Destructive">@error</Alert> }
                    </div>
                </div>
            </Card>
        </div>
    }
    @if (removalPlan.Count > 0)
    {
        <div class="fixed inset-0 z-20 overflow-y-auto bg-black/90 p-3 md:p-7">
            <Card Class="mb-6 p-5 md:p-6 mx-auto max-w-lg space-y-4" role="dialog" aria-modal="true" aria-labelledby="removal-title">
                <div class="mb-4 flex flex-wrap items-center justify-between gap-3"><h2 id="removal-title" class="min-w-0 flex-1 break-words">Remove @removalPlan.Count marked image(s)</h2><Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Disabled="@busy" OnClick="CancelRemoval" aria-label="Cancel removal"><XIcon aria-hidden="true" /></Button></div>
                <p>This removes gallery records, thumbnails and encrypted files. Each image is checked again before removal. Unmarked images cannot be removed.</p>
                <details><summary>Review affected images</summary>
                    @foreach (var item in removalPlan)
                    {
                        <p class="break-all text-muted-foreground">@item.Name: @(item.OriginalExists ? $"Original exists: {item.OriginalPath}" : "No accessible original (missing or browser upload)")</p>
                    }
                </details>
                @if (removalPlan.Any(item => item.OriginalExists))
                {
                    <Label For="existing-action" Class="mt-4 mb-2 block">Original exists (@removalPlan.Count(item => item.OriginalExists))</Label>
                    <select id="existing-action" @bind="existingOriginalAction" disabled="@busy" class="h-10 w-full min-w-0 rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-50">
                        <option value="@ExistingOriginalAction.Retain">Remove from gallery, retain original</option>
                        <option value="@ExistingOriginalAction.Delete">Remove from gallery AND delete original</option>
                    </select>
                }
                @if (removalPlan.Any(item => !item.OriginalExists))
                {
                    <Label For="missing-action" Class="mt-4 mb-2 block">No accessible original (@removalPlan.Count(item => !item.OriginalExists))</Label>
                    <select id="missing-action" @bind="missingOriginalAction" disabled="@busy" class="h-10 w-full min-w-0 rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-50">
                        <option value="@MissingOriginalAction.RestorePng">Restore the stored copy, then remove from gallery</option>
                        <option value="@MissingOriginalAction.Discard">Remove from gallery without restoration (lost forever)</option>
                    </select>
                    @if (missingOriginalAction == MissingOriginalAction.RestorePng)
                    {
                        <Label For="restore-folder" Class="mt-4 mb-2 block">Existing folder for restored files</Label>
                        <Input id="restore-folder" @bind-Value="restoreFolder" Disabled="@busy" />
                        <p class="text-muted-foreground">Restores the stored file in its stored format, named by image ID; never overwrites. Images imported by this version restore as their exact original bytes; images imported by earlier versions restore as the PNG they were converted to. Browser uploads may still have originals the app cannot access.</p>
                    }
                }
                <Alert Variant="AlertVariant.Destructive">Removal bypasses the Recycle Bin. Without a retained or restored copy, images are lost from this gallery. Backups may still contain them. This is not secure SSD/NVMe erasure.</Alert>
                <div class="mt-4 flex items-start gap-3"><Checkbox id="check-confirmremoval" Class="mt-0.5" @bind-Checked="confirmRemoval" Disabled="@busy"  /><Label For="check-confirmremoval" Class="text-sm leading-relaxed">I reviewed these images and actions and confirm permanent removal.</Label></div>
                <Button Variant="ButtonVariant.Default" Size="ButtonSize.Default" Class="mt-6 w-full justify-between" Disabled="@(busy || !confirmRemoval)" OnClick="ExecuteRemovalAsync">Confirm removal of @removalPlan.Count image(s)</Button>
                @if (error.Length > 0) { <Alert Variant="AlertVariant.Destructive">@error</Alert> }
                @if (busy) { <p role="status">@progress</p> }
            </Card>
        </div>
    }
}

@if (Gallery.IsUnlocked && viewerImages.Count > 0)
{
    <FullscreenViewer Images="viewerImages" InitialId="@viewerInitialId" ReviewMode="reviewMode" OnClose="CloseViewerAsync" OnImageChanged="ViewerImageChanged" />
}
@if (Gallery.IsUnlocked && reviewGroups.Count > 0)
{
    <DuplicateReviewer Groups="reviewGroups" Lookup="@(id => ImageById(id))" InitialGroup="reviewStartGroup" OnClose="CloseDuplicateReviewAsync" />
}

