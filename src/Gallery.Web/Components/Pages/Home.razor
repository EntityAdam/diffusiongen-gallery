                                }
                                else
                                {
                                    <div class="flex flex-wrap items-center gap-3 text-sm"><strong>@(group.Kind == PromptGroup.Unique ? "Unique prompts" : "No ComfyUI prompt found") (@group.Images.Length)@(continued ? " (continued)" : "")</strong></div>
                                }
                            </div>
                        }
                        else if (grouping == "model" && diffusionModelGroupOf.TryGetValue(image.Id, out var modelGroup) && !ReferenceEquals(modelGroup, previousModelGroup))
                        {
                            var continued = firstOnPage && modelGroup.Images[0].Id != image.Id;
                            previousModelGroup = modelGroup;
                            <div class="col-span-full rounded-md border-l-2 border-primary bg-primary/5 px-4 py-3" @key="@("model-group-" + image.Id)">
                                <strong>@(modelGroup.Model.Length == 0 ? "No diffusion model recorded" : modelGroup.Model) (@modelGroup.Images.Length)@(continued ? " (continued)" : "")</strong>
                            </div>
                        }
                        firstOnPage = false;
                        <GalleryImageCard @key="image.Id" Image="image" Thumbnail="@thumbnails.GetValueOrDefault(image.Id)" ThumbnailFailed="@thumbnailFailures.Contains(image.Id)"
                                          Busy="busy" Selected="isSelected" ShowSelection="true"
                                          Select="args => SelectCard(image.Id, args.ShiftKey)" Open="() => OpenAsync(image)"
                                          Rate="value => RateImageAsync(image, value)" Favorite="() => FavoriteAsync(image)"
                                          Mark="() => MarkAsync(image)"
                                          />
                    }
                </div>
                <div class="mt-6 flex items-center justify-between gap-3 text-sm text-muted-foreground">
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@(page == 0 || busy)" OnClick="PreviousAsync"><ChevronLeftIcon aria-hidden="true" />Previous</Button>
                    <span>Page @(page + 1) of @PageCount</span>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Default" Disabled="@(page + 1 >= PageCount || busy)" OnClick="NextAsync">Next <ArrowRightIcon aria-hidden="true" /></Button>
                </div>
            }
        </section>
    </div>
    }
