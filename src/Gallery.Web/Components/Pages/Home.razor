        DriveQueueState.Faulted => $"Stopped unexpectedly with {driveQueue.Pending:N0} operation(s) queued. Resume or retry to continue.",
        DriveQueueState.Running => $"{driveQueue.Completed:N0} done, {driveQueue.Pending:N0} queued.",
        _ => driveQueue.Pending > 0 ? $"{driveQueue.Pending:N0} operation(s) queued; they continue the next time the gallery is unlocked." : "No queued work."
    };

    private Task PauseDriveOperationsAsync() => RunDriveControlAsync(Gallery.PauseDriveOperationsAsync);

    private void ResumeDriveOperations() => Gallery.ResumeDriveOperations();

    private Task RetryDriveOperationsAsync() => RunDriveControlAsync(Gallery.RetryFailedDriveOperationsAsync);

    private Task CancelDriveOperationsAsync() => RunDriveControlAsync(Gallery.CancelDriveOperationsAsync);

    // Queue controls stay available while other workflows are busy, so they do not go through RunAsync.
    private async Task RunDriveControlAsync(Func<Task> action)
    {
        try { await action(); }
        catch (Exception exception) when (exception is IOException or InvalidOperationException or Microsoft.Data.Sqlite.SqliteException)
        {
            Logger.LogError(exception, "Background file operation control failed");
            message = "The background file operation could not be changed. Try again.";
        }
    }

