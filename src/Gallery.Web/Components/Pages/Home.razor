        await Gallery.UpdateAsync(selected.Id, image =>
        {
            return image with { Description = result.Description, Tags = result.Tags, AnalysisModel = settings.Model };
        });
        await ReloadAsync();
        editDescription = selected!.Description;
        editTags = selected.Tags;
        message = "Vision analysis saved.";
    });

    private Task MoveAsync() => RunAsync("Moving encrypted image...", async () =>
    {
        EnsureNoLibraryJob();
        if (selected is null) return;
        try { await Gallery.MoveAsync(selected.Id, destination, rename); }
        finally { await ReloadAsync(); }
        message = "Encrypted image moved and renamed.";
    });

    private Task ChangePassphraseAsync() => RunAsync("Updating passphrase...", async () =>
    {
        EnsureNoLibraryJob();
        try
        {
            await Gallery.ChangePassphraseAsync(newPassphrase, newConfirm);
            message = "Passphrase updated. Your recovery words are unchanged.";
        }
        finally { newPassphrase = newConfirm = ""; }
    });

    private void EnsureNoLibraryJob()
    {
        if (libraryJob.IsRunning) throw new InvalidOperationException("Wait for the running LLM job to finish, or stop it after the current image, before changing files or gallery settings.");
    }

    private async Task UpdateAutoLockMinutesAsync(string? value)
    {
        if (int.TryParse(value, out var minutes))
        {
            autoLockMinutes = Math.Clamp(minutes, 0, 1440);
            Gallery.ConfigureAutoLock(autoLockMinutes);
            try { await JS.InvokeVoidAsync("gallerySecurity.configureAutoLock", autoLockMinutes); }
            catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
            await Gallery.SavePreferencesAsync(new UiPreferences { GridDensity = density, AutoLockMinutes = autoLockMinutes });
        }
    }

    [JSInvokable]
    public async Task TriggerPanicLock()
    {
        await InvokeAsync(PanicAsync);
    }

    [JSInvokable]
    public async Task TriggerAutoLock()
    {
        await InvokeAsync(() =>
        {
            if (!Gallery.IsUnlocked) return;
            Lock();
            message = "Gallery locked after inactivity. Its checkout was released.";
            StateHasChanged();
        });
    }

    private async Task PanicAsync()
    {
        try { await JS.InvokeVoidAsync("gallerySecurity.purgeAllMedia"); }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
        Gallery.Panic();
        Lock();
        message = "Gallery locked and memory purged. Its checkout was released.";
        StateHasChanged();
    }

    private void Lock()
    {
        try { _ = JS.InvokeVoidAsync("gallerySecurity.purgeAllMedia"); }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
        Gallery.LockVault();
        images.Clear();
        browsingProjection = GalleryBrowsingProjection.Empty;
        browsingSource = null;
        StopThumbnailLoad();
        thumbnailTask = null;
        thumbnails.Clear();
        staleThumbnails.Clear();
        thumbnailFailures.Clear();
        CloseDetail();
        secret = confirm = recoveryPhrase = newPassphrase = newConfirm = error = message = importPath = "";
        if (!importRunning)
        {
            importFailures.Clear();
            importProgress = null;
            timingReport = null;
        }
        settings = new();
        filter = new();
        page = 0;
        useRecovery = recoverySaved = false;
        workflow = "library";
        filtersOpen = false;
        settingsTab = "overview";
        storageOverview = null;
        backupOptions = null;
        backupDestinationType = "local";
        backupLocalDirectory = backupAzureContainer = backupAzurePrefix = backupAzureConnectionString = "";
        restoreCredential = restoreSasUrl = purgeConfirmation = "";
        browsingFilter = null;
        libraryJob = new(false, "", "", 0, false);
        deleteSources = confirmSourceDeletion = false;
        removalSelection.Clear();
        removalPlan.Clear();
        removalResults.Clear();
        confirmRemoval = false;
        restoreFolder = "";
        librarySelection.Clear();
        viewerImages.Clear();
        viewerInitialId = "";
        imagesById = [];
        density = "comfortable";
        bulkTags = bulkCollection = "";
        selectionAnchor = null;
        duplicateScan = null;
        duplicateThumbnails.Clear();
        VisibleDuplicateGroups = [];
        reviewGroups = [];
        DuplicateGroupsShown = 20;
    }

    public void Dispose()
    {
        disposed = true;
        Gallery.OnAutoLocked -= HandleAutoLocked;
        Gallery.DriveQueueChanged -= HandleDriveQueueChanged;
        Lock();
        gridReference?.Dispose();
        securityReference?.Dispose();
    }
}
