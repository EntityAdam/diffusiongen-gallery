<div class="mb-4 flex flex-wrap items-center gap-2" aria-label="Active filters">
    @foreach (var chip in Chips)
    {
        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-auto max-w-full py-2 text-left whitespace-normal break-words" Disabled="@Disabled" OnClick="() => RemoveAsync(chip.Clear)" aria-label="@($"Remove filter: {chip.Label}")">@chip.Label <XIcon Size="14" aria-hidden="true" /></Button>
    }
    @if (Chips.Count > 0)
    {
        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Default" Class="h-auto px-0" Disabled="@Disabled" OnClick="Reset">Clear all filters</Button>
    }
</div>

@code {
    [Parameter, EditorRequired] public GalleryFilter Filter { get; set; } = new();
    [Parameter] public EventCallback<GalleryFilter> Changed { get; set; }
    [Parameter] public EventCallback Reset { get; set; }
    [Parameter] public bool Disabled { get; set; }

    public static int CountActive(GalleryFilter filter) => BuildChips(filter).Count;

    private List<(string Label, Func<GalleryFilter, GalleryFilter> Clear)> Chips => BuildChips(Filter);

    private static List<(string Label, Func<GalleryFilter, GalleryFilter> Clear)> BuildChips(GalleryFilter current)
    {
        var chips = new List<(string, Func<GalleryFilter, GalleryFilter>)>();
        if (current.Search.Length > 0) chips.Add(($"Search: {current.Search}", filter => filter with { Search = "" }));
        if (current.Prompt.Length > 0)
            chips.Add(($"Prompt: {(current.Prompt.Length > 48 ? current.Prompt[..48] + "…" : current.Prompt)}", filter => filter with { Prompt = "" }));
        if (current.Media != GalleryFilter.AnyValue) chips.Add((current.Media == "video" ? "Videos only" : "Images only", filter => filter with { Media = GalleryFilter.AnyValue }));
        if (current.Collection.Length > 0) chips.Add(($"Collection: {current.Collection}", filter => filter with { Collection = "" }));
        if (current.Tag.Length > 0) chips.Add(($"Tag: {current.Tag}", filter => filter with { Tag = "" }));
        if (current.Folder.Length > 0) chips.Add(($"Folder: {current.Folder}", filter => filter with { Folder = "" }));
        if (current.Model.Length > 0) chips.Add(($"Vision model: {current.Model}", filter => filter with { Model = "" }));
        if (current.DiffusionModel.Length > 0) chips.Add(($"Diffusion model: {current.DiffusionModel}", filter => filter with { DiffusionModel = "" }));
        if (current.MinRating > 0) chips.Add(($"Rating: {current.MinRating}+", filter => filter with { MinRating = 0 }));
        if (current.Review != GalleryFilter.AnyValue) chips.Add(($"Review: {current.Review}", filter => filter with { Review = GalleryFilter.AnyValue }));
        if (current.IncludesUnorganizedOnly) chips.Add(("Without a collection", filter => filter with { IncludesUnorganizedOnly = false }));
        if (current.IncludesFavoritesOnly) chips.Add(("Favorites only", filter => filter with { IncludesFavoritesOnly = false }));
        if (current.Deletion != GalleryFilter.AnyValue) chips.Add(($"Deletion: {current.Deletion}", filter => filter with { Deletion = GalleryFilter.AnyValue }));
        if (current.Analysis != GalleryFilter.AnyValue) chips.Add(($"Analysis: {current.Analysis}", filter => filter with { Analysis = GalleryFilter.AnyValue }));
        if (current.Orientation != GalleryFilter.AnyValue) chips.Add(($"Orientation: {current.Orientation}", filter => filter with { Orientation = GalleryFilter.AnyValue }));
        if (current.MinWidth > 0) chips.Add(($"Width: {current.MinWidth}+", filter => filter with { MinWidth = 0 }));
        if (current.MinHeight > 0) chips.Add(($"Height: {current.MinHeight}+", filter => filter with { MinHeight = 0 }));
        if (current.From is not null) chips.Add(($"From: {current.From:yyyy-MM-dd}", filter => filter with { From = null }));
        if (current.To is not null) chips.Add(($"Through: {current.To:yyyy-MM-dd}", filter => filter with { To = null }));
        return chips;
    }

    private Task RemoveAsync(Func<GalleryFilter, GalleryFilter> clear)
    {
        return Changed.InvokeAsync(clear(Filter));
    }
}
