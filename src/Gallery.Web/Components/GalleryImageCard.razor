<Card Class="@($"image-card relative min-w-0 overflow-hidden {(Image.MarkedForDeletion ? "marked" : "")} {(Selected ? "selected" : "")}")" data-image-id="@Image.Id">
    @if (ShowSelection)
    {
        <Button Variant="@(Selected ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Icon" Class="absolute top-2 left-2 z-10 h-7! w-7! rounded-full! shadow-sm" Disabled="@Busy" aria-pressed="@(Selected ? "true" : "false")"
                aria-label="@($"Select {Image.Name}")" title="Select (Shift+click selects a range)"
                OnClick="Select"><CheckIcon Size="16" ClassName="@(Selected ? "" : "opacity-40")" aria-hidden="true" /></Button>
    }
    <button class="image-open relative block aspect-square w-full overflow-hidden bg-background p-0 outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-50 [&_img]:h-full [&_img]:w-full [&_img]:object-contain" disabled="@Busy" @onclick="Open">
        @if (Thumbnail is not null)
        { <img src="@Thumbnail" alt="@Image.Name" loading="lazy" draggable="false" /> }
        else { <div class="grid h-full place-items-center text-xs text-muted-foreground" aria-busy="@(ThumbnailFailed ? "false" : "true")">@(ThumbnailFailed ? "Preview unavailable" : "Loading preview...")</div> }
        @if (Image.IsVideo) { <span class="pointer-events-none absolute bottom-2 left-2 inline-flex items-center gap-1 rounded-full bg-black/80 px-2 py-1 text-xs text-white" aria-label="@($"Video, {GalleryService.FormatDuration(Image)}")"><PlayIcon Size="12" aria-hidden="true" /> @GalleryService.FormatDuration(Image)</span> }
    </button>
    <div class="card-info p-4 [&>h3]:truncate [&>h3]:text-sm"><h3 title="@Image.Name">@Image.Name</h3>
        <div class="card-meta flex flex-wrap items-center justify-between gap-2 text-xs text-muted-foreground">
            <span>@Image.Width &times; @Image.Height</span>
            <span class="inline-flex items-center gap-2">
                @if (Image.Description.Length > 0) { <span>Analyzed</span> }
                <ShieldCheckIcon Size="16" ClassName="text-primary" role="img" aria-label="Encrypted" />
            </span>
        </div>
        <div class="card-rating-row mt-2 flex flex-wrap items-center justify-between gap-2 text-xs">
            <div class="inline-flex min-w-0 max-w-full items-center" role="group" aria-label="@($"Rating for {Image.Name}: {Image.Rating} out of 5 stars")">
                @for (var score = 1; score <= 5; score++)
                {
                    var value = score;
                    var label = Image.Rating == value ? "Clear rating" : $"Rate {value} out of 5 stars";
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Disabled="@Busy" Class="@(value <= Image.Rating ? "h-7! w-7! min-w-0 shrink p-0! text-primary" : "h-7! w-7! min-w-0 shrink p-0! text-muted-foreground")"
                            aria-label="@label" title="@label" aria-pressed="@(Image.Rating == value ? "true" : "false")"
                            OnClick="() => Rate.InvokeAsync(value)">
                        <StarIcon Size="16" Fill="@(value <= Image.Rating ? "currentColor" : "none")" aria-hidden="true" />
                    </Button>
                }
            </div>
            <span class="text-muted-foreground">@(Image.Reviewed ? "Reviewed" : "Pending")</span>
        </div>
        @if (!Image.Collections.IsEmpty) { <div class="collection-chips mt-3 flex flex-wrap gap-1">@foreach (var name in Image.Collections) { <Badge Variant="BadgeVariant.Secondary" Class="max-w-full whitespace-normal break-words">@name</Badge> }</div> }
    </div>
    <div class="card-actions flex gap-1 border-t border-border p-2">
        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Disabled="@Busy" Class="@(Image.Favorite ? "min-w-0 flex-1 px-2 text-xs text-primary" : "min-w-0 flex-1 px-2 text-xs")" OnClick="Favorite" aria-label="Toggle favorite" aria-pressed="@Image.Favorite">
            <HeartIcon Size="16" Fill="@(Image.Favorite ? "currentColor" : "none")" aria-hidden="true" /><span class="action-label">Favorite</span>
        </Button>
        <Button Variant="@(Image.MarkedForDeletion ? ButtonVariant.Destructive : ButtonVariant.Ghost)" Size="ButtonSize.Sm" Disabled="@Busy" Class="min-w-0 flex-1 px-2 text-xs" OnClick="Mark" aria-label="@(Image.MarkedForDeletion ? "Unmark deletion" : "Mark deletion")" aria-pressed="@Image.MarkedForDeletion">
            <TrashIcon Size="16" aria-hidden="true" /><span class="action-label">@(Image.MarkedForDeletion ? "Unmark" : "Mark deletion")</span>
        </Button>
    </div>
    @if (RemovalMode && Image.MarkedForDeletion)
    {
        <div class="flex items-start gap-3 px-4 pb-4"><Checkbox id="@("removal-" + Image.Id)" Class="mt-0.5" Checked="@RemovalSelected" Disabled="@Busy" CheckedChanged="RemovalSelectionChanged" /><Label For="@("removal-" + Image.Id)" Class="text-sm leading-relaxed">Select for removal</Label></div>
    }
</Card>

@code {
    [Parameter, EditorRequired] public WebImageRecord Image { get; set; } = new();
    [Parameter] public string? Thumbnail { get; set; }
    [Parameter] public bool ThumbnailFailed { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public bool ShowSelection { get; set; }
    [Parameter] public bool RemovalMode { get; set; }
    [Parameter] public bool RemovalSelected { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> Select { get; set; }
    [Parameter] public EventCallback Open { get; set; }
    [Parameter] public EventCallback<int> Rate { get; set; }
    [Parameter] public EventCallback Favorite { get; set; }
    [Parameter] public EventCallback Mark { get; set; }
    [Parameter] public EventCallback<bool> RemovalSelectionChanged { get; set; }
}
