@implements IAsyncDisposable
@inject GalleryService Gallery
@inject IJSRuntime JS
<dialog @ref="element" class="collection-dialog viewer-quick-edit" aria-labelledby="destination-title" @oncancel="CancelAsync" @oncancel:preventDefault>
    <form @onsubmit="MoveAsync" @onsubmit:preventDefault>
        <h2 id="destination-title">Move @Images.Count media to a set</h2>
        <p class="text-muted-foreground">Current location: @CurrentLocation</p>
        @if (loading) { <p role="status">Loading destinations…</p> }
        <label for="destination-collection">Collection</label>
        <AdvancedSelect Id="destination-collection" Label="Collections" ItemLabel="collection" Placeholder="Search or create a collection…"
                        Options="@catalog.Collections.Select(item => item.Name)" Counts="@CollectionCounts" Value="@collectionName" ValueChanged="SelectCollectionAsync" Disabled="@(working || loading)" />
        <label for="destination-set">Set</label>
        <AdvancedSelect Id="destination-set" Label="Sets" ItemLabel="set" Placeholder="Search or create a set…"
                        Options="@Sets.Select(item => item.Name)" Counts="@SetCounts" Value="@setName" ValueChanged="SelectSetAsync" Disabled="@(working || loading || Collection is null)" />
        @if (Set is not null) { <p class="text-primary">Destination: @Collection?.Name / @Set.Name</p> }
        <Button Type="button" Variant="ButtonVariant.Outline" Disabled="@(working || loading || Collection is null || !Sets.Any())" OnClick="SuggestAsync">Suggest destination (AI)</Button>
        @if (suggestedSet is not null) { <div class="collection-notice" role="status">Suggested: @Collection?.Name / @suggestedSet.Name <Button Type="button" Variant="ButtonVariant.Ghost" OnClick="UseSuggestion">Use suggestion</Button><Button Type="button" Variant="ButtonVariant.Ghost" OnClick="() => suggestedSet = null">Dismiss</Button></div> }
        @if (suggestionNotice.Length > 0) { <p role="status">@suggestionNotice</p> }
        <p class="text-muted-foreground">Moving changes the location of these media. Tags and ratings stay with them.</p>
        @if (error.Length > 0) { <p role="alert" class="text-destructive">@error</p><Button Variant="ButtonVariant.Outline" Type="button" Disabled="@working" OnClick="LoadAsync">Refresh destinations</Button> }
        <div class="collection-dialog-actions">
            <Button Variant="ButtonVariant.Outline" Type="button" Disabled="@working" OnClick="CancelAsync">Cancel</Button>
            <Button Type="submit" Disabled="@(working || loading || Set is null || Images.Count == 0 || Images.All(image => image.SetId == Set.Id))">@(working ? "Saving…" : $"Move {Images.Count} media")</Button>
        </div>
    </form>
</dialog>
@code {
    [Parameter] public IReadOnlyList<ImageRecord> Images { get; set; } = [];
    [Parameter] public string? InitialCollectionId { get; set; }
    [Parameter] public string? InitialSetId { get; set; }
    [Parameter] public EventCallback<CollectionMutation> Saved { get; set; }
    [Parameter] public EventCallback Cancel { get; set; }
    private ElementReference element;
    private readonly string key = Guid.NewGuid().ToString("N");
    private MediaSet? suggestedSet;
    private string suggestionNotice = "";
    private CollectionCatalog catalog = CollectionCatalog.Empty;
    private IReadOnlyList<ImageRecord> allMedia = [];
    private string collectionName = "", setName = "", error = "";
    private bool loading = true, working;
    private CollectionDefinition? Collection => catalog.Collections.FirstOrDefault(item => item.Name == collectionName);
    private IEnumerable<MediaSet> Sets => catalog.Sets.Where(item => item.CollectionId == Collection?.Id);
    private MediaSet? Set => Sets.FirstOrDefault(item => item.Name == setName);
    private IReadOnlyDictionary<string, int> CollectionCounts => catalog.Collections.ToDictionary(item => item.Name,
        item => allMedia.Count(image => catalog.Sets.Any(set => set.CollectionId == item.Id && set.Id == image.SetId)));
    private IReadOnlyDictionary<string, int> SetCounts => Sets.ToDictionary(item => item.Name, item => allMedia.Count(image => image.SetId == item.Id));
    private string CurrentLocation => Images.Select(catalog.PathOf).Distinct().Take(2).ToArray() is var paths && paths.Length == 1 ? paths[0] : "Multiple locations";
    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        var set = catalog.Sets.FirstOrDefault(item => item.Id == (InitialSetId ?? Images.FirstOrDefault()?.SetId));
        var collection = catalog.Collections.FirstOrDefault(item => item.Id == (InitialCollectionId ?? set?.CollectionId));
        collectionName = collection?.Name ?? "";
        setName = set?.CollectionId == collection?.Id ? set?.Name ?? "" : "";
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    { if (firstRender) await JS.InvokeVoidAsync("galleryViewer.openQuickEdit", element, key); }
    private async Task LoadAsync()
    {
        loading = true; error = "";
        try { catalog = await Gallery.LoadCollectionCatalogAsync();allMedia = await Gallery.ListAsync(); }
        catch (Exception exception) { error = exception.Message; }
        finally { loading = false; }
    }
    private async Task SelectCollectionAsync(string name) => await RunAsync(async () =>
    {
        setName = "";suggestedSet = null;suggestionNotice = "";
        if (name.Length == 0) { collectionName = ""; return; }
        var item = catalog.Collections.FirstOrDefault(item => item.Name.Equals(name, StringComparison.OrdinalIgnoreCase))
            ?? await Gallery.CreateCollectionAsync(name);
        catalog = await Gallery.LoadCollectionCatalogAsync(); collectionName = item.Name;
    });
    private async Task SelectSetAsync(string name) => await RunAsync(async () =>
    {
        if (name.Length == 0) { setName = ""; return; }
        if (Collection is null) return;
        var item = Sets.FirstOrDefault(item => item.Name.Equals(name, StringComparison.OrdinalIgnoreCase))
            ?? await Gallery.CreateSetAsync(Collection.Id, name);
        catalog = await Gallery.LoadCollectionCatalogAsync(); setName = item.Name;
    });
    private Task SuggestAsync() => RunAsync(async () =>
    {
        suggestedSet = null;suggestionNotice = "";
        if (Collection is null) return;
        suggestedSet = await Gallery.SuggestDestinationSetAsync(Collection.Id, Images.Select(image => image.Id));
        if (suggestedSet is null) suggestionNotice = "No existing set was a suitable match. Choose a destination yourself.";
    });
    private void UseSuggestion() { if (suggestedSet is not null) setName = suggestedSet.Name;suggestedSet = null; }
    private Task MoveAsync() => Set is null || Images.Count == 0 ? Task.CompletedTask : RunAsync(async () =>
    { var result = await Gallery.MoveMediaToSetAsync(Images.Select(image => image.Id), Set.Id); await Saved.InvokeAsync(result); });
    private async Task RunAsync(Func<Task> action)
    { if (working) return; working = true; error = ""; try { await action(); } catch (Exception exception) { error = exception.Message; } finally { working = false; } }
    private Task CancelAsync() => working ? Task.CompletedTask : Cancel.InvokeAsync();
    public async ValueTask DisposeAsync()
    { try { await JS.InvokeVoidAsync("galleryViewer.closeQuickEdit", key); } catch (JSDisconnectedException) { } }
}
