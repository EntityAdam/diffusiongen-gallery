<div class="image-grid density-@Density">
    @{ PromptGroup? previousGroup = null; DiffusionModelGroup? previousModelGroup = null; var firstOnPage = true; }
    @foreach (var image in Images)
    {
        if (Grouping == "prompt" && PromptGroups.TryGetValue(image.Id, out var group) && !ReferenceEquals(group, previousGroup))
        {
            var continued = firstOnPage && group.Images[0].Id != image.Id;
            previousGroup = group;
            <div class="col-span-full rounded-md border-l-2 border-primary bg-primary/5 px-4 py-3" @key="@("group-" + image.Id)">
                @if (group.Kind == PromptGroup.Shared)
                {
                    var sample = group.Images[0].Generation;
                    <div class="flex flex-wrap items-center gap-3 text-sm">
                        <strong>@group.Images.Length share this prompt@(continued ? " (continued)" : "")</strong>
                        @if (sample is not null) { <span class="text-muted-foreground">@GenerationSummary(sample)</span> }
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Default" Type="button" Class="h-auto px-0" Disabled="@Busy" OnClick="() => ShowPrompt.InvokeAsync(group.Prompt)">Show only these</Button>
                    </div>
                    <p class="max-h-40 overflow-auto text-sm whitespace-pre-wrap break-words" title="@group.Prompt">@group.Prompt</p>
                }
                else
                {
                    <div class="flex flex-wrap items-center gap-3 text-sm"><strong>@(group.Kind == PromptGroup.Unique ? "Unique prompts" : "No ComfyUI prompt found") (@group.Images.Length)@(continued ? " (continued)" : "")</strong></div>
                }
            </div>
        }
        else if (Grouping == "model" && ModelGroups.TryGetValue(image.Id, out var modelGroup) && !ReferenceEquals(modelGroup, previousModelGroup))
        {
            var continued = firstOnPage && modelGroup.Images[0].Id != image.Id;
            previousModelGroup = modelGroup;
            <div class="col-span-full rounded-md border-l-2 border-primary bg-primary/5 px-4 py-3" @key="@("model-group-" + image.Id)">
                <strong>@(modelGroup.Model.Length == 0 ? "No diffusion model recorded" : modelGroup.Model) (@modelGroup.Images.Length)@(continued ? " (continued)" : "")</strong>
            </div>
        }
        firstOnPage = false;
        @ChildContent(image)
    }
</div>

@code {
    [Parameter, EditorRequired] public IEnumerable<ImageRecord> Images { get; set; } = [];
    [Parameter, EditorRequired] public RenderFragment<ImageRecord> ChildContent { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, PromptGroup> PromptGroups { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, DiffusionModelGroup> ModelGroups { get; set; } = default!;
    [Parameter] public string Grouping { get; set; } = "none";
    [Parameter] public string Density { get; set; } = "";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<string> ShowPrompt { get; set; }

    private static string GenerationSummary(GenerationInfo info) => string.Join(" · ", new[]
    {
        info.Model,
        info.Steps is int steps ? $"{steps} steps" : "",
        info.Cfg is double cfg ? $"CFG {cfg.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}" : ""
    }.Where(part => part.Length > 0));
}
