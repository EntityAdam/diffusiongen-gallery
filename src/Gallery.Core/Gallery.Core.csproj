    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SixLaborsLicenseFile Condition="'$(SixLaborsLicenseFile)' == ''">$(MSBuildProjectDirectory)\..\..\sixlabors.lic</SixLaborsLicenseFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.25.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <InternalsVisibleTo Include="Gallery.Tests" />
    <InternalsVisibleTo Include="Gallery.TestSupport" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Gallery.Migrations\Gallery.Migrations.csproj" />
  </ItemGroup>
</Project>
